  {id:'racer',name:'Lane Racer',icon:'▥',genre:'Аркада',difficulty:'Средняя',controls:'← → / свайп',goal:'Меняй полосы и уклоняйся от машин как можно дольше.',tip:'Смотри на две следующие машины, а не только на ближайшую.',desc:'Быстрый трёхполосный раннер с ускорением и сериями обгонов.',run:runRacer},
