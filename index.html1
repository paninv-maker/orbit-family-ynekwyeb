:root{
  --bg:#f5f4f0;--bg2:#eceae4;--surface:rgba(255,255,255,.58);--surface-strong:rgba(255,255,255,.86);
  --text:#171717;--muted:#74716a;--line:rgba(24,24,22,.12);--accent:#202020;--accent2:#7c786f;--good:#4e7d61;
  --shadow:0 18px 60px rgba(48,46,41,.11),inset 0 1px 0 rgba(255,255,255,.78);--blur:22px;--radius:24px;--radius-sm:16px;
}
html[data-theme="dark"]{
  --bg:#11110f;--bg2:#1a1916;--surface:rgba(30,29,26,.62);--surface-strong:rgba(37,36,32,.90);
  --text:#f2f0e9;--muted:#aaa69c;--line:rgba(255,255,255,.11);--accent:#f2f0e9;--accent2:#aba69b;--good:#83b393;
  --shadow:0 20px 70px rgba(0,0,0,.38),inset 0 1px 0 rgba(255,255,255,.08);
}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Manrope,system-ui,sans-serif;background:linear-gradient(145deg,var(--bg),var(--bg2));color:var(--text);min-height:100vh;overflow-x:hidden}button,input,textarea,select{font:inherit;color:inherit}button{cursor:pointer}.hidden{display:none!important}.glass{background:var(--surface);border:1px solid var(--line);box-shadow:var(--shadow);backdrop-filter:blur(var(--blur)) saturate(150%);-webkit-backdrop-filter:blur(var(--blur)) saturate(150%)}
.ambient{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:-1}.orb{position:absolute;border-radius:999px;filter:blur(12px);opacity:.5;animation:float 18s ease-in-out infinite}.orb-a{width:420px;height:420px;background:radial-gradient(circle,rgba(178,172,159,.55),transparent 65%);left:-110px;top:5%}.orb-b{width:520px;height:520px;background:radial-gradient(circle,rgba(207,203,191,.55),transparent 65%);right:-150px;top:24%;animation-delay:-7s}.orb-c{width:360px;height:360px;background:radial-gradient(circle,rgba(152,148,138,.42),transparent 65%);left:35%;bottom:-140px;animation-delay:-12s}.grid-glow{position:absolute;inset:0;background-image:linear-gradient(rgba(127,127,127,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(127,127,127,.04) 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(to bottom,rgba(0,0,0,.4),transparent 82%)}@keyframes float{0%,100%{transform:translate3d(0,0,0) scale(1)}50%{transform:translate3d(45px,-35px,0) scale(1.08)}}
.topbar{position:sticky;top:14px;z-index:40;margin:14px auto 0;width:min(1180px,calc(100% - 28px));border-radius:22px;padding:10px 12px;display:flex;align-items:center;gap:18px}.brand{border:0;background:transparent;display:flex;align-items:center;gap:8px;font-weight:800;letter-spacing:-.03em}.brand sup{font-size:8px}.brand em{font-style:normal;font-size:9px;padding:4px 7px;border-radius:99px;background:var(--text);color:var(--bg)}.brand-mark{display:grid;place-items:center;width:31px;height:31px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;font-size:14px;box-shadow:0 8px 20px rgba(35,35,33,.20)}.brand-mark.sm{width:28px;height:28px}.main-nav{display:flex;gap:6px;margin:auto}.nav-btn,.icon-btn,.glass-btn,.ghost-btn,.text-link,.side-action,.template-btn,.layout-grid button,.editor-actions button{border:1px solid transparent;background:transparent;border-radius:14px;padding:9px 12px;transition:.2s}.nav-btn:hover,.nav-btn.active{background:var(--surface-strong);border-color:var(--line)}.nav-btn span{font-size:10px;padding:2px 5px;border-radius:99px;background:var(--accent);color:#fff}.header-actions{display:flex;gap:7px}.icon-btn{width:38px;height:38px;padding:0;border-color:var(--line);background:var(--surface-strong)}.glass-btn{background:linear-gradient(135deg,var(--surface-strong),var(--surface));border-color:var(--line);box-shadow:inset 0 1px 0 rgba(255,255,255,.32)}.glass-btn:hover,.icon-btn:hover{transform:translateY(-1px);box-shadow:0 8px 20px rgba(60,70,100,.12)}.splash-launch{border:0;border-radius:14px;padding:9px 13px;background:linear-gradient(135deg,#1e1e1e,#555149);color:#fff;font-weight:700;display:flex;align-items:center;gap:7px}.splash-dot{width:8px;height:8px;border-radius:50%;background:#d9d3c6;box-shadow:0 0 0 4px rgba(217,211,198,.15)}
.shell{width:min(1180px,calc(100% - 36px));margin-inline:auto}.page{display:none;min-height:72vh}.page.active{display:block}.hero{padding:80px 0 55px;display:grid;grid-template-columns:1.2fr .8fr;gap:50px;align-items:center}.eyebrow{font-size:11px;letter-spacing:.18em;font-weight:800;color:var(--muted);margin:0 0 10px}.hero h1,.subhero h1{font-size:clamp(44px,7vw,92px);line-height:.92;letter-spacing:-.065em;margin:0}.accent-dot{color:var(--accent)}.hero-sub{font-size:18px;color:var(--muted);max-width:620px}.hero-search,.mini-search{display:flex;align-items:center;gap:10px;padding:11px 14px;border-radius:18px;margin-top:26px;max-width:650px}.hero-search input,.mini-search input,.command-head input,.splash-form input{flex:1;border:0;background:transparent;outline:0;min-width:0}.hero-search kbd,.command-head kbd{font-size:10px;color:var(--muted);border:1px solid var(--line);padding:4px 7px;border-radius:8px}.stats-row{display:flex;gap:34px;margin-top:26px}.stats-row div{display:flex;flex-direction:column}.stats-row strong{font-size:25px}.stats-row span{font-size:12px;color:var(--muted)}.hero-visual{height:360px;border-radius:36px;position:relative;display:grid;place-items:center;overflow:hidden}.planet-core{width:142px;height:142px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(145deg,#262626,#6d6961 58%,#b6b0a3);box-shadow:inset -25px -20px 45px rgba(0,0,0,.22),0 30px 70px rgba(55,53,48,.24);color:white;z-index:3}.planet-core span{font-weight:800;letter-spacing:.12em}.planet-core small{font-size:8px;opacity:.75;margin-top:-45px}.planet-ring{position:absolute;border:1px solid var(--line);border-radius:50%;animation:spin 15s linear infinite}.ring-1{width:230px;height:230px}.ring-2{width:310px;height:310px;animation-direction:reverse;animation-duration:22s}.satellite{position:absolute;z-index:5}.sat-1{top:65px;right:80px}.sat-2{left:75px;bottom:85px;color:var(--accent)}.sat-3{right:55px;bottom:50px;color:var(--accent2)}@keyframes spin{to{transform:rotate(360deg)}}
.section-block{padding:45px 0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px}.section-head h2,.play-preview h2{font-size:38px;letter-spacing:-.04em;margin:0}.ghost-btn{border-color:var(--line)}.category-scroller{display:flex;gap:8px;overflow:auto;padding:24px 0 18px;scrollbar-width:none}.category-scroller::-webkit-scrollbar{display:none}.category-btn{white-space:nowrap;border:1px solid var(--line);background:var(--surface);padding:9px 12px;border-radius:14px}.category-btn.active{background:var(--text);color:var(--bg)}.cards-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.site-card{position:relative;min-height:145px;border-radius:20px;padding:16px;display:flex;flex-direction:column;justify-content:space-between;text-decoration:none;color:inherit;transition:.22s;border:1px solid var(--line);background:var(--surface)}.site-card:hover{transform:translateY(-4px);background:var(--surface-strong);box-shadow:0 16px 34px rgba(52,63,91,.12)}.site-card-top{display:flex;justify-content:space-between;gap:8px}.site-icon{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;font-weight:800}.fav-btn{border:0;background:transparent;font-size:18px;color:var(--muted)}.fav-btn.active{color:#ffb52f}.site-card h3{font-size:15px;margin:14px 0 4px}.site-card p{font-size:12px;color:var(--muted);margin:0}.site-domain{font-size:10px;color:var(--muted);margin-top:10px}.empty-state{padding:48px;text-align:center;color:var(--muted);display:flex;flex-direction:column;gap:5px}.play-preview{border-radius:30px;padding:28px;display:grid;grid-template-columns:1fr 1.2fr auto;gap:20px;align-items:center}.play-preview p{color:var(--muted)}.preview-games{display:flex;gap:10px}.preview-game{flex:1;border:1px solid var(--line);border-radius:17px;padding:15px;background:var(--surface-strong)}.preview-game strong{display:block}.preview-game span{font-size:11px;color:var(--muted)}.work-preview{display:grid;grid-template-columns:1fr 1fr;gap:16px}.feature-card{padding:28px;border-radius:30px}.feature-card h3{font-size:26px;margin:5px 0}.feature-card p:not(.eyebrow){color:var(--muted)}.feature-icon{font-size:30px}.text-link{padding-left:0;color:var(--accent);font-weight:700}
.subhero{padding:70px 0 36px}.subhero p{color:var(--muted)}.game-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;padding-bottom:70px}.game-card{border:1px solid var(--line);border-radius:22px;padding:20px;background:var(--surface);transition:.2s;min-height:190px;display:flex;flex-direction:column}.game-card:hover{transform:translateY(-3px);background:var(--surface-strong)}.game-card .game-icon{font-size:34px}.game-card h3{margin:18px 0 4px}.game-card p{font-size:12px;color:var(--muted);margin:0 0 18px}.game-card .game-bottom{margin-top:auto;display:flex;justify-content:space-between;align-items:center}.game-card button{border:0;border-radius:12px;background:var(--text);color:var(--bg);padding:8px 12px}.game-card small{color:var(--muted)}
.work-shell{width:min(1440px,calc(100% - 28px));margin:26px auto 60px;display:grid;grid-template-columns:230px 1fr;gap:14px}.work-sidebar{border-radius:24px;padding:16px;height:calc(100vh - 120px);position:sticky;top:100px;display:flex;flex-direction:column;gap:7px}.side-title{display:flex;align-items:center;gap:9px;margin-bottom:10px}.side-title div{display:flex;flex-direction:column}.side-title small{color:var(--muted);font-size:10px}.side-action,.template-btn{text-align:left;border-color:var(--line)}.side-action.primary{background:var(--text);color:var(--bg)}.side-divider{height:1px;background:var(--line);margin:8px 0}.side-label{font-size:10px;text-transform:uppercase;color:var(--muted);letter-spacing:.12em}.layout-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px}.layout-grid button{border-color:var(--line);height:42px}.editor-panel{min-width:0}.editor-topbar{border-radius:20px;padding:10px 12px;display:flex;gap:10px;justify-content:space-between}.editor-topbar>input{border:0;background:transparent;font-weight:800;font-size:18px;outline:0}.editor-actions{display:flex;gap:6px}.editor-actions button{border-color:var(--line)}.editor-content{display:grid;grid-template-columns:150px 1fr;gap:14px;margin-top:14px}.slides-rail{border-radius:20px;padding:10px;height:calc(100vh - 184px);overflow:auto}.slide-thumb{aspect-ratio:16/9;border-radius:10px;border:2px solid transparent;background:var(--surface-strong);padding:8px;margin-bottom:9px;font-size:8px;overflow:hidden;position:relative}.slide-thumb.active{border-color:var(--accent)}.slide-thumb b{font-size:9px}.slide-thumb span{position:absolute;bottom:4px;right:5px;color:var(--muted)}.canvas-area{min-width:0}.slide-canvas{width:min(100%,960px);aspect-ratio:16/9;margin:auto;border-radius:24px;padding:7%;position:relative;overflow:hidden;background:linear-gradient(145deg,var(--surface-strong),var(--surface))}.slide-render h1{font-size:clamp(30px,4vw,60px);letter-spacing:-.05em;margin:0 0 14px}.slide-render h2{font-size:clamp(22px,3vw,42px);margin:0 0 14px}.slide-render p{color:var(--muted);white-space:pre-wrap}.slide-render .slide-image{position:absolute;right:5%;bottom:7%;width:38%;height:55%;object-fit:cover;border-radius:18px;border:1px solid var(--line)}.slide-render.layout-twoCol{display:grid;grid-template-columns:1fr 1fr;gap:6%}.slide-render.layout-quote{display:grid;place-items:center;text-align:center;height:100%}.slide-render.layout-quote h2{font-size:clamp(34px,5vw,72px)}.slide-render.layout-title{display:flex;flex-direction:column;justify-content:center;height:100%}.canvas-tools{margin-top:14px;border-radius:20px;padding:14px;display:grid;grid-template-columns:1fr 1fr;gap:10px}.canvas-tools label{font-size:10px;color:var(--muted);display:flex;flex-direction:column;gap:5px}.canvas-tools input,.canvas-tools textarea,.dialog input,.dialog select{border:1px solid var(--line);background:var(--surface-strong);border-radius:11px;padding:9px;outline:0;color:var(--text)}.canvas-tools label:nth-child(3),.canvas-tools label:nth-child(5){grid-column:1/-1}
.footer{padding:28px 0 40px;display:flex;justify-content:space-between;color:var(--muted);font-size:12px}.footer div{display:flex;gap:12px}.footer strong{color:var(--text)}
.modal-backdrop{position:fixed;inset:0;background:rgba(5,8,15,.35);backdrop-filter:blur(5px);z-index:70}.command{position:fixed;z-index:80;left:50%;top:16%;transform:translateX(-50%);width:min(650px,calc(100% - 28px));border-radius:24px;overflow:hidden}.command-head{display:flex;align-items:center;gap:10px;padding:16px;border-bottom:1px solid var(--line)}.command-head input{font-size:18px}.command-results{max-height:390px;overflow:auto;padding:8px}.command-item{width:100%;border:0;background:transparent;display:flex;justify-content:space-between;align-items:center;text-align:left;padding:12px;border-radius:14px}.command-item:hover,.command-item.active{background:var(--surface-strong)}.command-item div{display:flex;flex-direction:column}.command-item span{font-size:11px;color:var(--muted)}.command-item small{font-size:10px;color:var(--muted)}
.splash-panel{position:fixed;z-index:81;right:22px;bottom:22px;width:min(390px,calc(100% - 28px));height:560px;border-radius:28px;display:flex;flex-direction:column;overflow:hidden}.splash-head{padding:16px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between}.splash-head>div{display:grid;grid-template-columns:10px auto;column-gap:8px}.splash-head small{grid-column:2;color:var(--muted)}.splash-head button,.dialog-head button,.game-modal-head button,.present-overlay>button{border:0;background:var(--surface-strong);width:34px;height:34px;border-radius:50%}.splash-chat{flex:1;overflow:auto;padding:14px;display:flex;flex-direction:column;gap:8px}.bubble{max-width:86%;padding:11px 13px;border-radius:16px;font-size:12px;display:flex;flex-direction:column;gap:3px}.bubble.splash{background:var(--surface-strong);align-self:flex-start}.bubble.user{background:var(--text);color:var(--bg);align-self:flex-end}.splash-form{display:flex;gap:8px;padding:10px;border-top:1px solid var(--line)}.splash-form input{background:var(--surface-strong);padding:10px;border-radius:13px}.splash-form button{border:0;border-radius:12px;background:var(--accent);color:#fff;width:40px}.splash-note{font-size:9px;color:var(--muted);padding:0 12px 10px;margin:0}.dialog{position:fixed;z-index:81;left:50%;top:50%;transform:translate(-50%,-50%);width:min(470px,calc(100% - 28px));border-radius:28px;padding:22px}.dialog-head{display:flex;justify-content:space-between;align-items:start}.dialog-head h3{font-size:28px;margin:0}.dialog form{display:grid;gap:11px;margin-top:20px}.dialog label{display:flex;flex-direction:column;gap:5px;font-size:11px;color:var(--muted)}.full{width:100%}
.game-modal{position:fixed;z-index:81;left:50%;top:50%;transform:translate(-50%,-50%);width:min(820px,calc(100% - 28px));max-height:86vh;overflow:auto;border-radius:30px;padding:20px}.game-modal-head{display:flex;justify-content:space-between;align-items:center}.game-modal-head h3{font-size:30px;margin:0}.game-modal-head>div:last-child{display:flex;gap:8px;align-items:center}.score-chip{padding:7px 11px;border-radius:99px;background:var(--surface-strong);font-size:12px}.game-board{margin:18px auto 0;display:grid;gap:5px;justify-content:center}.cell{display:grid;place-items:center;border:1px solid var(--line);background:var(--surface-strong);border-radius:8px;user-select:none}.game-controls{display:flex;justify-content:center;gap:8px;margin-top:14px;flex-wrap:wrap}.game-controls button{border:1px solid var(--line);background:var(--surface-strong);border-radius:12px;padding:9px 13px}.big-score{text-align:center;font-size:58px;font-weight:800;letter-spacing:-.05em;margin:26px 0}.reaction-area{height:300px;border-radius:20px;display:grid;place-items:center;background:var(--surface-strong);font-weight:800;font-size:26px}.canvas-game{display:block;margin:16px auto;border-radius:18px;background:#10141d;max-width:100%;touch-action:none}.keypad{display:grid;grid-template-columns:repeat(3,60px);gap:8px;justify-content:center;margin-top:14px}.keypad button{height:50px;border:0;border-radius:12px;background:var(--surface-strong)}
.present-overlay{position:fixed;inset:0;background:#070a10;z-index:100;color:#fff;display:grid;place-items:center;padding:5vw}.present-overlay>button{position:absolute;right:22px;top:22px;background:rgba(255,255,255,.12);color:#fff}.present-overlay #present-slide{width:min(1100px,90vw);aspect-ratio:16/9;background:#f7f8fb;color:#111827;border-radius:20px;padding:7%;position:relative;overflow:hidden}.present-controls{position:absolute;bottom:22px;display:flex;gap:10px;align-items:center}.present-controls button{border:0;background:rgba(255,255,255,.12);color:#fff;border-radius:12px;padding:9px 13px}.toast{position:fixed;z-index:120;left:50%;bottom:22px;transform:translate(-50%,18px);opacity:0;pointer-events:none;background:var(--text);color:var(--bg);padding:10px 14px;border-radius:13px;font-size:12px;transition:.25s}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:980px){.main-nav{display:none}.header-actions .glass-btn{display:none}.hero{grid-template-columns:1fr}.hero-visual{height:280px}.cards-grid{grid-template-columns:repeat(3,1fr)}.play-preview{grid-template-columns:1fr}.work-shell{grid-template-columns:1fr}.work-sidebar{position:static;height:auto;display:grid;grid-template-columns:repeat(3,1fr)}.side-title,.side-divider,.side-label,.layout-grid{grid-column:1/-1}.editor-content{grid-template-columns:110px 1fr}.game-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:650px){.topbar{top:8px}.brand em{display:none}.header-actions{margin-left:auto}.header-actions .icon-btn:first-child{display:none}.hero{padding-top:50px}.hero h1,.subhero h1{font-size:50px}.stats-row{gap:18px}.cards-grid{grid-template-columns:1fr 1fr}.site-card{min-height:132px}.work-preview{grid-template-columns:1fr}.game-grid{grid-template-columns:1fr}.editor-content{grid-template-columns:1fr}.slides-rail{height:auto;display:flex;overflow:auto}.slide-thumb{min-width:110px}.canvas-tools{grid-template-columns:1fr}.canvas-tools label{grid-column:auto!important}.work-sidebar{grid-template-columns:1fr 1fr}.editor-topbar{flex-direction:column}.footer{flex-direction:column;gap:8px}.preview-games{overflow:auto}.preview-game{min-width:130px}}

.test-build-badge{position:fixed;left:18px;bottom:18px;z-index:130;padding:9px 13px;border-radius:999px;background:rgba(19,23,35,.82);color:#fff;font:700 11px/1 Manrope,sans-serif;letter-spacing:.08em;backdrop-filter:blur(18px);box-shadow:0 8px 30px rgba(0,0,0,.18)}

/* Parallel Lab additions */
.focus-btn.active{background:var(--text);color:var(--bg);border-color:var(--text)}
.sync-btn.connected{box-shadow:inset 0 0 0 1px var(--good)}
.hero-mini-widget{position:absolute;z-index:8;width:148px;border:1px solid var(--line);border-radius:18px;padding:12px;background:var(--surface-strong);backdrop-filter:blur(18px);box-shadow:0 12px 32px rgba(45,43,39,.10)}
.hero-mini-widget.clock{left:16px;top:16px}.hero-mini-widget.focus{right:16px;bottom:16px;width:164px}
.hero-mini-widget small{display:block;color:var(--muted);font-size:9px;letter-spacing:.1em;text-transform:uppercase}.hero-mini-widget strong{display:block;font-size:24px;letter-spacing:-.04em;margin-top:2px}.hero-mini-widget span{font-size:10px;color:var(--muted)}
.focus-timer-row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:7px}.focus-timer-row strong{font-size:20px;margin:0}.focus-timer-row button{border:1px solid var(--line);background:transparent;border-radius:10px;padding:5px 8px;font-size:10px}
.frequent-block{padding:0 0 18px}.frequent-shell{border-radius:22px;padding:14px 16px;display:flex;align-items:center;gap:12px;min-height:62px}.frequent-title{min-width:126px}.frequent-title strong{display:block;font-size:12px}.frequent-title span{font-size:10px;color:var(--muted)}.frequent-list{display:flex;gap:8px;overflow:auto;scrollbar-width:none}.frequent-list::-webkit-scrollbar{display:none}.frequent-chip{border:1px solid var(--line);background:var(--surface-strong);border-radius:13px;padding:8px 11px;white-space:nowrap;display:flex;align-items:center;gap:7px}.frequent-chip b{font-size:11px}.frequent-chip small{font-size:9px;color:var(--muted)}
.collections-wrap{display:flex;align-items:center;gap:10px;margin-top:18px}.collections-label{font-size:10px;color:var(--muted);font-weight:800;letter-spacing:.08em}.collection-strip{display:flex;gap:7px;overflow:auto;flex:1;scrollbar-width:none;padding:2px}.collection-strip::-webkit-scrollbar{display:none}.collection-pill{position:relative;border:1px solid var(--line);background:var(--surface);border-radius:13px;padding:8px 28px 8px 11px;white-space:nowrap}.collection-pill.active{background:var(--text);color:var(--bg)}.collection-pill.dragover{outline:2px dashed var(--good);outline-offset:2px}.collection-pill .collection-delete{position:absolute;right:6px;top:50%;transform:translateY(-50%);border:0;background:transparent;color:inherit;opacity:.55;padding:4px}.add-collection-btn{border:1px dashed var(--line);background:transparent;border-radius:13px;padding:8px 11px;white-space:nowrap}
.site-card{overflow:hidden}.site-card[draggable="true"]{cursor:grab}.site-card.dragging{opacity:.45}.site-preview{position:absolute;inset:0;z-index:3;background:var(--surface-strong);opacity:0;pointer-events:none;transition:.22s;display:flex;align-items:center;justify-content:center}.site-card:hover .site-preview.ready{opacity:1}.site-preview img{width:100%;height:100%;object-fit:cover}.site-preview::after{content:"";position:absolute;inset:55% 0 0;background:linear-gradient(transparent,rgba(0,0,0,.72))}.preview-caption{position:absolute;left:12px;right:12px;bottom:10px;z-index:4;color:white;display:flex;justify-content:space-between;align-items:end;gap:8px}.preview-caption strong{font-size:12px}.preview-caption small{font-size:9px;opacity:.8}.site-card-actions{position:relative;z-index:6;display:flex;gap:4px}.remove-collection-btn{border:0;background:rgba(0,0,0,.05);border-radius:8px;font-size:12px;color:var(--muted)}
.focus-mode [data-route="games"],.focus-mode .play-preview{display:none!important}.focus-mode .category-btn[data-cat="Игры"],.focus-mode .category-btn[data-cat="Видео и музыка"]{display:none!important}.focus-mode .orb-c{opacity:.12}.focus-mode .planet-ring{animation-duration:45s}.focus-mode-indicator{display:none}.focus-mode .focus-mode-indicator{display:inline}
.tools-shell{padding:52px 0 80px}.tools-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.tool-card{border-radius:26px;padding:22px;min-height:260px}.tool-card h3{margin:3px 0 5px;font-size:22px}.tool-card>p{margin:0 0 16px;color:var(--muted);font-size:12px}.tool-card input,.tool-card textarea,.tool-card select{width:100%;border:1px solid var(--line);background:var(--surface-strong);border-radius:12px;padding:10px;outline:0}.tool-row{display:flex;gap:8px;align-items:center}.tool-row>*{flex:1}.tool-card button{border:1px solid var(--line);background:var(--text);color:var(--bg);border-radius:12px;padding:9px 12px}.markdown-layout{display:grid;grid-template-columns:1fr 1fr;gap:9px}.markdown-preview{border:1px solid var(--line);border-radius:12px;padding:11px;min-height:150px;background:var(--surface-strong);overflow:auto;font-size:12px}.markdown-preview h1,.markdown-preview h2,.markdown-preview h3{margin:.4em 0}.markdown-preview p{margin:.45em 0}.markdown-preview code{font-family:ui-monospace,monospace;background:rgba(127,127,127,.12);padding:1px 4px;border-radius:5px}.calc-result{font-size:30px;font-weight:800;letter-spacing:-.04em;margin:14px 0}.meeting-display{font-size:44px;font-weight:800;letter-spacing:-.05em;margin:14px 0}.converter-drop{border:1px dashed var(--line);border-radius:14px;padding:16px;text-align:center;margin-bottom:10px}.converter-status{font-size:10px;color:var(--muted);margin-top:8px}
.sync-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.sync-status{border:1px solid var(--line);border-radius:14px;padding:12px;background:var(--surface-strong);margin-bottom:12px}.sync-status strong{display:block}.sync-status span{font-size:11px;color:var(--muted)}.notice{font-size:10px;color:var(--muted);line-height:1.5;margin-top:10px}.profile-file{display:none}
.dialog.compact{width:min(440px,calc(100% - 28px))}
@media(max-width:980px){.tools-grid{grid-template-columns:1fr}.hero-mini-widget{display:none}.collections-wrap{align-items:flex-start;flex-wrap:wrap}.collections-label{width:100%}.main-nav .nav-btn[data-route="tools"]{display:none}}
@media(max-width:700px){.frequent-shell{align-items:flex-start;flex-direction:column}.frequent-title{min-width:0}.markdown-layout{grid-template-columns:1fr}.sync-grid{grid-template-columns:1fr}}


/* ORBIT Parallel Lab v2 · modes, tasks, richer games */
.mode-switcher{margin-top:18px;display:flex;align-items:center;gap:7px;flex-wrap:wrap}.mode-switcher-label{font-size:10px;font-weight:800;letter-spacing:.1em;color:var(--muted);margin-right:3px}.mode-pill{border:1px solid var(--line);background:var(--surface);border-radius:13px;padding:8px 11px;transition:.2s;display:flex;align-items:center;gap:6px}.mode-pill:hover{transform:translateY(-1px);background:var(--surface-strong)}.mode-pill.active{background:var(--text);color:var(--bg);border-color:var(--text)}.mode-pill small{font-size:9px;opacity:.65}
.mode-dashboard{padding:0 0 24px}.mode-dashboard-grid{display:grid;grid-template-columns:1.2fr .9fr .9fr;gap:12px}.mode-card{border-radius:22px;padding:17px;min-height:112px;position:relative;overflow:hidden}.mode-card::after{content:"";position:absolute;width:92px;height:92px;border:1px solid var(--line);border-radius:50%;right:-24px;bottom:-38px;opacity:.7}.mode-card .eyebrow{margin-bottom:7px}.mode-card h3{margin:0 0 5px;font-size:18px}.mode-card p{margin:0;color:var(--muted);font-size:11px;line-height:1.45;max-width:90%}.mode-card button{margin-top:12px;border:1px solid var(--line);background:var(--surface-strong);border-radius:11px;padding:7px 9px;font-size:10px}.mode-live{display:flex;align-items:center;gap:8px;margin-top:10px;font-size:10px;color:var(--muted)}.mode-live i{width:7px;height:7px;border-radius:50%;background:var(--good);box-shadow:0 0 0 4px color-mix(in srgb,var(--good) 15%,transparent)}
body[data-mode="study"] .play-preview{display:none}body[data-mode="work"] .play-preview{display:none}body[data-mode="rest"] .work-preview{opacity:.55}body[data-mode="stream"] .work-preview{display:none}

.tasks-shell{padding-bottom:70px}.tasks-overview{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin:0 0 16px}.task-stat{border-radius:20px;padding:16px}.task-stat strong{display:block;font-size:26px;letter-spacing:-.04em}.task-stat span{font-size:10px;color:var(--muted)}.tasks-layout{display:grid;grid-template-columns:220px 1fr;gap:14px}.task-sidebar{border-radius:22px;padding:14px;height:max-content;position:sticky;top:100px}.task-cat{width:100%;text-align:left;border:1px solid transparent;background:transparent;border-radius:12px;padding:9px 10px;margin:2px 0;display:flex;justify-content:space-between}.task-cat.active,.task-cat:hover{background:var(--surface-strong);border-color:var(--line)}.task-cat small{color:var(--muted)}.task-main{min-width:0}.task-create{border-radius:22px;padding:14px;display:grid;grid-template-columns:1fr 150px 130px auto;gap:8px;margin-bottom:12px}.task-create input,.task-create select{border:1px solid var(--line);background:var(--surface-strong);border-radius:12px;padding:10px;outline:0}.task-create button{border:0;background:var(--text);color:var(--bg);border-radius:12px;padding:10px 14px;font-weight:700}.task-list{display:flex;flex-direction:column;gap:9px}.task-item{border:1px solid var(--line);border-radius:20px;background:var(--surface);padding:14px;transition:.2s}.task-item:hover{background:var(--surface-strong);transform:translateY(-1px)}.task-item.done{opacity:.6}.task-row{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:start}.task-check{appearance:none;width:20px;height:20px;border:1px solid var(--line);border-radius:7px;background:var(--surface-strong);display:grid;place-items:center;margin-top:1px}.task-check:checked{background:var(--text);border-color:var(--text)}.task-check:checked::after{content:"✓";color:var(--bg);font-size:12px}.task-title{font-weight:700;font-size:14px}.task-item.done .task-title{text-decoration:line-through}.task-meta{display:flex;gap:6px;align-items:center;margin-top:5px}.task-tag{font-size:9px;border:1px solid var(--line);border-radius:999px;padding:3px 7px;color:var(--muted)}.task-actions{display:flex;gap:5px}.task-actions button,.subtask-add{border:1px solid var(--line);background:var(--surface-strong);border-radius:9px;padding:5px 7px;font-size:10px}.subtasks{margin:10px 0 0 31px;border-left:1px solid var(--line);padding-left:10px;display:flex;flex-direction:column;gap:6px}.subtask{display:flex;align-items:center;gap:8px;font-size:11px}.subtask.done span{text-decoration:line-through;color:var(--muted)}.subtask input{accent-color:var(--text)}.task-empty{border:1px dashed var(--line);border-radius:22px;padding:40px;text-align:center;color:var(--muted)}

.game-grid{grid-template-columns:repeat(3,1fr)}.game-card{position:relative;overflow:hidden;min-height:236px}.game-card::before{content:"";position:absolute;width:140px;height:140px;border-radius:50%;border:1px solid var(--line);right:-58px;top:-58px;transition:.45s}.game-card:hover::before{transform:scale(1.15) rotate(12deg)}.game-card-topline{display:flex;justify-content:space-between;align-items:flex-start}.game-card .game-icon{width:54px;height:54px;border:1px solid var(--line);border-radius:16px;display:grid;place-items:center;background:var(--surface-strong);font-size:26px;transition:.25s;position:relative}.game-card:hover .game-icon{transform:translateY(-2px) rotate(-3deg)}.game-card-badges{display:flex;gap:5px;flex-wrap:wrap;justify-content:flex-end}.game-badge{font-size:8px;border:1px solid var(--line);border-radius:999px;padding:4px 6px;color:var(--muted);background:var(--surface-strong)}.game-card h3{font-size:18px;margin-top:16px}.game-card p{line-height:1.5}.game-card .game-bottom{border-top:1px solid var(--line);padding-top:12px}.game-card button{transition:.2s}.game-card button:hover{transform:translateY(-1px);opacity:.86}
.game-modal{width:min(820px,calc(100% - 28px));max-height:calc(100vh - 50px);overflow:auto}.game-modal-head{position:sticky;top:0;z-index:5;background:color-mix(in srgb,var(--surface-strong) 94%,transparent);backdrop-filter:blur(20px);padding-bottom:10px}.game-guide{display:grid;grid-template-columns:1.2fr .8fr .8fr;gap:8px;margin-bottom:12px}.game-guide-card{border:1px solid var(--line);background:var(--surface-strong);border-radius:14px;padding:10px}.game-guide-card small{display:block;color:var(--muted);font-size:8px;letter-spacing:.1em;text-transform:uppercase;margin-bottom:3px}.game-guide-card strong,.game-guide-card span{font-size:10px;line-height:1.35}.game-stage-core{border:1px solid var(--line);border-radius:20px;background:color-mix(in srgb,var(--surface-strong) 55%,transparent);padding:14px;min-height:320px;overflow:hidden}.game-stage-core.game-running{animation:stageIn .28s ease both}@keyframes stageIn{from{opacity:0;transform:translateY(7px) scale(.99)}to{opacity:1;transform:none}}.game-board .cell{transition:transform .15s,background .18s,box-shadow .18s}.game-board .cell:hover{transform:scale(.96)}.game-controls button{transition:.17s}.game-controls button:active{transform:scale(.94)}.canvas-game{border-radius:14px;box-shadow:inset 0 0 0 1px rgba(255,255,255,.05)}
.tic-shell{display:grid;gap:13px;justify-items:center}.tic-scoreboard{width:min(480px,100%);display:grid;grid-template-columns:1fr 1fr 1fr;gap:7px}.tic-score{border:1px solid var(--line);background:var(--surface-strong);border-radius:13px;padding:9px;text-align:center}.tic-score small{display:block;color:var(--muted);font-size:8px;text-transform:uppercase;letter-spacing:.08em}.tic-score strong{font-size:19px}.tic-status{font-size:12px;color:var(--muted);min-height:18px}.tic-board{display:grid;grid-template-columns:repeat(3,88px);gap:7px}.tic-cell{width:88px;height:88px;border:1px solid var(--line);border-radius:18px;background:var(--surface-strong);font-size:38px;font-weight:800;position:relative;transition:.18s;box-shadow:inset 0 1px 0 rgba(255,255,255,.15)}.tic-cell:hover:not(:disabled){transform:translateY(-2px);background:var(--surface)}.tic-cell.mark-x{animation:ticPop .22s cubic-bezier(.2,1.5,.5,1);color:var(--text)}.tic-cell.mark-o{animation:ticPop .22s cubic-bezier(.2,1.5,.5,1);color:var(--accent2)}.tic-cell.win{box-shadow:0 0 0 2px var(--good),0 10px 28px color-mix(in srgb,var(--good) 24%,transparent);transform:translateY(-2px)}@keyframes ticPop{0%{transform:scale(.45);opacity:.2}100%{transform:scale(1);opacity:1}}.tic-actions{display:flex;gap:7px}.tic-actions button{border:1px solid var(--line);background:var(--surface-strong);border-radius:11px;padding:8px 11px}.tic-actions .primary{background:var(--text);color:var(--bg);border-color:var(--text)}
@media(max-width:980px){.mode-dashboard-grid{grid-template-columns:1fr 1fr}.mode-card:first-child{grid-column:1/-1}.tasks-layout{grid-template-columns:1fr}.task-sidebar{position:static;display:flex;gap:6px;overflow:auto}.task-cat{width:auto;white-space:nowrap}.task-create{grid-template-columns:1fr 1fr}.game-guide{grid-template-columns:1fr}.main-nav .nav-btn[data-route="tasks"]{display:none}}
@media(max-width:650px){.mode-dashboard-grid{grid-template-columns:1fr}.mode-card:first-child{grid-column:auto}.task-create{grid-template-columns:1fr}.tasks-overview{grid-template-columns:1fr 1fr}.tasks-overview .task-stat:last-child{grid-column:1/-1}.tic-board{grid-template-columns:repeat(3,76px)}.tic-cell{width:76px;height:76px}.game-stage-core{padding:10px}}



/* Splash AI client */
.ai-subhero{padding-bottom:24px}.ai-subhero h1{margin-bottom:8px}.ai-subhero p{max-width:720px}
.ai-workspace{height:min(760px,calc(100vh - 150px));min-height:620px;border-radius:32px;display:grid;grid-template-columns:270px minmax(0,1fr);overflow:hidden;margin-bottom:56px}
.ai-sidebar{border-right:1px solid var(--line);padding:18px;display:flex;flex-direction:column;min-width:0;background:color-mix(in srgb,var(--surface-strong) 58%,transparent)}
.ai-brand-row{display:flex;align-items:center;gap:10px;padding:4px 4px 16px}.ai-orb-logo{width:36px;height:36px;border-radius:13px;display:grid;place-items:center;background:var(--text);color:var(--bg);font-weight:850;box-shadow:0 10px 30px rgba(0,0,0,.12)}.ai-brand-row div{display:flex;flex-direction:column}.ai-brand-row small{font-size:10px;color:var(--muted);letter-spacing:.08em}
.ai-new-chat{border:1px solid var(--line);background:var(--surface-strong);border-radius:15px;padding:11px 13px;text-align:left;font-weight:750;transition:.18s}.ai-new-chat:hover{transform:translateY(-1px);box-shadow:0 8px 24px rgba(0,0,0,.08)}
.ai-side-label{font-size:9px;letter-spacing:.16em;color:var(--muted);font-weight:800;margin:20px 5px 8px}.ai-chat-list{display:flex;flex-direction:column;gap:5px;min-height:0;overflow:auto}.ai-chat-row{display:grid;grid-template-columns:minmax(0,1fr) 28px;align-items:center;border-radius:12px}.ai-chat-row.active{background:var(--surface-strong)}.ai-chat-open{border:0;background:transparent;padding:10px 10px;text-align:left;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:12px}.ai-chat-delete{border:0;background:transparent;color:var(--muted);opacity:.45;border-radius:8px;height:26px}.ai-chat-row:hover .ai-chat-delete{opacity:1}.ai-chat-delete:hover{background:rgba(127,127,127,.1)}
.ai-connection{margin-top:auto;border:1px solid var(--line);border-radius:16px;padding:12px;background:var(--surface);display:flex;gap:10px;align-items:flex-start}.ai-status-dot{width:8px;height:8px;border-radius:50%;background:#a69e8d;margin-top:4px;box-shadow:0 0 0 4px rgba(166,158,141,.12)}.ai-status-dot.online{background:var(--good);box-shadow:0 0 0 4px color-mix(in srgb,var(--good) 18%,transparent)}.ai-connection strong{display:block;font-size:11px}.ai-connection small{display:block;color:var(--muted);font-size:9px;margin-top:2px;line-height:1.35}
.ai-main{display:grid;grid-template-rows:auto minmax(0,1fr) auto;background:linear-gradient(180deg,color-mix(in srgb,var(--surface) 35%,transparent),transparent)}
.ai-topbar{min-height:69px;border-bottom:1px solid var(--line);padding:12px 18px;display:flex;align-items:center;justify-content:space-between;gap:14px}.ai-title-wrap{display:flex;align-items:center;gap:10px;min-width:0}.ai-title-wrap div{min-width:0}.ai-title-wrap strong{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ai-title-wrap small{color:var(--muted);font-size:10px}.ai-mode-tabs{display:flex;gap:5px;padding:4px;border:1px solid var(--line);border-radius:14px;background:var(--surface)}.ai-mode-btn{border:0;background:transparent;border-radius:10px;padding:7px 9px;font-size:10px;color:var(--muted);font-weight:750}.ai-mode-btn.active{background:var(--surface-strong);color:var(--text);box-shadow:0 4px 12px rgba(0,0,0,.06)}
.ai-messages{overflow:auto;padding:28px clamp(18px,5vw,64px);scroll-behavior:smooth}.ai-welcome{max-width:680px;margin:8vh auto 0;text-align:center}.ai-welcome-mark{width:62px;height:62px;border-radius:22px;background:var(--text);color:var(--bg);display:grid;place-items:center;margin:0 auto 18px;font-size:25px;font-weight:850;box-shadow:0 18px 50px rgba(0,0,0,.14);animation:aiBreathe 3s ease-in-out infinite}.ai-welcome h2{font-size:clamp(28px,4vw,44px);letter-spacing:-.04em;margin:0}.ai-welcome p{color:var(--muted);max-width:560px;margin:12px auto 22px;line-height:1.55}.ai-starters{display:grid;grid-template-columns:1fr 1fr;gap:9px;text-align:left}.ai-starter{border:1px solid var(--line);background:var(--surface);border-radius:16px;padding:12px 13px;color:var(--text);font-size:11px;transition:.18s}.ai-starter:hover{transform:translateY(-1px);background:var(--surface-strong)}
@keyframes aiBreathe{0%,100%{transform:translateY(0);box-shadow:0 18px 50px rgba(0,0,0,.14)}50%{transform:translateY(-4px);box-shadow:0 24px 60px rgba(0,0,0,.18)}}
.ai-message{max-width:780px;margin:0 auto 22px;display:grid;grid-template-columns:32px minmax(0,1fr);gap:12px;align-items:start}.ai-message.user{grid-template-columns:minmax(0,1fr);justify-items:end}.ai-avatar{width:32px;height:32px;border-radius:11px;display:grid;place-items:center;background:var(--text);color:var(--bg);font-size:11px;font-weight:850}.ai-bubble{min-width:0;line-height:1.6;font-size:13px}.ai-message.user .ai-bubble{max-width:min(620px,88%);background:var(--surface-strong);border:1px solid var(--line);padding:11px 14px;border-radius:18px 18px 5px 18px}.ai-bubble p{margin:.15em 0 .85em}.ai-bubble p:last-child{margin-bottom:0}.ai-bubble pre{overflow:auto;background:color-mix(in srgb,var(--text) 7%,transparent);border:1px solid var(--line);padding:13px;border-radius:13px;font-size:11px;line-height:1.55}.ai-bubble code{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;background:color-mix(in srgb,var(--text) 7%,transparent);padding:2px 5px;border-radius:6px;font-size:.92em}.ai-bubble pre code{background:transparent;padding:0}.ai-msg-actions{display:flex;gap:5px;margin-top:7px}.ai-msg-actions button{border:0;background:transparent;color:var(--muted);font-size:9px;padding:5px 7px;border-radius:8px}.ai-msg-actions button:hover{background:var(--surface);color:var(--text)}.ai-file-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.ai-file-tag{font-size:9px;border:1px solid var(--line);padding:5px 7px;border-radius:9px;color:var(--muted)}
.ai-thinking{display:inline-flex;gap:4px;padding-top:4px}.ai-thinking i{width:6px;height:6px;border-radius:50%;background:var(--muted);animation:aiDot 1.1s infinite ease-in-out}.ai-thinking i:nth-child(2){animation-delay:.15s}.ai-thinking i:nth-child(3){animation-delay:.3s}@keyframes aiDot{0%,80%,100%{opacity:.25;transform:translateY(0)}40%{opacity:1;transform:translateY(-3px)}}
.ai-compose-wrap{padding:10px clamp(14px,4vw,48px) 16px}.ai-attachment-bar{max-width:800px;margin:0 auto 6px;display:flex;gap:6px;flex-wrap:wrap}.ai-attachment-chip{display:flex;align-items:center;gap:6px;padding:6px 8px;border-radius:10px;border:1px solid var(--line);background:var(--surface);font-size:9px}.ai-attachment-chip button{border:0;background:transparent;color:var(--muted);padding:0}.ai-composer{max-width:800px;margin:0 auto;border:1px solid var(--line);border-radius:22px;background:var(--surface-strong);padding:10px;box-shadow:0 16px 50px rgba(0,0,0,.08)}.ai-composer textarea{width:100%;resize:none;border:0;outline:0;background:transparent;min-height:54px;max-height:180px;padding:8px 9px;line-height:1.45}.ai-compose-actions{display:flex;align-items:center;justify-content:space-between;gap:10px}.ai-compose-left{display:flex;align-items:center;gap:6px}.ai-attach-btn,.ai-mini-btn{border:1px solid var(--line);background:transparent;border-radius:11px;padding:7px 9px;font-size:10px}.ai-send-btn{width:36px;height:36px;border:0;border-radius:12px;background:var(--text);color:var(--bg);display:grid;place-items:center;font-size:16px}.ai-send-btn:disabled{opacity:.35;cursor:default}.ai-compose-hint{max-width:800px;margin:6px auto 0;text-align:center;color:var(--muted);font-size:8.5px}
.ai-error-card{border:1px solid var(--line);border-radius:14px;padding:10px 12px;background:var(--surface);font-size:11px;color:var(--muted);margin-top:8px}
.ai-model-picker{display:flex;align-items:center;gap:7px;margin-left:auto}.ai-model-picker label{font-size:9px;letter-spacing:.12em;color:var(--muted);font-weight:800}.ai-model-select{border:1px solid var(--line);background:var(--surface-strong);border-radius:11px;padding:7px 28px 7px 9px;font-size:10px;outline:0;max-width:150px}.ai-model-select:focus{box-shadow:0 0 0 3px rgba(100,100,100,.08)}

/* Splash Free — local WebGPU brain */
.ai-local-badge{display:flex;align-items:center;gap:7px;border:1px solid var(--line);background:var(--surface-strong);border-radius:12px;padding:7px 10px;font-size:10px;font-weight:800;white-space:nowrap}.ai-local-badge i{width:7px;height:7px;border-radius:50%;background:var(--good);box-shadow:0 0 0 4px color-mix(in srgb,var(--good) 16%,transparent)}
.ai-local-bar{max-width:800px;margin:0 auto 8px;border:1px solid var(--line);background:var(--surface);border-radius:16px;padding:10px 11px;display:flex;align-items:center;gap:12px}.ai-local-info{min-width:0;flex:1}.ai-local-info strong{font-size:10px;display:block}.ai-local-info span{font-size:9px;color:var(--muted);display:block;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ai-local-progress{height:4px;border-radius:99px;background:color-mix(in srgb,var(--text) 8%,transparent);overflow:hidden;margin-top:7px}.ai-local-progress>i{display:block;height:100%;width:0;background:var(--text);border-radius:99px;transition:width .25s ease}.ai-local-install{border:1px solid var(--line);background:var(--text);color:var(--bg);border-radius:11px;padding:8px 11px;font-size:10px;font-weight:800;white-space:nowrap}.ai-local-install.secondary{background:var(--surface-strong);color:var(--text)}.ai-local-install:disabled{opacity:.45}.ai-local-note{max-width:800px;margin:0 auto 7px;font-size:8.5px;color:var(--muted);text-align:center}
@media(max-width:650px){.ai-local-bar{align-items:flex-start}.ai-local-install{padding:8px}.ai-local-badge{display:none}}
@media(max-width:850px){.ai-workspace{grid-template-columns:1fr;height:calc(100vh - 118px);min-height:600px;border-radius:24px}.ai-sidebar{display:none}.ai-mode-tabs{overflow:auto;max-width:55vw}.ai-mode-btn{white-space:nowrap}.ai-messages{padding:22px 16px}.ai-starters{grid-template-columns:1fr}.ai-topbar{padding:10px 12px}.ai-compose-wrap{padding:8px 10px 12px}}


/* v8: stable Splash layout */
#page-ai{padding-bottom:12px}
.ai-workspace{height:clamp(560px,calc(100dvh - 180px),760px);min-height:560px}
.ai-main{min-height:0;overflow:hidden}
.ai-messages{min-height:0;overscroll-behavior:contain}
.ai-compose-wrap{position:relative;z-index:5;border-top:1px solid var(--line);background:color-mix(in srgb,var(--surface-strong) 82%,transparent);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);padding:10px clamp(14px,4vw,48px) 12px}
.ai-composer{display:block;width:100%;min-height:96px}
.ai-composer textarea{display:block;width:100%;min-height:48px;max-height:130px;margin:0;overflow-y:auto}
.ai-compose-actions{min-height:38px}
.ai-local-bar{flex:0 0 auto}
@media(max-height:700px){
  #page-ai .ai-subhero{padding:28px 0 12px}
  #page-ai .ai-subhero h1{font-size:40px}
  #page-ai .ai-subhero>p:last-child{display:none}
  .ai-workspace{height:calc(100dvh - 120px);min-height:480px;margin-bottom:14px}
  .ai-messages{padding:16px 22px}
  .ai-compose-hint{display:none}
  .ai-local-bar{margin-bottom:6px}
}
@media(max-height:590px){
  #page-ai .ai-subhero{display:none}
  #page-ai{padding-top:14px}
  .ai-workspace{height:calc(100dvh - 92px);min-height:410px;margin-bottom:10px}
  .ai-topbar{min-height:56px;padding:8px 12px}
  .ai-compose-wrap{padding:7px 10px 8px}
  .ai-local-bar{padding:7px 9px}
  .ai-local-info span{display:none}
  .ai-composer{min-height:82px}
  .ai-composer textarea{min-height:40px;max-height:90px}
}


/* =========================================================
   ORBIT SAFE REDESIGN
   Built on the last stable full version. No GPU-heavy
   fullscreen filters, masks or blend modes.
   ========================================================= */
:root{
  --bg:#f1f0ec;
  --bg2:#dedbd4;
  --surface:rgba(255,255,255,.72);
  --surface-strong:rgba(255,255,255,.94);
  --text:#151515;
  --muted:#706e68;
  --line:rgba(18,18,18,.12);
  --accent:#1d1d1b;
  --accent2:#827f77;
  --shadow:0 22px 55px rgba(31,30,27,.10), inset 0 1px 0 rgba(255,255,255,.92);
}
html[data-theme="dark"]{
  --bg:#11110f;
  --bg2:#1d1c19;
  --surface:rgba(32,31,28,.82);
  --surface-strong:rgba(42,41,37,.96);
  --text:#f4f2eb;
  --muted:#aaa69d;
  --line:rgba(255,255,255,.11);
  --accent:#f2efe8;
  --accent2:#aaa59a;
  --shadow:0 24px 60px rgba(0,0,0,.34), inset 0 1px 0 rgba(255,255,255,.07);
}
body{
  background:
    radial-gradient(800px 520px at -5% 0%, rgba(255,255,255,.78), transparent 65%),
    radial-gradient(720px 520px at 102% 18%, rgba(145,143,136,.18), transparent 65%),
    radial-gradient(620px 520px at 55% 88%, rgba(255,255,255,.34), transparent 70%),
    linear-gradient(145deg,var(--bg),var(--bg2)) !important;
}
html[data-theme="dark"] body{
  background:
    radial-gradient(820px 520px at -5% 0%, rgba(255,255,255,.055), transparent 65%),
    radial-gradient(720px 520px at 102% 18%, rgba(255,255,255,.035), transparent 65%),
    linear-gradient(145deg,var(--bg),var(--bg2)) !important;
}
.glass{
  backdrop-filter:none !important;
  -webkit-backdrop-filter:none !important;
  background:var(--surface) !important;
}
.ambient{
  z-index:-1 !important;
  background:
    linear-gradient(rgba(90,90,86,.035) 1px,transparent 1px),
    linear-gradient(90deg,rgba(90,90,86,.035) 1px,transparent 1px);
  background-size:54px 54px;
}
.orb{
  filter:none !important;
  opacity:.20 !important;
  animation:orbitSafeFloat 18s ease-in-out infinite !important;
  border:1px solid var(--line);
}
.orb-a{
  background:radial-gradient(circle at 35% 35%,rgba(255,255,255,.84),rgba(145,145,138,.10) 60%,transparent 70%) !important;
}
.orb-b{
  background:radial-gradient(circle at 35% 35%,rgba(255,255,255,.54),rgba(120,120,114,.08) 60%,transparent 70%) !important;
}
.orb-c{
  background:radial-gradient(circle at 35% 35%,rgba(255,255,255,.50),rgba(95,95,90,.07) 60%,transparent 70%) !important;
}
.grid-glow{display:none !important}
@keyframes orbitSafeFloat{
  0%,100%{transform:translate3d(0,0,0)}
  50%{transform:translate3d(22px,-16px,0)}
}
.topbar{
  background:var(--surface-strong) !important;
  box-shadow:0 12px 34px rgba(30,29,26,.08) !important;
  border:1px solid var(--line) !important;
}
.brand-mark{
  background:var(--text) !important;
  color:var(--bg) !important;
  box-shadow:none !important;
}
.hero{
  padding-top:70px !important;
}
.hero h1,.subhero h1{
  text-shadow:0 1px 0 rgba(255,255,255,.22);
}
.hero-visual{
  border-radius:34px !important;
  background:
    radial-gradient(circle at 65% 35%,rgba(255,255,255,.65),transparent 26%),
    linear-gradient(145deg,var(--surface-strong),var(--surface)) !important;
  border:1px solid var(--line) !important;
  box-shadow:0 28px 70px rgba(32,31,27,.10) !important;
}
.planet-core{
  background:var(--text) !important;
  color:var(--bg) !important;
  box-shadow:0 18px 50px rgba(20,20,18,.18) !important;
}
.planet-ring{
  border-color:rgba(100,100,96,.18) !important;
}
.hero-mini-widget,
.frequent-shell,
.play-preview,
.feature-card,
.mode-dashboard-card,
.site-card,
.game-card{
  box-shadow:0 14px 36px rgba(36,35,31,.075) !important;
}
.site-card{
  min-height:158px !important;
  border-radius:24px !important;
  background:
    linear-gradient(145deg,rgba(255,255,255,.16),transparent 45%),
    var(--surface) !important;
  overflow:hidden;
}
.site-card:hover{
  transform:translateY(-5px) scale(1.008) !important;
  box-shadow:0 22px 44px rgba(33,32,29,.12) !important;
}
.site-icon{
  width:44px !important;height:44px !important;
  border-radius:14px !important;
  background:var(--text) !important;
  color:var(--bg) !important;
  box-shadow:none !important;
}
.game-grid{
  grid-template-columns:repeat(3,minmax(0,1fr)) !important;
  gap:16px !important;
}
.game-card{
  position:relative;
  min-height:224px !important;
  border-radius:26px !important;
  padding:22px !important;
  overflow:hidden;
  background:
    linear-gradient(145deg,rgba(255,255,255,.14),transparent 48%),
    var(--surface) !important;
}
.game-card::before{
  content:"";
  position:absolute;
  inset:0 0 auto 0;
  height:5px;
  background:linear-gradient(90deg,var(--text),var(--accent2),transparent);
  opacity:.75;
}
.game-card::after{
  content:"";
  position:absolute;
  width:112px;height:112px;
  border-radius:50%;
  right:-38px;top:-40px;
  background:rgba(127,124,116,.08);
  border:1px solid var(--line);
  pointer-events:none;
}
.game-card:hover{
  transform:translateY(-5px) !important;
  box-shadow:0 23px 48px rgba(31,30,27,.12) !important;
}
.game-card .game-icon{
  width:58px;height:58px;
  display:grid;place-items:center;
  border-radius:18px;
  background:var(--surface-strong);
  border:1px solid var(--line);
  font-size:28px !important;
}
.game-card h3{font-size:19px !important;margin-top:22px !important}
.game-card p{font-size:13px !important;line-height:1.55 !important}
.game-card button{
  border-radius:13px !important;
  padding:9px 13px !important;
}
.game-modal{
  background:var(--surface-strong) !important;
  backdrop-filter:none !important;
  -webkit-backdrop-filter:none !important;
  box-shadow:0 30px 90px rgba(0,0,0,.22) !important;
}
.canvas-game{
  background:
    linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px),
    #11141a !important;
  background-size:24px 24px !important;
}
.page.active{animation:orbitPageIn .25s ease both}
@keyframes orbitPageIn{
  from{opacity:.01;transform:translateY(7px)}
  to{opacity:1;transform:none}
}
.nav-btn,.glass-btn,.icon-btn,.ghost-btn,.text-link,.game-card button{
  transition:transform .18s ease,box-shadow .18s ease,background .18s ease !important;
}
.test-build-badge{
  background:var(--text) !important;
  color:var(--bg) !important;
  backdrop-filter:none !important;
  -webkit-backdrop-filter:none !important;
}
@media(max-width:980px){
  .game-grid{grid-template-columns:repeat(2,minmax(0,1fr)) !important}
}
@media(max-width:650px){
  .game-grid{grid-template-columns:1fr !important}
}


/* ============================================================
   ORBIT — iOS 27 LIQUID GLASS PASS
   Safe pass: built on the stable full ORBIT version.
   No fullscreen filters/masks that caused black-screen previews.
   ============================================================ */

:root{
  --ios-glass:rgba(255,255,255,.38);
  --ios-glass-strong:rgba(255,255,255,.54);
  --ios-edge:rgba(70,70,66,.18);
  --ios-highlight:rgba(255,255,255,.82);
  --ios-shadow:0 22px 55px rgba(34,32,29,.12);
  --ios-deep-shadow:0 34px 90px rgba(30,29,26,.15);
}
html[data-theme="dark"]{
  --ios-glass:rgba(30,30,29,.42);
  --ios-glass-strong:rgba(39,39,37,.58);
  --ios-edge:rgba(255,255,255,.13);
  --ios-highlight:rgba(255,255,255,.24);
  --ios-shadow:0 24px 58px rgba(0,0,0,.34);
  --ios-deep-shadow:0 38px 95px rgba(0,0,0,.44);
}

/* --- animated wallpaper --- */
body{
  isolation:isolate;
  background:
    radial-gradient(900px 620px at 7% 3%, rgba(255,255,255,.74), transparent 68%),
    radial-gradient(820px 620px at 96% 18%, rgba(198,201,194,.20), transparent 72%),
    radial-gradient(680px 560px at 48% 100%, rgba(255,255,255,.32), transparent 72%),
    linear-gradient(145deg,var(--bg),var(--bg2)) !important;
}
html[data-theme="dark"] body{
  background:
    radial-gradient(940px 640px at 7% 3%, rgba(255,255,255,.045), transparent 68%),
    radial-gradient(800px 600px at 98% 16%, rgba(255,255,255,.028), transparent 72%),
    radial-gradient(700px 580px at 48% 100%, rgba(255,255,255,.022), transparent 72%),
    linear-gradient(145deg,var(--bg),var(--bg2)) !important;
}
.ios-wallpaper{
  position:fixed;
  inset:0;
  z-index:-3;
  overflow:hidden;
  pointer-events:none;
}
.ios-shape{
  position:absolute;
  will-change:transform;
  opacity:.72;
  transform:translate3d(0,0,0);
  animation:iosFloat var(--dur,24s) ease-in-out infinite alternate;
}
.ios-shape::before,
.ios-shape::after{
  content:"";
  position:absolute;
  inset:0;
  border-radius:inherit;
  pointer-events:none;
}
.ios-shape::before{
  background:
    linear-gradient(145deg,rgba(255,255,255,.58),rgba(255,255,255,.12) 38%,rgba(118,121,114,.09) 76%,rgba(255,255,255,.24));
  border:1px solid rgba(255,255,255,.5);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.74),
    inset 0 -1px 0 rgba(45,45,42,.10),
    0 22px 50px rgba(35,34,31,.07);
}
.ios-shape::after{
  inset:8% 10% auto 12%;
  height:20%;
  border-radius:999px;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.66),transparent);
  opacity:.7;
}
html[data-theme="dark"] .ios-shape::before{
  background:
    linear-gradient(145deg,rgba(255,255,255,.10),rgba(255,255,255,.025) 46%,rgba(255,255,255,.055));
  border-color:rgba(255,255,255,.12);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.14),
    inset 0 -1px 0 rgba(0,0,0,.26),
    0 25px 58px rgba(0,0,0,.16);
}
.ios-shape.s1{
  width:310px;height:310px;border-radius:42% 58% 63% 37%/42% 44% 56% 58%;
  left:-82px;top:12%;--dur:27s;
}
.ios-shape.s2{
  width:220px;height:360px;border-radius:46% 54% 58% 42%/34% 60% 40% 66%;
  right:-76px;top:20%;--dur:31s;animation-delay:-7s;
}
.ios-shape.s3{
  width:190px;height:190px;border-radius:50%;
  left:21%;bottom:-66px;--dur:23s;animation-delay:-13s;
}
.ios-shape.s4{
  width:250px;height:160px;border-radius:48% 52% 44% 56%/58% 42% 58% 42%;
  right:23%;bottom:10%;--dur:29s;animation-delay:-4s;
}
.ios-shape.s5{
  width:120px;height:120px;border-radius:34% 66% 55% 45%/50% 35% 65% 50%;
  left:54%;top:10%;--dur:19s;animation-delay:-10s;
}
.ios-ring{
  position:absolute;
  width:270px;height:270px;
  border-radius:50%;
  border:1px solid rgba(255,255,255,.38);
  box-shadow:
    inset 0 0 0 24px rgba(255,255,255,.045),
    0 18px 45px rgba(40,40,36,.04);
  right:9%;
  top:49%;
  opacity:.58;
  animation:iosRing 26s linear infinite;
}
html[data-theme="dark"] .ios-ring{
  border-color:rgba(255,255,255,.09);
  box-shadow:inset 0 0 0 24px rgba(255,255,255,.018);
}
@keyframes iosFloat{
  0%{transform:translate3d(0,0,0) rotate(-3deg) scale(1)}
  35%{transform:translate3d(28px,-22px,0) rotate(2deg) scale(1.035)}
  70%{transform:translate3d(-12px,26px,0) rotate(-1deg) scale(.985)}
  100%{transform:translate3d(38px,12px,0) rotate(4deg) scale(1.02)}
}
@keyframes iosRing{
  from{transform:rotate(0deg) translate3d(0,0,0)}
  to{transform:rotate(360deg) translate3d(0,0,0)}
}

/* --- Liquid Glass material --- */
.glass,
.topbar,
.hero-mini-widget,
.hero-visual,
.frequent-shell,
.play-preview,
.feature-card,
.site-card,
.game-card,
.mode-dashboard-card,
.mode-card,
.task-card,
.tool-card,
.work-card,
.collection-chip,
.category-btn,
.ai-sidebar,
.ai-main,
.ai-composer,
.ai-message,
.game-modal,
.modal-card{
  background:
    linear-gradient(145deg,rgba(255,255,255,.32),rgba(255,255,255,.09) 46%,rgba(255,255,255,.20)),
    var(--ios-glass) !important;
  border:1px solid var(--ios-edge) !important;
  box-shadow:
    inset 0 1px 0 var(--ios-highlight),
    inset 0 -1px 0 rgba(30,30,28,.08),
    var(--ios-shadow) !important;
}
@supports (backdrop-filter: blur(1px)){
  .glass,
  .topbar,
  .hero-mini-widget,
  .hero-visual,
  .frequent-shell,
  .play-preview,
  .feature-card,
  .site-card,
  .game-card,
  .mode-dashboard-card,
  .mode-card,
  .task-card,
  .tool-card,
  .work-card,
  .collection-chip,
  .category-btn,
  .ai-sidebar,
  .ai-main,
  .ai-composer,
  .game-modal,
  .modal-card{
    backdrop-filter:blur(16px) saturate(150%) contrast(1.04) !important;
    -webkit-backdrop-filter:blur(16px) saturate(150%) contrast(1.04) !important;
  }
}
html[data-theme="dark"] .glass,
html[data-theme="dark"] .topbar,
html[data-theme="dark"] .hero-mini-widget,
html[data-theme="dark"] .hero-visual,
html[data-theme="dark"] .frequent-shell,
html[data-theme="dark"] .play-preview,
html[data-theme="dark"] .feature-card,
html[data-theme="dark"] .site-card,
html[data-theme="dark"] .game-card,
html[data-theme="dark"] .mode-dashboard-card,
html[data-theme="dark"] .mode-card,
html[data-theme="dark"] .task-card,
html[data-theme="dark"] .tool-card,
html[data-theme="dark"] .work-card{
  background:
    linear-gradient(145deg,rgba(255,255,255,.075),rgba(255,255,255,.018) 48%,rgba(255,255,255,.045)),
    var(--ios-glass) !important;
}

/* strong edge + specular highlight */
.topbar::after,
.site-card::after,
.game-card::after,
.feature-card::after,
.hero-mini-widget::after,
.mode-card::after,
.task-card::after,
.tool-card::after,
.work-card::after,
.collection-chip::after,
.category-btn::after,
.glass-btn::after,
.icon-btn::after,
.nav-btn::after{
  content:"";
  position:absolute;
  pointer-events:none;
  inset:1px;
  border-radius:inherit;
  background:
    radial-gradient(180px 70px at var(--gx,22%) var(--gy,0%),rgba(255,255,255,.56),transparent 66%);
  opacity:.72;
  transition:opacity .2s ease;
  z-index:0;
}
.topbar > *,
.site-card > *,
.game-card > *,
.feature-card > *,
.hero-mini-widget > *,
.mode-card > *,
.task-card > *,
.tool-card > *,
.work-card > *,
.collection-chip > *,
.category-btn > *,
.glass-btn > *,
.icon-btn > *,
.nav-btn > *{
  position:relative;
  z-index:1;
}

/* --- living controls/cards --- */
.nav-btn,
.glass-btn,
.icon-btn,
.ghost-btn,
.text-link,
.category-btn,
.collection-chip,
.site-card,
.game-card,
.feature-card,
.hero-mini-widget,
.mode-card,
.task-card,
.tool-card,
.work-card,
.ai-history-item,
.quick-link,
.preview-game,
button{
  --tilt-x:0deg;
  --tilt-y:0deg;
  --move-x:0px;
  --move-y:0px;
  --press-scale:1;
  transform:
    perspective(760px)
    translate3d(var(--move-x),var(--move-y),0)
    rotateX(var(--tilt-x))
    rotateY(var(--tilt-y))
    scale(var(--press-scale));
  transform-origin:center;
  transition:
    transform .19s cubic-bezier(.2,.8,.2,1),
    box-shadow .19s ease,
    background .19s ease,
    border-color .19s ease !important;
  will-change:transform;
}
.nav-btn:hover,
.glass-btn:hover,
.icon-btn:hover,
.ghost-btn:hover,
.category-btn:hover,
.collection-chip:hover,
.site-card:hover,
.game-card:hover,
.feature-card:hover,
.hero-mini-widget:hover,
.mode-card:hover,
.task-card:hover,
.tool-card:hover,
.work-card:hover{
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.9),
    0 24px 52px rgba(35,34,31,.13) !important;
}
.ios-pressed{
  --press-scale:.965 !important;
}
.ios-held{
  --press-scale:.985 !important;
}
.ios-interactive{
  -webkit-tap-highlight-color:transparent;
  user-select:none;
}

/* iOS-like floating controls */
.nav-btn,
.glass-btn,
.icon-btn,
.category-btn,
.collection-chip{
  overflow:hidden;
  border-radius:999px !important;
}
.site-card,
.game-card,
.feature-card,
.hero-mini-widget,
.mode-card,
.task-card,
.tool-card,
.work-card{
  border-radius:28px !important;
}

/* navigation floats over content more like iOS */
.topbar{
  margin-top:8px !important;
  border-radius:28px !important;
  background:
    linear-gradient(145deg,rgba(255,255,255,.42),rgba(255,255,255,.15)),
    var(--ios-glass-strong) !important;
}
@supports (backdrop-filter: blur(1px)){
  .topbar{
    backdrop-filter:blur(22px) saturate(165%) contrast(1.05) !important;
    -webkit-backdrop-filter:blur(22px) saturate(165%) contrast(1.05) !important;
  }
}

/* a little more breathing room */
.section-block{margin-top:34px !important}
.site-card{min-height:168px !important}
.game-card{min-height:236px !important}

/* mobile: no tilt, only tactile press */
@media (hover:none), (pointer:coarse){
  .nav-btn,
  .glass-btn,
  .icon-btn,
  .ghost-btn,
  .text-link,
  .category-btn,
  .collection-chip,
  .site-card,
  .game-card,
  .feature-card,
  .hero-mini-widget,
  .mode-card,
  .task-card,
  .tool-card,
  .work-card,
  button{
    --tilt-x:0deg !important;
    --tilt-y:0deg !important;
    --move-x:0px !important;
    --move-y:0px !important;
  }
}

/* accessibility */
@media (prefers-reduced-motion:reduce){
  .ios-shape,.ios-ring{animation:none !important}
  .nav-btn,.glass-btn,.icon-btn,.ghost-btn,.text-link,.category-btn,.collection-chip,
  .site-card,.game-card,.feature-card,.hero-mini-widget,.mode-card,.task-card,.tool-card,.work-card,button{
    transition:none !important;
    transform:none !important;
  }
}


/* ===== Games + layout fix for iOS pass ===== */
.site-card,
.game-card,
.feature-card,
.hero-mini-widget,
.mode-card,
.task-card,
.tool-card,
.work-card,
.collection-chip,
.category-btn,
.glass-btn,
.icon-btn,
.nav-btn{
  position:relative;
}
.topbar{
  position:sticky !important;
  top:10px !important;
  z-index:60 !important;
}
.game-modal{
  position:fixed !important;
  left:50% !important;
  top:50% !important;
  transform:translate(-50%,-50%) !important;
  z-index:81 !important;
  width:min(820px,calc(100% - 28px)) !important;
  max-height:86vh !important;
  overflow:auto !important;
}
.modal-backdrop{
  position:fixed !important;
  inset:0 !important;
  z-index:70 !important;
}
.game-card{
  cursor:pointer;
}
#game-stage,
#game-stage-core{
  position:relative;
  z-index:2;
}


.game-card:active{
  --press-scale:.975 !important;
}
.game-modal:not(.hidden){
  animation:gameModalIn .2s cubic-bezier(.2,.8,.2,1) both;
}
@keyframes gameModalIn{
  from{opacity:.2;transform:translate(-50%,-48%) scale(.975)}
  to{opacity:1;transform:translate(-50%,-50%) scale(1)}
}


/* ===== ORBIT wallpaper visibility + tools/work pass ===== */
.ios-shape{opacity:.9 !important}
.ios-shape::before{
  background:linear-gradient(145deg,rgba(255,255,255,.76),rgba(172,172,164,.20) 42%,rgba(90,90,86,.13) 72%,rgba(255,255,255,.42)) !important;
  border-color:rgba(44,44,41,.13) !important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.92),inset 0 -1px 0 rgba(45,45,42,.13),0 26px 58px rgba(35,34,31,.085) !important;
}
html[data-theme="dark"] .ios-shape{opacity:.8 !important}
html[data-theme="dark"] .ios-shape::before{
  background:linear-gradient(145deg,rgba(255,255,255,.15),rgba(255,255,255,.045) 44%,rgba(255,255,255,.075)) !important;
  border-color:rgba(255,255,255,.18) !important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.20),inset 0 -1px 0 rgba(0,0,0,.28),0 28px 64px rgba(0,0,0,.20) !important;
}
.ios-ring{opacity:.78 !important;border-color:rgba(48,48,44,.14) !important;box-shadow:inset 0 0 0 24px rgba(80,80,75,.045),0 18px 45px rgba(40,40,36,.055) !important}
html[data-theme="dark"] .ios-ring{border-color:rgba(255,255,255,.16) !important;box-shadow:inset 0 0 0 24px rgba(255,255,255,.028) !important}
.ios-shape.s6{width:170px;height:280px;border-radius:55% 45% 35% 65%/36% 58% 42% 64%;left:68%;top:62%;--dur:33s;animation-delay:-16s}
.ios-glass-pill{position:absolute;width:310px;height:92px;left:8%;top:65%;border-radius:999px;border:1px solid rgba(40,40,37,.11);background:linear-gradient(145deg,rgba(255,255,255,.56),rgba(125,125,118,.10));box-shadow:inset 0 1px 0 rgba(255,255,255,.75),0 22px 48px rgba(40,39,35,.055);opacity:.63;transform:rotate(-13deg);animation:iosPillFloat 28s ease-in-out infinite alternate}
html[data-theme="dark"] .ios-glass-pill{border-color:rgba(255,255,255,.11);background:linear-gradient(145deg,rgba(255,255,255,.085),rgba(255,255,255,.025));opacity:.7}
@keyframes iosPillFloat{from{transform:translate3d(0,0,0) rotate(-13deg)}to{transform:translate3d(42px,-26px,0) rotate(-7deg)}}

/* clearer modes */
.mode-switcher{padding:7px;width:max-content;max-width:100%;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.20)}
html[data-theme="dark"] .mode-switcher{background:rgba(255,255,255,.025)}
.mode-switcher-label{padding-left:6px}.mode-pill{min-height:38px;border-radius:999px !important;padding:8px 13px !important}.mode-pill.active{box-shadow:0 9px 24px rgba(20,20,18,.14) !important}
.mode-inline-help{margin-top:12px;padding:13px 14px;border:1px solid var(--line);border-radius:18px;background:var(--ios-glass);display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;max-width:760px}
.mode-inline-icon{width:38px;height:38px;border-radius:13px;display:grid;place-items:center;background:var(--text);color:var(--bg);font-size:17px;font-weight:800}
.mode-inline-copy strong{display:block;font-size:12px}.mode-inline-copy span{display:block;font-size:10px;line-height:1.45;color:var(--muted);margin-top:2px}
.mode-inline-state{font-size:9px;font-weight:800;letter-spacing:.08em;padding:7px 9px;border-radius:999px;background:var(--surface-strong);border:1px solid var(--line);white-space:nowrap}
body[data-mode="work"] .mode-inline-help{box-shadow:inset 0 1px 0 rgba(255,255,255,.8),0 18px 42px rgba(30,30,27,.10) !important}
body[data-mode="work"] .mode-inline-icon{animation:workModePulse 2.6s ease-in-out infinite}
@keyframes workModePulse{50%{transform:scale(1.055)}}
.mode-dashboard-grid{grid-template-columns:1.25fr 1fr 1fr !important}.mode-card{min-height:145px !important;padding:19px !important}.mode-card h3{font-size:20px !important}.mode-card p{font-size:11.5px !important;max-width:94% !important}
.mode-card:first-child{background:linear-gradient(145deg,rgba(255,255,255,.34),rgba(255,255,255,.10)),var(--ios-glass-strong) !important}
.mode-change-list{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}.mode-change-chip{border:1px solid var(--line);background:var(--surface-strong);border-radius:999px;padding:5px 8px;font-size:9px;color:var(--muted)}

/* tools 2.0 */
.tools-grid{grid-template-columns:repeat(2,minmax(0,1fr)) !important;gap:16px !important}
.tool-card{min-height:280px !important;border-radius:30px !important;overflow:hidden}
.tool-card .tool-icon{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;border:1px solid var(--line);background:var(--surface-strong);font-size:18px;margin-bottom:12px}
.tool-card h3{font-size:23px !important}
.calc-shell{border:1px solid var(--line);border-radius:22px;background:rgba(255,255,255,.16);padding:10px}
.calc-display{min-height:86px;border-radius:16px;border:1px solid var(--line);background:var(--surface-strong);padding:12px 14px;text-align:right;display:flex;flex-direction:column;justify-content:flex-end;margin-bottom:10px}
.calc-expression{min-height:20px;color:var(--muted);font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.calc-result{margin:4px 0 0 !important;font-size:34px !important;line-height:1.05;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.calc-keys{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}
.tool-card .calc-key{min-height:48px;padding:0 !important;border-radius:15px !important;background:var(--surface-strong) !important;color:var(--text) !important;font-size:16px;font-weight:750}
.tool-card .calc-key.op,.tool-card .calc-key.eq{background:var(--text) !important;color:var(--bg) !important}.tool-card .calc-key.soft{background:rgba(127,127,127,.13) !important}
.converter-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}.tool-output{border:1px solid var(--line);background:var(--surface-strong);border-radius:14px;padding:12px;min-height:46px;display:flex;align-items:center;justify-content:space-between;gap:10px;font-weight:700}
.text-stats{display:flex;gap:8px;flex-wrap:wrap;margin:9px 0}.text-stat{border:1px solid var(--line);background:var(--surface-strong);border-radius:999px;padding:5px 8px;font-size:9px;color:var(--muted)}
.color-lab{display:grid;grid-template-columns:76px 1fr;gap:12px;align-items:center}.color-swatch{width:76px;height:76px;border-radius:22px;border:1px solid var(--line);background:#1d1d1d;box-shadow:inset 0 1px 0 rgba(255,255,255,.25)}.color-input-wrap input[type=color]{height:44px;padding:4px}.random-result{font-size:30px;font-weight:850;letter-spacing:-.04em;margin:10px 0}
@media(max-width:900px){.mode-inline-help{grid-template-columns:auto 1fr}.mode-inline-state{grid-column:2}.tools-grid{grid-template-columns:1fr !important}}
@media(max-width:600px){.mode-switcher{border-radius:22px}.mode-inline-help{grid-template-columns:1fr}.mode-inline-icon{display:none}.mode-inline-state{grid-column:auto;width:max-content}.converter-grid{grid-template-columns:1fr}}


/* ================================================================
   ORBIT PLAY — DETAILED GAME PASS
   ================================================================ */
.game-stage-core{min-height:400px}
.game-hud{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin:0 auto 14px;max-width:760px}
.game-hud-group{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.game-hud-chip{padding:8px 11px;border-radius:14px;border:1px solid var(--line);background:var(--surface-strong);font-size:11px;color:var(--muted);box-shadow:inset 0 1px 0 rgba(255,255,255,.45)}
.game-hud-chip strong{display:block;color:var(--text);font-size:16px;margin-top:2px}
.game-action{border:1px solid var(--line);background:var(--surface-strong);color:var(--text);border-radius:14px;padding:9px 12px;cursor:pointer}
.game-over-card{position:absolute;inset:50% auto auto 50%;transform:translate(-50%,-50%);min-width:230px;padding:20px;border-radius:24px;text-align:center;background:rgba(18,19,20,.82);color:#fff;border:1px solid rgba(255,255,255,.16);box-shadow:0 26px 70px rgba(0,0,0,.35);z-index:10}
.game-over-card h3{margin:0 0 6px;font-size:25px}.game-over-card p{margin:0 0 14px;color:rgba(255,255,255,.7)}
.game-over-card button{background:#fff!important;color:#111!important;border:0!important}
.game-note-row{text-align:center;color:var(--muted);font-size:10px;margin-top:9px}
.canvas-frame{position:relative;width:min(100%,760px);margin:auto;border:1px solid var(--line);border-radius:24px;overflow:hidden;background:#101318;box-shadow:inset 0 1px 0 rgba(255,255,255,.08),0 18px 45px rgba(0,0,0,.12)}
.canvas-frame canvas{display:block;width:100%;height:auto;touch-action:none}

/* Block Blast */
.blockblast-shell{width:min(100%,430px);margin:auto}
.blockblast-board{display:grid;grid-template-columns:repeat(8,1fr);gap:5px;aspect-ratio:1/1;padding:10px;border-radius:25px;border:1px solid var(--line);background:linear-gradient(145deg,rgba(255,255,255,.09),rgba(0,0,0,.04)),#171a20;box-shadow:inset 0 1px 0 rgba(255,255,255,.08),0 18px 48px rgba(0,0,0,.16)}
.block-cell{position:relative;border-radius:8px;background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.035);transition:transform .14s ease,background .14s ease,box-shadow .14s ease;min-width:0;min-height:0}
.block-cell.filled{background:var(--block-color,#aab4ff);box-shadow:inset 0 1px 0 rgba(255,255,255,.48),inset 0 -3px 8px rgba(0,0,0,.12),0 3px 8px rgba(0,0,0,.14)}
.block-cell.preview{background:var(--block-color,#aab4ff);opacity:.52;transform:scale(.92)}
.block-cell.invalid{background:rgba(214,98,92,.25)}
.block-cell.clearing{animation:blockPop .28s ease forwards}
@keyframes blockPop{50%{transform:scale(1.2);filter:brightness(1.45)}100%{transform:scale(.1);opacity:0}}
.block-tray{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}
.block-piece{min-height:76px;border:1px solid var(--line);border-radius:20px;background:var(--surface-strong);display:grid;place-items:center;padding:10px;cursor:grab;touch-action:none;position:relative;transition:transform .18s ease,opacity .18s ease,box-shadow .18s ease}
.block-piece:hover{transform:translateY(-3px);box-shadow:0 15px 28px rgba(0,0,0,.10)}
.block-piece.selected{outline:2px solid var(--text);transform:translateY(-4px)}
.block-piece.used{opacity:.18;pointer-events:none;transform:scale(.94)}
.block-piece-grid{display:grid;gap:4px}
.block-piece-cell{width:16px;height:16px;border-radius:6px;background:var(--piece-color,#aab4ff);box-shadow:inset 0 1px 0 rgba(255,255,255,.55),inset 0 -2px 5px rgba(0,0,0,.12)}
.block-piece-cell.empty{background:transparent;box-shadow:none}
.block-combo{font-size:12px;font-weight:800;letter-spacing:.07em;opacity:0;transform:translateY(4px);transition:.2s ease}.block-combo.show{opacity:1;transform:none}
.block-ghost{position:fixed;z-index:99999;pointer-events:none;opacity:.82;transform:translate(-50%,-70%);filter:drop-shadow(0 15px 15px rgba(0,0,0,.2))}

/* Memory */
.memory-grid{display:grid;grid-template-columns:repeat(4,minmax(58px,92px));gap:10px;justify-content:center;perspective:900px}
.memory-card{height:88px;border:0;background:transparent!important;padding:0!important;perspective:800px}
.memory-card-inner{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform .36s cubic-bezier(.2,.8,.2,1)}
.memory-card.open .memory-card-inner,.memory-card.matched .memory-card-inner{transform:rotateY(180deg)}
.memory-face{position:absolute;inset:0;display:grid;place-items:center;border-radius:20px;border:1px solid var(--line);backface-visibility:hidden;box-shadow:inset 0 1px 0 rgba(255,255,255,.55),0 10px 22px rgba(0,0,0,.07)}
.memory-back{background:linear-gradient(145deg,var(--text),#5f5d57);color:var(--bg);font-size:22px}.memory-front{transform:rotateY(180deg);background:var(--surface-strong);font-size:30px}.memory-card.matched .memory-front{outline:2px solid rgba(100,170,115,.5)}

/* Mines */
.mines-board{display:grid;grid-template-columns:repeat(9,38px);gap:4px;justify-content:center}
.mine-cell{width:38px;height:38px!important;padding:0!important;border-radius:10px!important;font-weight:850;font-size:14px!important;background:var(--surface-strong)!important;color:var(--text)!important;border:1px solid var(--line)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.5)}
.mine-cell.open{background:rgba(120,120,115,.10)!important;box-shadow:none!important}.mine-cell.flag{color:#d3a04f!important}.mine-cell.mine{background:rgba(195,80,80,.20)!important}.mine-cell[data-n="1"]{color:#7aa8ff!important}.mine-cell[data-n="2"]{color:#78b585!important}.mine-cell[data-n="3"]{color:#df7d75!important}.mine-cell[data-n="4"]{color:#9b87e8!important}

/* Sudoku */
.sudoku-shell{width:min(100%,430px);margin:auto}.sudoku-board{display:grid;grid-template-columns:repeat(4,1fr);border:2px solid var(--text);border-radius:18px;overflow:hidden;background:var(--surface-strong)}
.sudoku-cell{aspect-ratio:1;border:0;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:transparent!important;font-size:28px!important;font-weight:750;color:var(--text)!important;border-radius:0!important}.sudoku-cell:nth-child(4n){border-right:0}.sudoku-cell:nth-child(n+13){border-bottom:0}.sudoku-cell:nth-child(2),.sudoku-cell:nth-child(6),.sudoku-cell:nth-child(10),.sudoku-cell:nth-child(14){border-right:2px solid var(--text)}.sudoku-cell:nth-child(n+5):nth-child(-n+8){border-bottom:2px solid var(--text)}
.sudoku-cell.given{background:rgba(120,120,115,.10)!important}.sudoku-cell.selected{box-shadow:inset 0 0 0 3px rgba(140,150,235,.55)}.sudoku-cell.error{color:#d96f68!important;background:rgba(217,111,104,.10)!important}.sudoku-numpad{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px}.sudoku-numpad button{font-size:20px!important;min-height:48px}

/* Simon */
.simon-board{display:grid;grid-template-columns:repeat(2,130px);gap:10px;justify-content:center;margin:12px auto}.simon-pad{height:130px!important;border-radius:34px!important;opacity:.54;border:1px solid rgba(255,255,255,.14)!important;transition:transform .12s ease,filter .12s ease,opacity .12s ease!important}.simon-pad:nth-child(1){background:#d36c69!important}.simon-pad:nth-child(2){background:#6eae82!important}.simon-pad:nth-child(3){background:#d3ad58!important}.simon-pad:nth-child(4){background:#6f8ed4!important}.simon-pad.flash{opacity:1;transform:scale(.94);filter:brightness(1.35);box-shadow:0 0 32px currentColor!important}

/* Lights */
.lights-board{display:grid;grid-template-columns:repeat(5,58px);gap:7px;justify-content:center}.light-cell{width:58px;height:58px!important;border-radius:18px!important;background:rgba(90,90,86,.09)!important;border:1px solid var(--line)!important}.light-cell.on{background:#f2dc77!important;box-shadow:0 0 28px rgba(242,220,119,.42),inset 0 1px 0 rgba(255,255,255,.8)!important}.light-cell.on::after{content:'✦';font-size:19px;color:#6b5920}

/* Reaction */
.reaction-panel{width:min(100%,620px);height:330px;margin:auto;border-radius:28px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;border:1px solid var(--line);background:#25272d;cursor:pointer;user-select:none;color:#fff;transition:background .16s ease,transform .16s ease}.reaction-panel.wait{background:#363842}.reaction-panel.ready{background:#4d9b64}.reaction-panel.too-soon{background:#9d5e5a}.reaction-panel strong{font-size:38px}.reaction-panel span{font-size:12px;opacity:.72;margin-top:9px}

/* RPS */
.rps-arena{display:grid;grid-template-columns:1fr auto 1fr;gap:18px;align-items:center;max-width:650px;margin:18px auto}.rps-hand{height:150px;border:1px solid var(--line);border-radius:28px;background:var(--surface-strong);display:grid;place-items:center;font-size:64px;box-shadow:inset 0 1px 0 rgba(255,255,255,.5)}.rps-vs{font-size:13px;color:var(--muted);font-weight:900}.rps-choice-row{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;max-width:600px;margin:auto}.rps-choice{min-height:72px!important;font-size:26px!important}.rps-choice small{display:block;font-size:9px;margin-top:3px;color:var(--muted)}

/* Quiz */
.quiz-shell{max-width:650px;margin:auto}.quiz-progress{height:7px;background:rgba(100,100,96,.12);border-radius:999px;overflow:hidden;margin:12px 0 20px}.quiz-progress i{display:block;height:100%;background:var(--text);width:0;transition:.28s ease}.quiz-question{font-size:26px;font-weight:800;line-height:1.18;text-align:center;margin:24px auto;max-width:560px}.quiz-options{display:grid;gap:9px}.quiz-option{min-height:52px!important;text-align:left!important;padding:12px 15px!important}.quiz-option.good{background:rgba(85,165,105,.18)!important;outline:2px solid rgba(85,165,105,.38)}.quiz-option.bad{background:rgba(205,90,85,.15)!important;outline:2px solid rgba(205,90,85,.34)}

/* Guess */
.guess-shell{max-width:520px;margin:auto;text-align:center}.guess-number{font-size:66px;font-weight:900;letter-spacing:-.06em;margin:12px 0}.guess-form{display:grid;grid-template-columns:1fr auto;gap:8px}.guess-history{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;margin-top:12px}.guess-chip{padding:6px 9px;border:1px solid var(--line);border-radius:999px;background:var(--surface-strong);font-size:10px}.guess-thermo{height:8px;border-radius:999px;background:linear-gradient(90deg,#748ed2,#9fbc8b,#d5a064,#c96865);margin:14px 0;position:relative}.guess-thermo i{position:absolute;width:14px;height:14px;border-radius:50%;background:var(--text);top:50%;transform:translate(-50%,-50%);left:50%;box-shadow:0 2px 8px rgba(0,0,0,.25)}

/* 2048 */
.g2048-shell{width:min(100%,430px);margin:auto}.g2048-board{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;background:rgba(110,105,95,.16);padding:9px;border-radius:22px}.g2048-cell{aspect-ratio:1;border-radius:15px;display:grid;place-items:center;font-size:26px;font-weight:900;background:rgba(255,255,255,.18);transition:transform .14s ease,background .14s ease;color:#25231f}.g2048-cell.spawn{animation:g2048pop .18s ease}.g2048-cell.merge{animation:g2048merge .2s ease}@keyframes g2048pop{from{transform:scale(.4)}to{transform:scale(1)}}@keyframes g2048merge{50%{transform:scale(1.13)}}

/* Tic tac toe */
.tic-shell{max-width:520px;margin:auto}.tic-scoreboard{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}.tic-score{padding:9px;border:1px solid var(--line);border-radius:16px;background:var(--surface-strong);text-align:center}.tic-score small{display:block;color:var(--muted);font-size:8px}.tic-score strong{font-size:21px}.tic-status{text-align:center;margin:10px 0 12px;color:var(--muted)}.tic-board{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;position:relative}.tic-cell{aspect-ratio:1;border-radius:24px!important;font-size:45px!important;font-weight:900!important;background:var(--surface-strong)!important;border:1px solid var(--line)!important}.tic-cell.mark-x{color:#5f82ce!important}.tic-cell.mark-o{color:#cf7770!important}.tic-cell.win{outline:3px solid rgba(102,167,115,.52);animation:ticWin .5s ease}@keyframes ticWin{50%{transform:scale(1.06)}}.tic-actions{display:flex;justify-content:center;gap:8px;margin-top:12px}

@media(max-width:620px){
 .blockblast-board{gap:3px;padding:7px}.block-cell{border-radius:5px}.block-piece{min-height:86px}.block-piece-cell{width:15px;height:15px;border-radius:4px}
 .mines-board{grid-template-columns:repeat(9,31px);gap:3px}.mine-cell{width:31px;height:31px!important;border-radius:8px!important;font-size:12px!important}
 .simon-board{grid-template-columns:repeat(2,105px)}.simon-pad{height:105px!important;border-radius:27px!important}
 .lights-board{grid-template-columns:repeat(5,48px)}.light-cell{width:48px;height:48px!important;border-radius:14px!important}
 .rps-arena{grid-template-columns:1fr 42px 1fr;gap:8px}.rps-hand{height:115px;font-size:50px;border-radius:22px}.rps-choice-row{grid-template-columns:repeat(3,1fr)}
 .quiz-question{font-size:22px}
}


/* ===== ORBIT FAMILY FINAL GAME POLISH ===== */
.sudoku-shell{width:min(100%,560px);margin:auto}
.sudoku-toolbar{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin:0 0 10px}
.sudoku-toolbar button{min-height:38px!important;padding:7px 11px!important}
.sudoku-board{
  display:grid!important;
  grid-template-columns:repeat(9,1fr)!important;
  border:2px solid var(--text)!important;
  border-radius:18px!important;
  overflow:hidden!important;
  background:var(--surface-strong)!important;
  aspect-ratio:1;
}
.sudoku-cell{
  aspect-ratio:1!important;
  min-width:0!important;
  width:auto!important;height:auto!important;
  border:0!important;
  border-right:1px solid var(--line)!important;
  border-bottom:1px solid var(--line)!important;
  background:transparent!important;
  font-size:clamp(15px,3.1vw,24px)!important;
  font-weight:760!important;
  color:var(--text)!important;
  border-radius:0!important;
  position:relative;
}
.sudoku-cell:nth-child(9n){border-right:0!important}
.sudoku-cell:nth-child(n+73){border-bottom:0!important}
.sudoku-cell:nth-child(3n):not(:nth-child(9n)){border-right:2px solid var(--text)!important}
.sudoku-cell:nth-child(n+19):nth-child(-n+27),
.sudoku-cell:nth-child(n+46):nth-child(-n+54){border-bottom:2px solid var(--text)!important}
.sudoku-cell.given{background:rgba(120,120,115,.10)!important;font-weight:850!important}
.sudoku-cell.peer{background:rgba(125,135,150,.07)!important}
.sudoku-cell.same{background:rgba(145,150,225,.12)!important}
.sudoku-cell.selected{box-shadow:inset 0 0 0 3px rgba(140,150,235,.62)!important;z-index:2}
.sudoku-cell.error{color:#d96f68!important;background:rgba(217,111,104,.11)!important}
.sudoku-notes{font-size:8px;line-height:1.05;display:grid;grid-template-columns:repeat(3,1fr);width:100%;height:100%;padding:3px;color:var(--muted);font-weight:650}
.sudoku-notes span{display:grid;place-items:center}
.sudoku-numpad{display:grid!important;grid-template-columns:repeat(9,1fr)!important;gap:6px!important;margin-top:12px!important}
.sudoku-numpad button{font-size:17px!important;min-height:43px!important;padding:0!important}
.sudoku-numpad button.used{opacity:.35}
@media(max-width:600px){
  .sudoku-shell{width:100%}
  .sudoku-board{border-radius:12px!important}
  .sudoku-cell{font-size:16px!important}
  .sudoku-numpad{gap:4px!important}
  .sudoku-numpad button{min-height:38px!important;font-size:15px!important}
}

.tetris-layout{
  display:grid;
  grid-template-columns:minmax(0,360px) 150px;
  gap:14px;
  align-items:start;
  justify-content:center;
  margin-top:10px;
}
.tetris-side{
  display:grid;
  gap:10px;
}
.tetris-next{
  border:1px solid var(--line);
  background:var(--surface-strong);
  border-radius:18px;
  padding:12px;
}
.tetris-next small{
  display:block;color:var(--muted);font-size:9px;letter-spacing:.12em;text-transform:uppercase;margin-bottom:8px
}
.tetris-next-grid{
  width:126px;height:126px;
  display:grid;place-items:center;
  border-radius:14px;
  background:#10141a;
  overflow:hidden;
}
.tetris-next-grid canvas{display:block}
.tetris-help{
  border:1px solid var(--line);
  background:var(--surface-strong);
  border-radius:18px;
  padding:12px;
  font-size:10px;
  line-height:1.55;
  color:var(--muted);
}
@media(max-width:640px){
  .tetris-layout{grid-template-columns:1fr}
  .tetris-side{grid-template-columns:1fr 1fr}
  .tetris-next-grid{width:100%;height:112px}
}


/* ===== ORBIT PLAY 32 ===== */
.games-special{
  margin-top:18px;padding:18px 20px;border-radius:28px;
  display:grid;grid-template-columns:auto 1fr auto;gap:18px;align-items:center;
  overflow:hidden;position:relative
}
.games-special::before{
  content:"";position:absolute;width:260px;height:260px;border-radius:46% 54% 62% 38%;
  right:7%;top:-150px;border:1px solid var(--line);background:rgba(127,127,127,.08);
  animation:iosSafeSpecial 12s ease-in-out infinite alternate
}
@keyframes iosSafeSpecial{to{transform:translate(28px,24px) rotate(18deg)}}
.games-special-icon{
  width:68px;height:68px;border-radius:22px;display:grid;place-items:center;
  background:var(--text);color:var(--bg);font-size:32px;position:relative;z-index:1
}
.games-special-copy{position:relative;z-index:1}
.games-special-copy h2{margin:3px 0 5px;font-size:25px}
.games-special-copy p:last-child{margin:0;color:var(--muted);font-size:12px;line-height:1.5;max-width:650px}
.games-special button{position:relative;z-index:1}
.game-browser-row{display:flex;gap:12px;align-items:center;justify-content:space-between;margin-top:15px;flex-wrap:wrap}
.game-browser-row .mini-search{margin:0;flex:1;min-width:260px}
.game-filter-chips{display:flex;gap:7px;flex-wrap:wrap}
.game-filter-chips .chip{border:1px solid var(--line);background:var(--surface);color:var(--text);padding:9px 12px;border-radius:999px;cursor:pointer}
.game-filter-chips .chip.active{background:var(--text);color:var(--bg)}
.game-card[data-anti="1"]::before{background:rgba(120,120,115,.10)}
.game-card[data-special="1"]{outline:1px solid rgba(120,120,115,.18)}
.game-card[data-special="1"] .game-icon{background:var(--text)!important;color:var(--bg)!important}
.game-card .anti-dot{width:6px;height:6px;border-radius:50%;background:var(--good);display:inline-block;margin-right:4px}

/* shared new games */
.sandbox-shell{display:grid;gap:10px}
.sandbox-toolbar{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.sandbox-tool{border:1px solid var(--line);background:var(--surface-strong);color:var(--text);padding:7px 9px;border-radius:12px;cursor:pointer;font-size:10px}
.sandbox-tool.active{background:var(--text);color:var(--bg)}
.sandbox-toolbar .sandbox-sep{width:1px;height:26px;background:var(--line);margin:0 3px}
.sandbox-brush{display:flex;align-items:center;gap:7px;font-size:10px;color:var(--muted)}
.sandbox-brush input{width:95px}
.sandbox-note{font-size:10px;color:var(--muted);line-height:1.45}
.sandbox-canvas{touch-action:none;cursor:crosshair}
.anti-panel{display:grid;place-items:center;min-height:360px;border:1px solid var(--line);border-radius:24px;background:rgba(127,127,127,.04);overflow:hidden;position:relative}
.bubble-board{display:grid;grid-template-columns:repeat(7,54px);gap:10px;justify-content:center;padding:24px}
.bubble-pop{width:54px;height:54px;border-radius:50%;border:1px solid var(--line);background:radial-gradient(circle at 30% 25%,rgba(255,255,255,.9),rgba(255,255,255,.20) 42%,rgba(90,90,90,.10));box-shadow:inset 0 -8px 18px rgba(30,30,30,.08),0 8px 18px rgba(0,0,0,.06);transition:.16s;cursor:pointer}
.bubble-pop.popped{transform:scale(.68);opacity:.18;box-shadow:none}
.spinner-wrap{display:grid;place-items:center;min-height:360px}
.spinner-disc{width:210px;height:210px;border-radius:50%;position:relative;touch-action:none;cursor:grab}
.spinner-disc::before,.spinner-disc::after{content:"";position:absolute;border-radius:50%;background:var(--surface-strong);border:1px solid var(--line);box-shadow:var(--shadow)}
.spinner-disc::before{width:96px;height:96px;left:57px;top:57px}
.spinner-disc::after{width:34px;height:34px;left:88px;top:88px;background:var(--text)}
.spinner-lobe{position:absolute;width:78px;height:78px;border-radius:50%;background:var(--surface-strong);border:1px solid var(--line);box-shadow:var(--shadow)}
.spinner-lobe.a{left:66px;top:-2px}.spinner-lobe.b{left:8px;top:106px}.spinner-lobe.c{right:8px;top:106px}
.spinner-rpm{text-align:center;font-size:28px;font-weight:850;margin-top:12px}
.connect4{display:grid;grid-template-columns:repeat(7,52px);gap:6px;padding:14px;border-radius:22px;background:#15181c}
.c4-cell{width:52px;height:52px;border-radius:50%;border:0;background:#2b3036;box-shadow:inset 0 4px 12px rgba(0,0,0,.28);cursor:pointer}
.c4-cell.you{background:#ecebe5}.c4-cell.ai{background:#85837d}
.maze-wrap{display:grid;gap:10px;justify-items:center}
.maze-canvas{max-width:100%;touch-action:none}
.whack-grid{display:grid;grid-template-columns:repeat(3,100px);gap:12px;justify-content:center;padding:18px}
.whack-hole{width:100px;height:100px;border:1px solid var(--line);background:var(--surface-strong);border-radius:28px;display:grid;place-items:center;font-size:38px;cursor:pointer;overflow:hidden}
.whack-hole.hot{background:var(--text);color:var(--bg);transform:translateY(-3px)}
.stack-stage{touch-action:none}
.mandala-canvas,.zen-canvas,.orbs-canvas,.rain-canvas,.garden-canvas,.asteroid-canvas,.racer-canvas{touch-action:none}
@media(max-width:720px){
  .games-special{grid-template-columns:auto 1fr}.games-special button{grid-column:1/-1;width:100%}
  .bubble-board{grid-template-columns:repeat(5,48px);gap:8px}.bubble-pop{width:48px;height:48px}
  .connect4{grid-template-columns:repeat(7,39px);gap:4px}.c4-cell{width:39px;height:39px}
  .whack-grid{grid-template-columns:repeat(3,78px)}.whack-hole{width:78px;height:78px}
}


/* ===== Topbar symmetry redesign ===== */
.topbar{
  padding:12px 14px !important;
  border-radius:28px !important;
  gap:14px !important;
  align-items:center !important;
}
.brand{min-height:48px;padding:0 6px 0 2px}
.brand-mark{width:36px !important;height:36px !important;border-radius:50% !important}
.main-nav{display:flex !important;gap:8px !important;margin:auto !important;flex-wrap:wrap;justify-content:center}
.nav-btn{
  min-height:44px !important;
  min-width:116px;
  padding:10px 16px !important;
  border-radius:999px !important;
  border:1px solid var(--line) !important;
  background:rgba(255,255,255,.18) !important;
  display:inline-flex !important;
  align-items:center !important;
  justify-content:center !important;
  gap:8px !important;
  font-weight:760;
  letter-spacing:-.01em;
}
.nav-btn span{
  min-width:24px;height:24px;display:grid;place-items:center;
  padding:0 7px !important;border-radius:999px !important;
  background:var(--text) !important;color:var(--bg) !important;font-size:10px !important
}
.nav-btn:hover,.nav-btn.active{background:var(--surface-strong) !important;box-shadow:0 8px 20px rgba(0,0,0,.08)}
.header-actions{gap:8px !important;align-items:center !important}
.icon-btn,.glass-btn,.splash-launch{min-height:44px !important;border-radius:999px !important}
.icon-btn{width:44px !important;height:44px !important}
.glass-btn,.splash-launch{padding:10px 15px !important}
.splash-launch{justify-content:center}

/* ===== Hero 4 widgets ===== */
.hero-visual{min-height:392px !important;height:auto !important;padding:18px !important;display:block !important}
.hero-widget-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;height:100%}
.hero-info-card{
  position:relative;overflow:hidden;min-height:165px;border:1px solid var(--line);border-radius:30px;
  padding:18px 18px 16px;
  background:linear-gradient(145deg,rgba(255,255,255,.30),rgba(255,255,255,.10)),var(--ios-glass, rgba(255,255,255,.12));
  box-shadow:inset 0 1px 0 rgba(255,255,255,.62),0 18px 42px rgba(35,34,31,.10);
  display:flex;flex-direction:column;justify-content:space-between
}
.hero-info-card::before{
  content:"";position:absolute;width:140px;height:140px;right:-38px;top:-34px;border-radius:42% 58% 54% 46%;
  border:1px solid rgba(255,255,255,.24);background:rgba(255,255,255,.08);opacity:.8
}
.hero-info-card>*{position:relative;z-index:1}
.hero-info-card small{display:block;color:var(--muted);font-size:10px;letter-spacing:.12em;text-transform:uppercase}
.hero-info-card strong{display:block;margin-top:8px;font-size:34px;line-height:1;letter-spacing:-.05em}
.hero-info-card span{display:block;color:var(--muted);font-size:11px;line-height:1.45}
.hero-info-card em{display:block;margin-top:6px;color:var(--text);font-style:normal;font-size:11px;opacity:.82}
.focus-timer-row{margin-top:10px !important}
.focus-timer-row strong{font-size:30px !important}
.focus-timer-row button{min-height:34px;border-radius:999px !important;padding:0 12px !important;background:var(--surface-strong) !important}
.currency-grid{display:grid;gap:10px;margin:10px 0 6px}
.currency-line{display:flex;align-items:center;justify-content:space-between;gap:10px;border:1px solid var(--line);border-radius:16px;padding:10px 12px;background:rgba(255,255,255,.10)}
.currency-line b{font-size:11px;color:var(--muted);letter-spacing:.04em}
.currency-line strong{margin:0 !important;font-size:20px !important}
.time-card strong{font-size:56px !important}
.weather-card strong{font-size:46px !important}
.currency-card::before{transform:rotate(22deg)}
.weather-card::before{transform:rotate(-18deg)}
.focus-card::before{transform:rotate(12deg)}
@media(max-width:980px){.hero-visual{min-height:auto !important}}
@media(max-width:760px){
  .main-nav{display:none !important}
  .hero-widget-grid{grid-template-columns:1fr}
  .hero-info-card{min-height:148px}
  .time-card strong{font-size:44px !important}
}


/* ===== Compact one-line topbar ===== */
.topbar{
  width:min(1240px,calc(100% - 24px)) !important;
  padding:8px 10px !important;
  border-radius:24px !important;
  gap:10px !important;
  flex-wrap:nowrap !important;
}
.brand{
  min-height:40px !important;
  padding:0 3px !important;
  gap:7px !important;
  flex:0 0 auto;
}
.brand-mark{
  width:32px !important;
  height:32px !important;
  font-size:13px !important;
}
.brand em{
  font-size:8px !important;
  padding:3px 6px !important;
}
.main-nav{
  flex:1 1 auto !important;
  min-width:0;
  display:flex !important;
  flex-wrap:nowrap !important;
  justify-content:center !important;
  gap:5px !important;
  margin:0 auto !important;
}
.nav-btn{
  min-width:0 !important;
  min-height:38px !important;
  padding:7px 10px !important;
  border-radius:999px !important;
  font-size:11px !important;
  line-height:1 !important;
  gap:5px !important;
  white-space:nowrap !important;
}
.nav-btn span{
  min-width:20px !important;
  height:20px !important;
  padding:0 5px !important;
  font-size:8px !important;
}
.header-actions{
  flex:0 0 auto;
  gap:5px !important;
  flex-wrap:nowrap !important;
}
.icon-btn{
  width:38px !important;
  height:38px !important;
  min-height:38px !important;
  border-radius:999px !important;
  font-size:13px !important;
}
.glass-btn{
  min-height:38px !important;
  padding:7px 11px !important;
  border-radius:999px !important;
  font-size:11px !important;
  white-space:nowrap !important;
}
@media(max-width:1180px){
  .topbar{
    gap:7px !important;
  }
  .brand em{
    display:none !important;
  }
  .nav-btn{
    padding:7px 8px !important;
    font-size:10px !important;
  }
  .header-actions{
    gap:4px !important;
  }
  .icon-btn{
    width:36px !important;
    height:36px !important;
    min-height:36px !important;
  }
  .glass-btn{
    padding:7px 9px !important;
  }
}
@media(max-width:1040px){
  .main-nav{
    gap:4px !important;
  }
  .nav-btn{
    padding:7px 7px !important;
  }
  .glass-btn#add-site-btn{
    padding-inline:9px !important;
  }
}
@media(max-width:980px){
  .main-nav{
    display:none !important;
  }
}


/* ===== ORBIT TOOLS 29 ===== */
.tools-browser{
  border-radius:26px;
  padding:14px 16px;
  margin-bottom:16px;
}
.tools-browser-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
}
.tools-browser-top .eyebrow{margin-bottom:3px}
.tools-browser-top strong{font-size:16px}
.tools-search{
  min-width:260px;
  max-width:380px;
  flex:1;
  display:flex;
  align-items:center;
  gap:8px;
  border:1px solid var(--line);
  border-radius:999px;
  padding:9px 13px;
  background:var(--surface-strong);
}
.tools-search input{border:0!important;background:transparent!important;padding:0!important;outline:0;width:100%}
.tools-filter{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}
.tool-filter-chip{
  border:1px solid var(--line)!important;
  background:var(--surface)!important;
  color:var(--text)!important;
  border-radius:999px!important;
  padding:8px 11px!important;
  font-size:10px!important;
}
.tool-filter-chip.active{background:var(--text)!important;color:var(--bg)!important}
.tool-card.tool-hidden{display:none!important}
.compact-tool{min-height:230px!important}
.big-output{font-size:25px;font-weight:850;margin:12px 0}
.mini-metric-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}
.mini-metric-grid>div{border:1px solid var(--line);border-radius:14px;padding:10px;background:var(--surface-strong)}
.mini-metric-grid small{display:block;color:var(--muted);font-size:9px;text-transform:uppercase;letter-spacing:.08em}
.mini-metric-grid strong{display:block;margin-top:3px;font-size:18px}
.ratio-row{display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;gap:7px;align-items:center;margin-top:18px}
.ratio-row span{text-align:center;color:var(--muted)}
.ratio-row strong{border:1px solid var(--line);border-radius:12px;padding:10px;text-align:center;background:var(--surface-strong)}
.mini-countdown{font-size:25px!important;margin:16px 0 4px!important}
.contrast-preview{margin:12px 0;border-radius:16px;padding:24px;text-align:center;font-size:25px;font-weight:850;border:1px solid var(--line)}
.hash-output{margin:12px 0;padding:11px;border:1px solid var(--line);border-radius:13px;background:var(--surface-strong);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;line-height:1.45;word-break:break-all;min-height:42px}
.password-output{font-size:13px}
.mini-label{display:flex;gap:9px;align-items:center;font-size:10px;color:var(--muted);margin:12px 0}
.mini-label input{flex:1;padding:0!important}
@media(max-width:720px){
  .tools-browser-top{align-items:flex-start;flex-direction:column}
  .tools-search{min-width:0;max-width:none;width:100%}
  .tools-filter{flex-wrap:nowrap;overflow:auto;padding-bottom:3px}
  .tool-filter-chip{white-space:nowrap}
}


/* ORBIT color customizer */
body.orbit-custom-gradient{background:var(--orbit-custom-gradient)!important;background-attachment:fixed!important}
html[data-theme="dark"] body.orbit-custom-gradient{background:var(--orbit-custom-gradient)!important}
#customize-btn.customized{background:var(--custom-accent,var(--text))!important;color:#fff!important;border-color:transparent!important}
.color-dialog{width:min(540px,calc(100% - 28px))!important;max-height:86vh;overflow:auto}
.color-preview{min-height:150px;border-radius:24px;border:1px solid var(--line);display:flex;flex-direction:column;justify-content:flex-end;padding:18px;margin-bottom:14px;box-shadow:inset 0 1px 0 rgba(255,255,255,.5)}
.color-preview span{font-weight:900;font-size:28px;letter-spacing:-.04em;color:#fff;text-shadow:0 2px 14px rgba(0,0,0,.28)}
.color-preview small{color:rgba(255,255,255,.82);font-size:10px;text-transform:uppercase;letter-spacing:.12em}
.color-presets{display:grid;grid-template-columns:repeat(5,1fr);gap:7px;margin:12px 0 16px}
.color-preset{border:1px solid var(--line);background:var(--surface-strong);border-radius:15px;padding:6px;color:var(--text)}
.color-preset i{display:block;height:40px;border-radius:10px;border:1px solid rgba(255,255,255,.24)}
.color-preset span{display:block;font-size:9px;margin-top:5px;color:var(--muted)}
.color-editor-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.color-editor-grid label{border:1px solid var(--line);border-radius:14px;padding:9px;background:var(--surface-strong)}
.color-editor-grid label span{display:block;color:var(--muted);font-size:9px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:7px}
.color-editor-grid input[type=color]{padding:0;width:100%;height:38px;border:0;background:transparent;cursor:pointer}
.gradient-angle-label{display:block;margin:16px 0 10px}.gradient-angle-label span{display:flex;justify-content:space-between;color:var(--muted);font-size:10px;margin-bottom:7px}.gradient-angle-label input{width:100%}
.gradient-css-row{display:grid;grid-template-columns:1fr auto;gap:8px}.gradient-css-row input{min-width:0;border:1px solid var(--line);background:var(--surface-strong);border-radius:12px;padding:9px 10px;font:9px ui-monospace,monospace}
.color-dialog-actions{display:grid;grid-template-columns:1fr 1.4fr;gap:8px;margin-top:12px}.color-dialog-actions button{min-height:42px}
@media(max-width:600px){.color-presets{grid-template-columns:repeat(3,1fr)}.color-editor-grid{grid-template-columns:repeat(2,1fr)}}


/* ===== Ready ORBIT customizations ===== */
:root{
  --orbit-float-a:rgba(255,255,255,.76);
  --orbit-float-b:rgba(172,172,164,.20);
  --orbit-float-c:rgba(90,90,86,.13);
  --orbit-orb-a:rgba(145,145,138,.10);
  --orbit-orb-b:rgba(120,120,114,.08);
  --orbit-orb-c:rgba(95,95,90,.07);
  --orbit-ring:rgba(48,48,44,.14);
  --orbit-pill:rgba(125,125,118,.10);
}
body.orbit-ready-water{
  --orbit-float-a:rgba(255,255,255,.86);
  --orbit-float-b:rgba(110,196,220,.24);
  --orbit-float-c:rgba(56,143,178,.14);
  --orbit-orb-a:rgba(100,207,234,.22);
  --orbit-orb-b:rgba(121,184,228,.17);
  --orbit-orb-c:rgba(65,155,201,.15);
  --orbit-ring:rgba(80,164,196,.22);
  --orbit-pill:rgba(105,194,220,.16);
}
body.orbit-ready-space{
  --orbit-float-a:rgba(232,234,255,.64);
  --orbit-float-b:rgba(86,91,154,.30);
  --orbit-float-c:rgba(37,47,95,.24);
  --orbit-orb-a:rgba(116,105,202,.30);
  --orbit-orb-b:rgba(71,91,174,.25);
  --orbit-orb-c:rgba(76,59,135,.23);
  --orbit-ring:rgba(74,78,151,.34);
  --orbit-pill:rgba(83,78,161,.25);
}
body.orbit-ready-aurora{
  --orbit-float-a:rgba(255,255,255,.80);
  --orbit-float-b:rgba(102,206,190,.24);
  --orbit-float-c:rgba(145,121,201,.16);
  --orbit-orb-a:rgba(101,218,196,.24);
  --orbit-orb-b:rgba(120,193,223,.19);
  --orbit-orb-c:rgba(161,128,218,.18);
  --orbit-ring:rgba(104,174,188,.26);
  --orbit-pill:rgba(136,135,205,.17);
}
.ios-shape::before{
  background:linear-gradient(145deg,var(--orbit-float-a),var(--orbit-float-b) 42%,var(--orbit-float-c) 72%,rgba(255,255,255,.42)) !important;
}
.orb-a{background:radial-gradient(circle at 35% 35%,rgba(255,255,255,.84),var(--orbit-orb-a) 60%,transparent 70%) !important}
.orb-b{background:radial-gradient(circle at 35% 35%,rgba(255,255,255,.58),var(--orbit-orb-b) 60%,transparent 70%) !important}
.orb-c{background:radial-gradient(circle at 35% 35%,rgba(255,255,255,.52),var(--orbit-orb-c) 60%,transparent 70%) !important}
.ios-ring{border-color:var(--orbit-ring) !important}
.ios-glass-pill{background:linear-gradient(145deg,rgba(255,255,255,.60),var(--orbit-pill)) !important}

.ready-theme-title,.custom-gradient-label{display:flex;justify-content:space-between;align-items:end;gap:12px;margin:12px 0 8px}
.ready-theme-title span,.custom-gradient-label span{font-size:10px;font-weight:850;letter-spacing:.08em;text-transform:uppercase}
.ready-theme-title small,.custom-gradient-label small{font-size:9px;color:var(--muted)}
.ready-themes{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:18px}
.ready-theme-card{
  border:1px solid var(--line)!important;
  background:var(--surface-strong)!important;
  color:var(--text)!important;
  border-radius:18px!important;
  padding:7px!important;
  text-align:left;
  min-width:0;
}
.ready-theme-card.active{
  box-shadow:0 0 0 2px var(--text),0 10px 24px rgba(0,0,0,.08)!important;
}
.ready-theme-swatch{
  position:relative;display:block;height:72px;border-radius:13px;overflow:hidden;border:1px solid rgba(255,255,255,.35)
}
.theme-water-swatch{background:linear-gradient(145deg,#effcff,#b8e6f2 50%,#72b8d1)}
.theme-space-swatch{background:linear-gradient(145deg,#c7cae2,#7d84ad 50%,#3c456f)}
.theme-aurora-swatch{background:linear-gradient(145deg,#e8fff9,#9edfd4 48%,#aaa0dc)}
.ready-theme-swatch b{position:absolute;border-radius:50%;border:1px solid rgba(255,255,255,.58);background:rgba(255,255,255,.22);box-shadow:inset 0 1px 0 rgba(255,255,255,.54)}
.ready-theme-swatch b:nth-child(1){width:43px;height:43px;left:-8px;top:13px}
.ready-theme-swatch b:nth-child(2){width:31px;height:31px;right:8px;top:-7px}
.ready-theme-swatch b:nth-child(3){width:20px;height:20px;right:20px;bottom:7px}
.ready-theme-card>span{display:block;padding:7px 4px 3px}
.ready-theme-card strong{display:block;font-size:10px}
.ready-theme-card small{display:block;color:var(--muted);font-size:8px;line-height:1.35;margin-top:2px}
@media(max-width:660px){
  .ready-themes{grid-template-columns:1fr}
  .ready-theme-swatch{height:54px}
  .ready-theme-title,.custom-gradient-label{align-items:flex-start;flex-direction:column;gap:3px}
}


/* ===== ORBIT PET: Miroslav ===== */
.hero-visual{overflow:visible !important}
.hero-widget-grid{position:relative;z-index:2}
.hero-info-card{position:relative;z-index:2}
.miroslav-stage{
  position:absolute;
  top:-48px;
  right:86px;
  width:170px;
  height:88px;
  pointer-events:none;
  z-index:1;
}
.miroslav-name{display:none !important}
.miroslav-pet{
  position:absolute;
  left:50%;
  bottom:0;
  width:124px;
  height:84px;
  transform:translateX(-50%);
  animation:miroslavBob 4.8s ease-in-out infinite;
  filter:drop-shadow(0 10px 18px rgba(61,60,55,.10));
  z-index:1;
}
.miroslav-head,.miroslav-body,.miroslav-arm,.miroslav-leg{
  position:absolute;
  border:1px solid rgba(255,255,255,.52);
  background:
    linear-gradient(160deg,rgba(255,255,255,.72),rgba(255,255,255,.24) 38%,rgba(175,182,194,.18) 68%,rgba(255,255,255,.46));
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.82),
    inset -10px -14px 22px rgba(127,131,143,.08),
    0 8px 26px rgba(70,69,64,.10);
  backdrop-filter:blur(18px) saturate(1.2);
}
.miroslav-head{
  width:42px;
  height:42px;
  left:41px;
  top:0;
  border-radius:50%;
  z-index:8;
}
.miroslav-highlight{
  position:absolute;
  width:13px;
  height:13px;
  top:7px;
  left:9px;
  border-radius:50%;
  background:radial-gradient(circle,rgba(255,255,255,.92),rgba(255,255,255,.24) 72%,transparent 74%);
  filter:blur(.2px);
}
.miroslav-face{
  position:absolute;
  inset:0;
}
.miroslav-face::before{
  content:"";
  position:absolute;
  inset:0;
  background:
    radial-gradient(circle at 11px 28px,rgba(255,175,175,.32) 0 4px,transparent 4.2px),
    radial-gradient(circle at 31px 28px,rgba(255,175,175,.32) 0 4px,transparent 4.2px);
  opacity:.95;
}
.miroslav-eye{
  position:absolute;
  width:7px;
  height:9px;
  top:16px;
  border-radius:10px;
  background:rgba(40,44,52,.92);
  box-shadow:0 0 0 1px rgba(255,255,255,.12),0 1px 6px rgba(0,0,0,.18);
  animation:miroslavBlink 5.6s infinite;
}
.eye-left{left:10px}
.eye-right{right:10px}
.miroslav-mouth{
  position:absolute;
  width:13px;
  height:7px;
  left:50%;
  bottom:8px;
  transform:translateX(-50%);
  border-radius:0 0 14px 14px;
  border:2px solid rgba(48,52,61,.62);
  border-top:0;
  opacity:.92;
}
.miroslav-body{
  width:72px;
  height:22px;
  left:26px;
  top:28px;
  border-radius:38px 38px 0 0;
  border-bottom:0;
  z-index:6;
}
.miroslav-arm{
  width:12px;
  height:23px;
  top:30px;
  border-radius:16px;
  z-index:7;
}
.arm-left{
  left:18px;
  transform:rotate(42deg);
}
.arm-right{
  right:18px;
  transform:rotate(-42deg);
}
.arm-left::after,.arm-right::after{
  content:"";
  position:absolute;
  width:12px;
  height:12px;
  bottom:-4px;
  left:0;
  border-radius:50%;
  border:1px solid rgba(255,255,255,.52);
  background:linear-gradient(160deg,rgba(255,255,255,.78),rgba(255,255,255,.30) 40%,rgba(175,182,194,.16) 72%,rgba(255,255,255,.44));
  box-shadow:inset 0 1px 0 rgba(255,255,255,.82),0 4px 10px rgba(70,69,64,.10);
}
.miroslav-leg{display:none}
.leg-left{left:25px}
.leg-right{right:25px}
.miroslav-pet::before{display:none}
.miroslav-stage::after{display:none}
html[data-theme="dark"] .miroslav-stage::after{display:none}
html[data-theme="dark"] .miroslav-name{
  border-color:rgba(255,255,255,.14);
  background:linear-gradient(145deg,rgba(255,255,255,.10),rgba(255,255,255,.05));
  color:rgba(255,255,255,.92);
}
@keyframes miroslavBob{
  0%,100%{transform:translateX(-50%) translateY(0)}
  50%{transform:translateX(-50%) translateY(-5px)}
}
@keyframes miroslavBlink{
  0%,45%,47%,100%{transform:scaleY(1)}
  46%{transform:scaleY(.18)}
}
@media(max-width:980px){
  .miroslav-stage{
    right:66px;
    top:-38px;
    transform:scale(.9);
    transform-origin:top right;
  }
}
@media(max-width:760px){
  .miroslav-stage{
    right:0;
    top:-26px;
    transform:scale(.72);
    transform-origin:top right;
  }
  .miroslav-name{display:none !important}
}


/* ===== Miroslav speech ===== */
.miroslav-speech{
  position:absolute;
  top:-62px;
  right:192px;
  z-index:12;
  max-width:220px;
  min-width:132px;
  padding:11px 14px;
  border-radius:18px 18px 6px 18px;
  border:1px solid rgba(255,255,255,.52);
  background:linear-gradient(145deg,rgba(255,255,255,.84),rgba(255,255,255,.42));
  backdrop-filter:blur(22px) saturate(1.16);
  box-shadow:0 14px 36px rgba(38,38,34,.13),inset 0 1px 0 rgba(255,255,255,.84);
  color:var(--text);
  font-size:12px;
  font-weight:750;
  line-height:1.35;
  letter-spacing:-.01em;
  opacity:0;
  transform:translateY(7px) scale(.96);
  transform-origin:bottom right;
  transition:opacity .22s ease,transform .28s cubic-bezier(.2,.8,.2,1);
  pointer-events:none;
}
.miroslav-speech::after{
  content:"";
  position:absolute;
  right:14px;
  bottom:-8px;
  width:16px;
  height:16px;
  background:rgba(255,255,255,.60);
  border-right:1px solid rgba(255,255,255,.46);
  border-bottom:1px solid rgba(255,255,255,.46);
  transform:rotate(45deg);
  border-radius:0 0 4px 0;
}
.miroslav-speech.show{
  opacity:1;
  transform:translateY(0) scale(1);
}
html[data-theme="dark"] .miroslav-speech{
  background:linear-gradient(145deg,rgba(47,47,50,.88),rgba(28,28,31,.72));
  border-color:rgba(255,255,255,.14);
  color:#f4f3ef;
}
html[data-theme="dark"] .miroslav-speech::after{
  background:rgba(35,35,38,.84);
  border-color:rgba(255,255,255,.10);
}
@media(max-width:980px){
  .miroslav-speech{right:154px;top:-55px}
}
@media(max-width:760px){
  .miroslav-speech{
    right:76px;
    top:-42px;
    max-width:180px;
    min-width:118px;
    padding:9px 11px;
    font-size:10px;
  }
}


/* ===== ORBIT micro definitions ===== */
.orbit-hover-tip{
  position:fixed;
  left:0;
  top:0;
  z-index:1200;
  max-width:220px;
  padding:8px 10px;
  border-radius:12px;
  border:1px solid rgba(255,255,255,.48);
  background:linear-gradient(145deg,rgba(255,255,255,.88),rgba(255,255,255,.56));
  backdrop-filter:blur(18px) saturate(1.15);
  box-shadow:0 12px 34px rgba(30,30,28,.14), inset 0 1px 0 rgba(255,255,255,.84);
  color:var(--text);
  font-size:11px;
  font-weight:650;
  line-height:1.35;
  letter-spacing:-.01em;
  opacity:0;
  transform:translateY(4px) scale(.98);
  pointer-events:none;
  transition:opacity .15s ease, transform .18s ease;
}
.orbit-hover-tip.show{
  opacity:1;
  transform:translateY(0) scale(1);
}
html[data-theme="dark"] .orbit-hover-tip{
  border-color:rgba(255,255,255,.14);
  background:linear-gradient(145deg,rgba(42,42,45,.92),rgba(25,25,28,.78));
  color:#f2f0ea;
}
@media(max-width:760px){
  .orbit-hover-tip{display:none !important}
}


/* Splash AI обновление is always available */
#ai-status-dot.online,.ai-local-badge i{background:var(--good)!important;box-shadow:0 0 0 4px rgba(93,151,109,.12)}
#ai-install[disabled]{opacity:.8;cursor:default}


/* Splash 2.0 AI Core loading panel */
.splash-core-loader{
  display:none;
  margin:12px 0;
  padding:14px;
  border-radius:22px;
  border:1px solid var(--line);
  background:var(--surface-strong);
  backdrop-filter:blur(18px);
}
.splash-core-loader.active{display:block}
.splash-core-loader .core-title{
  font-weight:800;
  margin-bottom:6px;
}
.splash-core-progress{
  height:8px;
  border-radius:99px;
  overflow:hidden;
  background:rgba(120,120,120,.16);
  margin-top:10px;
}
.splash-core-progress i{
  display:block;
  width:8%;
  height:100%;
  border-radius:99px;
  background:linear-gradient(90deg,#888,#ddd);
  transition:width .4s ease;
}

.splash-diagnostic{
  margin:12px 0;
  padding:12px 14px;
  border-radius:18px;
  border:1px solid var(--line);
  background:var(--surface);
  font-size:12px;
  line-height:1.5;
}
.splash-diagnostic strong{display:block;margin-bottom:4px}

.splash-ai-retry{
margin-top:8px;padding:8px 14px;border-radius:999px;border:1px solid var(--line);
background:var(--surface-strong);cursor:pointer;color:inherit;
}

.ai-temporarily-closed{
  margin:16px auto;
  max-width:900px;
  padding:18px 22px;
  border-radius:24px;
  border:1px solid var(--line);
  background:var(--surface-strong);
  text-align:center;
  backdrop-filter:blur(18px);
}
.ai-temporarily-closed strong{
  display:block;
  font-size:18px;
  margin-bottom:8px;
}

/* Section cards on home instead of site cards */
#categories{display:none !important;}

.section-card{
  position:relative;
  min-height:168px;
  border-radius:20px;
  padding:16px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  text-decoration:none;
  color:inherit;
  transition:.25s;
  border:1px solid var(--line);
  background:var(--surface);
  overflow:hidden;
}
.section-card:hover{
  transform:translateY(-4px);
  background:var(--surface-strong);
  box-shadow:0 16px 34px rgba(52,63,91,.12);
}
.section-card.open{
  grid-column:span 2;
  min-height:320px;
}
.section-card-top{
  display:flex;
  justify-content:space-between;
  gap:8px;
  align-items:flex-start;
}
.section-icon{
  width:38px;height:38px;border-radius:12px;display:grid;place-items:center;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  color:#fff;font-weight:800;font-size:18px;
}
.section-count{
  font-size:12px;
  color:var(--muted);
  padding:7px 10px;
  border-radius:999px;
  border:1px solid var(--line);
  background:rgba(255,255,255,.04);
}
.section-card h3{font-size:18px;margin:14px 0 4px}
.section-card p{font-size:12px;color:var(--muted);margin:0}
.section-mini-grid{
  display:none;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:10px;
  margin-top:16px;
}
.section-card.open .section-mini-grid{display:grid}
.section-mini-site{
  border:1px solid var(--line);
  background:rgba(255,255,255,.06);
  border-radius:16px;
  padding:10px 12px;
  display:flex;
  align-items:center;
  gap:10px;
  cursor:pointer;
  min-height:54px;
  text-align:left;
}
.section-mini-site:hover{
  background:rgba(255,255,255,.12);
}
.section-mini-site b{
  display:block;
  font-size:13px;
  line-height:1.15;
}
.section-mini-site small{
  display:block;
  font-size:10px;
  color:var(--muted);
  line-height:1.2;
  margin-top:2px;
}
.section-mini-site .mini-icon{
  width:28px;height:28px;border-radius:10px;
  display:grid;place-items:center;
  background:rgba(255,255,255,.18);
  font-size:11px;font-weight:800;
  flex:0 0 auto;
}
.section-meta{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:12px;
}
.section-hint{
  font-size:11px;
  color:var(--muted);
}
.section-openall{
  border:1px solid var(--line);
  background:transparent;
  padding:8px 12px;
  border-radius:12px;
  font-size:12px;
}
@media(max-width:650px){
  .section-card.open{grid-column:span 2;min-height:360px}
  .section-mini-grid{grid-template-columns:1fr}
}


/* Work section integrated tools */
.section-card[data-section="Работа"].open{
  min-height:460px;
}
.work-lab{
  display:none;
  margin-top:16px;
  border:1px solid var(--line);
  border-radius:18px;
  background:rgba(255,255,255,.04);
  padding:14px;
}
.section-card.open[data-section="Работа"] .work-lab{
  display:block;
}
.work-lab-grid{
  display:grid;
  grid-template-columns:1.15fr .95fr;
  gap:12px;
}
.work-editor,.work-tools-panel,.work-output{
  border:1px solid var(--line);
  border-radius:16px;
  background:rgba(255,255,255,.05);
  padding:12px;
}
.work-editor h4,.work-tools-panel h4,.work-output h4{
  margin:0 0 10px;
  font-size:14px;
}
.work-textarea{
  width:100%;
  min-height:124px;
  resize:vertical;
  border-radius:14px;
  border:1px solid var(--line);
  background:rgba(0,0,0,.08);
  color:inherit;
  padding:12px;
  outline:none;
  font:inherit;
}
.work-stats{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin-top:10px;
}
.work-stat{
  font-size:11px;
  color:var(--muted);
  padding:6px 10px;
  border-radius:999px;
  border:1px solid var(--line);
}
.work-tools-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:8px;
}
.work-tool-btn,.work-copy-btn{
  border:1px solid var(--line);
  background:rgba(255,255,255,.06);
  color:inherit;
  padding:10px 12px;
  border-radius:14px;
  font-size:12px;
  text-align:left;
  cursor:pointer;
  transition:.2s ease;
}
.work-tool-btn:hover,.work-copy-btn:hover{
  transform:translateY(-2px);
  background:rgba(255,255,255,.12);
}
.work-tool-btn b{
  display:block;
  font-size:12px;
}
.work-tool-btn span{
  display:block;
  font-size:10px;
  color:var(--muted);
  margin-top:3px;
}
.work-output{
  margin-top:12px;
}
.work-output-box{
  min-height:110px;
  white-space:pre-wrap;
  font-size:13px;
  line-height:1.45;
  color:var(--text);
}
.work-output-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}
.work-hint{
  font-size:11px;
  color:var(--muted);
  margin-top:10px;
}
@media(max-width:900px){
  .work-lab-grid{
    grid-template-columns:1fr;
  }
  .work-tools-grid{
    grid-template-columns:1fr 1fr;
  }
}
@media(max-width:650px){
  .work-tools-grid{
    grid-template-columns:1fr;
  }
}


/* Presentation editor + study/dev labs */
.section-card[data-section="Работа"].open{min-height:920px}
.section-card[data-section="Учёба"].open,
.section-card[data-section="Разработка"].open{min-height:690px}

.presentation-editor{
  margin-top:16px;
  border:1px solid var(--line);
  border-radius:18px;
  background:rgba(255,255,255,.04);
  padding:14px;
}
.presentation-layout{
  display:grid;
  grid-template-columns:1.12fr .88fr;
  gap:12px;
}
.slide-toolbar,.slide-editor-box,.slide-preview-box,
.study-lab,.dev-lab,.lab-panel,.lab-output{
  border:1px solid var(--line);
  border-radius:16px;
  background:rgba(255,255,255,.05);
  padding:12px;
}
.slide-toolbar-top,.slide-preview-top,.lab-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin-bottom:10px;
}
.slide-tabs{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin-top:10px;
}
.slide-tab{
  border:1px solid var(--line);
  background:rgba(255,255,255,.06);
  color:inherit;
  border-radius:12px;
  padding:8px 10px;
  font-size:12px;
  cursor:pointer;
}
.slide-tab.active{
  background:rgba(255,255,255,.18);
}
.inline-btn{
  border:1px solid var(--line);
  background:rgba(255,255,255,.06);
  color:inherit;
  border-radius:12px;
  padding:8px 10px;
  font-size:12px;
  cursor:pointer;
}
.inline-btn:hover{transform:translateY(-1px);background:rgba(255,255,255,.12)}
.slide-editor-grid{
  display:grid;
  gap:10px;
}
.slide-input,.slide-textarea,.lab-textarea{
  width:100%;
  border-radius:14px;
  border:1px solid var(--line);
  background:rgba(0,0,0,.08);
  color:inherit;
  padding:12px;
  outline:none;
  font:inherit;
}
.slide-textarea,.lab-textarea{
  min-height:120px;
  resize:vertical;
}
.slide-preview{
  min-height:270px;
  border-radius:22px;
  padding:22px;
  border:1px solid rgba(255,255,255,.12);
  background:
    radial-gradient(circle at 20% 18%, rgba(255,255,255,.18), transparent 26%),
    linear-gradient(160deg, rgba(255,255,255,.10), rgba(255,255,255,.03));
  box-shadow:inset 0 1px 0 rgba(255,255,255,.12);
}
.slide-preview-label{
  font-size:11px;
  color:var(--muted);
  margin-bottom:10px;
}
.slide-preview-title{
  font-size:28px;
  font-weight:850;
  line-height:1.1;
  margin-bottom:14px;
}
.slide-preview-list{
  margin:0;
  padding-left:18px;
  display:grid;
  gap:8px;
  font-size:14px;
  line-height:1.35;
}
.tool-grid-2{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:8px;
}
.lab-wrap{
  display:none;
  margin-top:16px;
}
.section-card.open[data-section="Учёба"] .study-wrap,
.section-card.open[data-section="Разработка"] .dev-wrap{
  display:block;
}
.lab-output-box{
  min-height:120px;
  white-space:pre-wrap;
  font-size:13px;
  line-height:1.45;
}
.lab-subhint{
  font-size:11px;
  color:var(--muted);
  margin-top:8px;
}
@media(max-width:980px){
  .presentation-layout{grid-template-columns:1fr}
}
@media(max-width:700px){
  .tool-grid-2{grid-template-columns:1fr}
}


/* ORBIT project save controls */
.project-controls{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin-top:12px;
}
.project-name{
  flex:1;
  min-width:180px;
  border:1px solid var(--line);
  background:rgba(255,255,255,.05);
  color:inherit;
  border-radius:12px;
  padding:10px 12px;
}
.project-list{
  margin-top:12px;
  display:grid;
  gap:8px;
}
.project-item{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:8px;
  padding:10px;
  border-radius:12px;
  border:1px solid var(--line);
  background:rgba(255,255,255,.04);
}
.project-item button{
  border:1px solid var(--line);
  background:rgba(255,255,255,.08);
  color:inherit;
  border-radius:10px;
  padding:6px 10px;
  cursor:pointer;
}

/* ORBIT STYLE STUDIO */
.style-studio{
  margin-top:18px;
  border:1px solid var(--line);
  border-radius:24px;
  padding:16px;
  background:rgba(255,255,255,.04);
}
.style-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:12px;
}
.style-option{
  border:1px solid var(--line);
  border-radius:18px;
  padding:14px;
  background:rgba(255,255,255,.06);
  cursor:pointer;
  transition:.25s;
}
.style-option:hover,.style-option.active{
  transform:translateY(-3px);
  background:rgba(255,255,255,.14);
}
.style-preview{
  height:42px;
  border-radius:14px;
  margin-bottom:10px;
}
.style-switches{
  display:grid;
  gap:10px;
  margin-top:14px;
}
.style-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:12px;
  border-radius:16px;
  border:1px solid var(--line);
}
@media(max-width:800px){
  .style-grid{grid-template-columns:1fr}
}


/* ===== ORBIT Calendar redesign ===== */
#page-calendar .subhero{padding:56px 0 34px}
#page-calendar .subhero h1{font-size:clamp(40px,6vw,72px);margin-bottom:8px}
#page-calendar .subhero>p{max-width:760px;color:var(--muted);font-size:18px}
.calendar-overview{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:24px 0 18px}
.calendar-metric{padding:16px 18px;border-radius:22px;display:flex;align-items:center;gap:14px;background:linear-gradient(180deg,color-mix(in srgb,var(--surface-strong) 96%,transparent),color-mix(in srgb,var(--surface) 96%,transparent));border:1px solid var(--line);box-shadow:var(--shadow)}
.calendar-metric .metric-icon{width:44px;height:44px;border-radius:15px;display:grid;place-items:center;background:color-mix(in srgb,var(--text) 8%,transparent);font-size:20px}
.calendar-metric strong{display:block;font-size:14px;letter-spacing:-.02em}
.calendar-metric span{display:block;font-size:12px;color:var(--muted);margin-top:2px}
.calendar-layout{display:grid;grid-template-columns:1.05fr .95fr;gap:18px;align-items:start}
.calendar-stack{display:grid;gap:18px}
.calendar-card{padding:22px;border-radius:30px;background:linear-gradient(180deg,color-mix(in srgb,var(--surface-strong) 96%,transparent),color-mix(in srgb,var(--surface) 96%,transparent));border:1px solid var(--line);box-shadow:var(--shadow)}
.calendar-card h2{margin:0 0 14px;font-size:20px;letter-spacing:-.03em}
.calendar-card p.small{margin:0 0 14px;color:var(--muted);font-size:13px}
.calendar-form-grid{display:grid;grid-template-columns:190px 1fr auto;gap:10px;align-items:center}
.calendar-input,.calendar-textarea{width:100%;border:1px solid var(--line);background:color-mix(in srgb,var(--surface-strong) 94%,transparent);color:var(--text);border-radius:16px;padding:14px 15px;outline:none;box-shadow:inset 0 1px 0 rgba(255,255,255,.05)}
.calendar-input:focus,.calendar-textarea:focus{border-color:color-mix(in srgb,var(--text) 28%,var(--line));box-shadow:0 0 0 4px color-mix(in srgb,var(--text) 7%,transparent)}
.calendar-textarea{min-height:180px;resize:vertical}
.calendar-btn,.calendar-chip-btn{border:1px solid var(--line);background:linear-gradient(180deg,color-mix(in srgb,var(--surface-strong) 98%,transparent),color-mix(in srgb,var(--surface) 95%,transparent));color:var(--text);border-radius:16px;padding:13px 16px;font-weight:700;transition:.18s}
.calendar-btn:hover,.calendar-chip-btn:hover{transform:translateY(-1px);box-shadow:0 10px 22px rgba(0,0,0,.10)}
.calendar-chip-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.calendar-chip-btn{padding:9px 12px;border-radius:999px;font-size:12px}
.calendar-list{display:grid;gap:10px;margin-top:14px}
.calendar-item{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;padding:13px 14px;border-radius:18px;background:color-mix(in srgb,var(--surface-strong) 76%,transparent);border:1px solid var(--line)}
.calendar-item .item-icon{width:36px;height:36px;border-radius:12px;display:grid;place-items:center;background:color-mix(in srgb,var(--text) 8%,transparent)}
.calendar-item strong{display:block;font-size:14px;letter-spacing:-.02em}
.calendar-item span{display:block;font-size:12px;color:var(--muted);margin-top:2px}
.calendar-item button{border:1px solid var(--line);background:transparent;color:var(--muted);border-radius:12px;padding:7px 9px}
.calendar-item button:hover{color:var(--text);background:color-mix(in srgb,var(--text) 6%,transparent)}
.calendar-agenda{display:grid;gap:10px}
.calendar-empty{padding:18px;border-radius:18px;border:1px dashed var(--line);color:var(--muted);font-size:13px;text-align:center;background:color-mix(in srgb,var(--surface) 70%,transparent)}
.calendar-hero-note{display:flex;align-items:center;gap:10px;margin-top:12px;color:var(--muted);font-size:13px}
.calendar-dot{width:9px;height:9px;border-radius:50%;background:var(--text);opacity:.7}
@media(max-width:980px){
  .calendar-layout{grid-template-columns:1fr}
  .calendar-overview{grid-template-columns:1fr}
}
@media(max-width:720px){
  .calendar-form-grid{grid-template-columns:1fr}
  #page-calendar .subhero h1{font-size:42px}
}


.books-source-note{margin:0 0 18px;padding:13px 15px;border-radius:17px;display:flex;gap:12px;align-items:flex-start}
.books-source-note strong{font-size:11px;white-space:nowrap}
.books-source-note span{font-size:10px;color:var(--muted);line-height:1.45}
.books-filters{overflow:auto;flex-wrap:nowrap;scrollbar-width:none;padding-bottom:2px}
.books-filters::-webkit-scrollbar{display:none}
.books-filter{white-space:nowrap}


.books-reading-note{margin:0 0 18px;padding:14px 16px;border-radius:18px;display:flex;gap:12px;align-items:flex-start}
.books-reading-note strong{font-size:11px;white-space:nowrap}
.books-reading-note span{font-size:10px;color:var(--muted);line-height:1.5}
@media(max-width:650px){.books-reading-note{flex-direction:column}}
</style>

<style>
.miroslav-interactive-card{
  display:flex;
  gap:22px;
  align-items:center;
  padding:26px;
  border-radius:32px;
  border:1px solid rgba(255,255,255,.12);
  background:linear-gradient(145deg,rgba(255,255,255,.08),rgba(255,255,255,.03));
  box-shadow:0 20px 60px rgba(0,0,0,.18);
}
.miroslav-avatar{
  width:130px;height:130px;border-radius:40px;
  display:grid;place-items:center;
  font-size:64px;
  background:rgba(255,255,255,.08);
  animation:miroFloat 3s ease-in-out infinite;
}
@keyframes miroFloat{
  50%{transform:translateY(-8px)}
}
.miroslav-message{
  flex:1;
}
.miroslav-message h3{margin:0 0 8px;font-size:26px}
.miroslav-message p{color:var(--muted)}
.miroslav-actions{
 display:flex;gap:10px;flex-wrap:wrap;margin-top:14px;
}
.miroslav-btn{
 border:1px solid rgba(255,255,255,.15);
 background:rgba(255,255,255,.06);
 color:inherit;padding:10px 15px;border-radius:999px;
 cursor:pointer;
}
.miroslav-level{
 margin-top:18px;
 padding:16px;
 border-radius:22px;
 background:rgba(255,255,255,.05);
}
@media(max-width:700px){
 .miroslav-interactive-card{flex-direction:column;text-align:center}
}
</style>



<style>
/* ===== ORBIT BOOKS ===== */
#page-books{padding-bottom:70px}
.books-hero{padding:62px 0 24px}
.books-hero-row{display:flex;align-items:flex-end;justify-content:space-between;gap:22px}
.books-hero h1{font-size:clamp(44px,7vw,86px);line-height:.94;letter-spacing:-.06em;margin:0}
.books-hero p{max-width:720px;color:var(--muted);font-size:16px;line-height:1.55}
.books-add-btn{white-space:nowrap;border:1px solid var(--line);background:var(--text);color:var(--bg);border-radius:16px;padding:12px 16px;font-weight:800}
.books-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:22px 0}
.books-stat{border-radius:20px;padding:16px 18px;display:flex;flex-direction:column;gap:3px}
.books-stat strong{font-size:25px;letter-spacing:-.04em}
.books-stat span{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
.books-toolbar{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center;margin:8px 0 20px}
.books-search{display:flex;align-items:center;gap:10px;border:1px solid var(--line);background:var(--surface);border-radius:18px;padding:11px 14px}
.books-search input{width:100%;border:0;background:transparent;outline:0}
.books-filters{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}
.books-filter{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:9px 12px;font-size:11px}
.books-filter.active{background:var(--text);color:var(--bg)}
.books-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.book-card{min-height:300px;border-radius:26px;padding:18px;display:flex;flex-direction:column;position:relative;overflow:hidden;transition:.22s}
.book-card:hover{transform:translateY(-4px);background:var(--surface-strong)}
.book-cover{height:132px;border-radius:18px;border:1px solid var(--line);display:flex;align-items:end;padding:14px;background:
  radial-gradient(circle at 78% 20%,color-mix(in srgb,var(--text) 9%,transparent),transparent 32%),
  linear-gradient(145deg,color-mix(in srgb,var(--surface-strong) 96%,transparent),color-mix(in srgb,var(--surface) 92%,transparent));
  position:relative;overflow:hidden}
.book-cover::before{content:"";position:absolute;width:100px;height:100px;border:1px solid var(--line);border-radius:50%;right:-38px;top:-34px}
.book-cover .book-letter{font-size:44px;font-weight:900;letter-spacing:-.08em;position:relative}
.book-card h3{margin:15px 0 4px;font-size:17px;letter-spacing:-.02em}
.book-author{font-size:11px;color:var(--muted);margin-bottom:10px}
.book-summary{font-size:11px;color:var(--muted);line-height:1.5;margin:0 0 14px;display:-webkit-box;-webkit-line-clamp:5;-webkit-box-orient:vertical;overflow:hidden}
.book-badges{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:12px}
.book-badge{font-size:8px;border:1px solid var(--line);border-radius:999px;padding:4px 7px;color:var(--muted);background:var(--surface-strong)}
.book-actions{margin-top:auto;display:grid;grid-template-columns:1fr 1fr;gap:7px}
.book-actions button,.book-actions a{border:1px solid var(--line);border-radius:12px;padding:9px 10px;background:var(--surface-strong);color:var(--text);text-decoration:none;font-size:10px;text-align:center}
.book-actions .primary{background:var(--text);color:var(--bg);border-color:var(--text)}
.book-card-tools{position:absolute;right:12px;top:12px;display:flex;gap:5px;z-index:3}
.book-icon-btn{width:32px;height:32px;border-radius:11px;border:1px solid var(--line);background:var(--surface-strong);display:grid;place-items:center}
.book-icon-btn.active{background:var(--text);color:var(--bg)}
.books-empty{grid-column:1/-1;padding:55px;border:1px dashed var(--line);border-radius:28px;text-align:center;color:var(--muted)}
.book-modal-backdrop{position:fixed;inset:0;background:rgba(5,5,5,.48);z-index:160;backdrop-filter:blur(5px)}
.book-modal{position:fixed;z-index:170;left:50%;top:50%;transform:translate(-50%,-50%);width:min(720px,calc(100% - 30px));max-height:88vh;overflow:auto;border-radius:30px;padding:22px}
.book-modal-head{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;margin-bottom:18px}
.book-modal-head h2{margin:0;font-size:30px;letter-spacing:-.04em}
.book-modal-head button{width:36px;height:36px;border-radius:50%;border:1px solid var(--line);background:var(--surface-strong)}
.book-form{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.book-form label{display:flex;flex-direction:column;gap:6px;font-size:10px;color:var(--muted)}
.book-form label.full{grid-column:1/-1}
.book-form input,.book-form select,.book-form textarea{border:1px solid var(--line);background:var(--surface-strong);border-radius:13px;padding:11px;outline:0;color:var(--text)}
.book-form textarea{min-height:100px;resize:vertical}
.book-form .book-content-field{min-height:180px}
.book-form-actions{grid-column:1/-1;display:flex;justify-content:flex-end;gap:8px;margin-top:3px}
.book-form-actions button{border:1px solid var(--line);border-radius:13px;padding:10px 14px;background:var(--surface-strong)}
.book-form-actions .primary{background:var(--text);color:var(--bg)}
.book-file-row{display:flex;align-items:center;gap:10px}
.book-file-row input{flex:1}
.book-file-status{font-size:9px;color:var(--muted)}
.book-reader{position:fixed;z-index:170;left:50%;top:50%;transform:translate(-50%,-50%);width:min(900px,calc(100% - 30px));height:min(82vh,780px);border-radius:30px;display:grid;grid-template-rows:auto minmax(0,1fr) auto;overflow:hidden}
.book-reader-head{padding:18px 20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:16px;align-items:center}
.book-reader-title{min-width:0}.book-reader-title strong{display:block;font-size:18px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.book-reader-title span{font-size:10px;color:var(--muted)}
.book-reader-head button{width:36px;height:36px;border-radius:50%;border:1px solid var(--line);background:var(--surface-strong)}
.book-reader-body{overflow:auto;padding:28px clamp(20px,5vw,64px);line-height:1.75;font-size:14px;white-space:pre-wrap}
.book-reader-body h3{font-size:24px;margin:0 0 10px}.book-reader-body .summary-box{border:1px solid var(--line);background:var(--surface);border-radius:18px;padding:16px;margin-bottom:18px;color:var(--muted)}
.book-reader-foot{padding:12px 18px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:10px;align-items:center}
.book-reader-foot button,.book-reader-foot a{border:1px solid var(--line);background:var(--surface-strong);color:var(--text);border-radius:12px;padding:9px 12px;text-decoration:none;font-size:10px}
.book-reader-foot .primary{background:var(--text);color:var(--bg)}
@media(max-width:1050px){.books-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:780px){.books-grid{grid-template-columns:repeat(2,1fr)}.books-stats{grid-template-columns:repeat(2,1fr)}.books-toolbar{grid-template-columns:1fr}.books-filters{justify-content:flex-start}.book-form{grid-template-columns:1fr}.book-form label.full,.book-form-actions{grid-column:1}.books-hero-row{align-items:flex-start;flex-direction:column}}
@media(max-width:520px){.books-grid{grid-template-columns:1fr}.books-stats{grid-template-columns:1fr 1fr}.book-actions{grid-template-columns:1fr}.books-hero{padding-top:44px}}
</style>


<style>
/* ===== ORBIT BOOKS · INTERNAL READER ===== */
.book-reader{width:min(980px,calc(100% - 26px))!important;height:min(90vh,860px)!important}
.book-reader-head{padding:15px 18px!important}
.book-reader-toolbar{display:flex;align-items:center;gap:7px;flex-wrap:wrap}
.book-reader-tool{border:1px solid var(--line);background:var(--surface-strong);color:var(--text);border-radius:11px;padding:8px 10px;font-size:10px}
.book-reader-tool:disabled{opacity:.35;cursor:default}
.book-reader-tabs{padding:10px 18px 0;display:flex;gap:7px;border-bottom:1px solid var(--line)}
.book-reader-tab{border:1px solid transparent;background:transparent;border-radius:12px 12px 0 0;padding:9px 12px;font-size:10px;color:var(--muted)}
.book-reader-tab.active{color:var(--text);background:var(--surface-strong);border-color:var(--line);border-bottom-color:var(--surface-strong)}
.book-reader-body{font-size:15px!important;line-height:1.78!important;max-width:none;scroll-behavior:smooth}
.book-reader-body.reader-large{font-size:18px!important}
.book-reader-body.reader-small{font-size:13px!important}
.book-reader-summary{max-width:760px;margin:0 auto}
.book-full-status{max-width:760px;margin:0 auto 18px;border:1px solid var(--line);border-radius:18px;padding:13px 15px;background:var(--surface);font-size:11px;color:var(--muted);line-height:1.5}
.book-full-status strong{color:var(--text)}
.book-full-status.loading::before{content:"";display:inline-block;width:8px;height:8px;margin-right:8px;border-radius:50%;background:var(--text);animation:bookPulse 1s ease-in-out infinite}
@keyframes bookPulse{50%{opacity:.25;transform:scale(.75)}}
.orbit-book-text{max-width:760px;margin:0 auto}
.orbit-book-text h1,.orbit-book-text h2,.orbit-book-text h3,.orbit-book-text h4{line-height:1.25;letter-spacing:-.02em;margin:1.4em 0 .6em}
.orbit-book-text h1{font-size:30px}.orbit-book-text h2{font-size:24px}.orbit-book-text h3{font-size:19px}
.orbit-book-text p{margin:.8em 0}
.orbit-book-text blockquote{border-left:3px solid var(--line);margin:1.2em 0;padding:.2em 0 .2em 16px;color:var(--muted)}
.orbit-book-text .poem,.orbit-book-text .poem-verse{white-space:pre-wrap;font-family:Georgia,"Times New Roman",serif}
.orbit-book-text table{max-width:100%;border-collapse:collapse}
.orbit-book-text td,.orbit-book-text th{border:1px solid var(--line);padding:6px}
.orbit-book-text a{color:inherit;text-decoration:underline;text-decoration-color:color-mix(in srgb,var(--text) 28%,transparent);text-underline-offset:3px;cursor:pointer}
.orbit-book-text .mw-editsection,.orbit-book-text .noprint,.orbit-book-text .ws-noexport,.orbit-book-text .mw-empty-elt,.orbit-book-text .sistersitebox,.orbit-book-text .catlinks,.orbit-book-text .printfooter{display:none!important}
.book-reader-source{display:flex;align-items:center;gap:7px;font-size:9px;color:var(--muted)}
.book-reader-source i{width:7px;height:7px;border-radius:50%;background:var(--good)}
.book-source-action{border:1px solid var(--line);background:var(--surface-strong);border-radius:12px;padding:9px 11px;font-size:10px;color:var(--text)}
@media(max-width:650px){.book-reader{height:94vh!important}.book-reader-head{align-items:flex-start}.book-reader-toolbar{justify-content:flex-end}.book-reader-body{padding:20px 16px!important}.book-reader-title strong{font-size:15px}}
</style>


<style>
/* ORBIT Reader: absolutely no external navigation from book text */
.orbit-book-text .orbit-wiki-link{
  display:inline;
  appearance:none;
  border:0;
  padding:0;
  margin:0;
  background:transparent;
  color:inherit;
  font:inherit;
  line-height:inherit;
  text-align:left;
  text-decoration:underline;
  text-decoration-color:color-mix(in srgb,var(--text) 30%,transparent);
  text-underline-offset:3px;
  cursor:pointer;
}
.orbit-book-text .orbit-wiki-link:hover{
  text-decoration-color:currentColor;
}
.orbit-book-text .orbit-dead-link{
  color:inherit;
  text-decoration:none;
}
.orbit-reader-loading{
  min-height:260px;
  display:grid;
  place-items:center;
  text-align:center;
  color:var(--muted);
}
.orbit-reader-loading strong{
  display:block;
  color:var(--text);
  margin-bottom:7px;
}
.orbit-reader-chapter-note{
  max-width:760px;
  margin:0 auto 16px;
  padding:12px 14px;
  border:1px solid var(--line);
  border-radius:16px;
  background:var(--surface);
  font-size:10px;
  color:var(--muted);
}
</style>

</head>
<body data-family-build="free-final">

<div class="ios-wallpaper" aria-hidden="true">
  <span class="ios-shape s1"></span>
  <span class="ios-shape s2"></span>
  <span class="ios-shape s3"></span>
  <span class="ios-shape s4"></span>
  <span class="ios-shape s5"></span>
  <span class="ios-shape s6"></span>
  <span class="ios-glass-pill"></span>
  <span class="ios-ring"></span>
</div>

  <div class="test-build-badge">ORBIT · FAMILY PREVIEW</div>
  <div class="ambient" aria-hidden="true">
    <span class="orb orb-a"></span><span class="orb orb-b"></span><span class="orb orb-c"></span>
    <span class="grid-glow"></span>
  </div>

  <header class="topbar glass">
    <button class="brand" data-route="home" aria-label="На главную">
      <span class="brand-mark">O</span><span>ORBIT</span><sup>®</sup><em>CHAT BETA</em>
    </button>
    <nav class="main-nav" aria-label="Навигация">
      <button class="nav-btn active" data-route="home">Пространство</button>
      <button class="nav-btn" data-route="games">Игротека <span id="games-count-pill">42</span></button>
      <button class="nav-btn" data-route="tasks">Задачи <span id="tasks-count-pill">0</span></button>
      <button class="nav-btn" data-route="work">Работа</button>
      <button class="nav-btn" data-route="tools">Инструменты</button>
      <button class="nav-btn" data-route="calendar">Календарь</button>
      <button class="nav-btn" data-route="books">Книги</button>
      <button class="nav-btn" data-route="ai">Splash AI</button>
    </nav>
    <div class="header-actions">
      <button class="icon-btn" id="global-search-btn" title="Поиск (Ctrl+K)" aria-label="Поиск">⌕</button>
      <button class="icon-btn focus-btn" id="focus-btn" title="Фокус: скрыть развлечения" aria-label="Фокус: скрыть развлечения">◎</button>
      <button class="icon-btn sync-btn" id="sync-btn" title="Синхронизация" aria-label="Синхронизация">☁</button>
      <button class="icon-btn" id="customize-btn" title="Кастомизация цветов" aria-label="Кастомизация цветов">✦</button>
      <button class="icon-btn" id="theme-btn" title="Сменить тему" aria-label="Сменить тему">◐</button>
      <button class="glass-btn" id="add-site-btn">＋ Добавить сайт</button>
    </div>
  </header>

  <main>
    <section class="page active" id="page-home">
      <div class="hero shell">
        <div class="hero-copy">
          <p class="eyebrow">ТВОЯ ТОЧКА ОТСЧЁТА</p>
          <h1>Твоё пространство<span class="accent-dot">.</span></h1>
          <p class="hero-sub">Сайты, игры и рабочие инструменты в одном спокойном месте.</p>
          <div class="hero-search glass" id="hero-search-wrap">
            <span>⌕</span>
            <input id="hero-search" autocomplete="off" placeholder="Найти YouTube, Яндекс Музыку, ChatGPT…" />
            <kbd>Ctrl K</kbd>
          </div>
          <div class="mode-switcher" id="mode-switcher">
            <span class="mode-switcher-label">СЦЕНАРИЙ</span>
            <button class="mode-pill active" data-mode="default" title="Все разделы ORBIT без фильтра">◌ <span>Обычный</span></button>
            <button class="mode-pill" data-mode="study" title="Учёба, фокус и заметки">◇ <span>Учёба</span></button>
            <button class="mode-pill" data-mode="work" title="Рабочие сервисы, задачи и ORBIT Work">▤ <span>Работа</span></button>
            <button class="mode-pill" data-mode="rest" title="Игры, музыка и видео">◈ <span>Отдых</span></button>
            <button class="mode-pill" data-mode="stream" title="Видео, чат и инструменты для эфира">◉ <span>Стрим</span></button>
          </div>
          <div class="mode-inline-help glass" id="mode-inline-help"></div>
          <div class="stats-row">
            <div><strong id="site-count">94</strong><span>сайтов</span></div>
            <div><strong>32</strong><span>игры</span></div>
            <div><strong id="fav-count">4</strong><span>в избранном</span></div>
          </div>
        </div>
        <div class="hero-visual glass">
          <div class="hero-widget-grid">
            <article class="hero-info-card time-card">
              <small>Время</small>
              <strong id="clock-time">--:--</strong>
              <span id="clock-date">—</span>
            </article>
            <article class="hero-info-card weather-card">
              <small>Погода</small>
              <strong id="weather-temp">--°</strong>
              <span id="weather-desc">Загрузка погоды…</span>
              <em id="weather-city">—</em>
            </article>
            <article class="hero-info-card focus-card">
              <small>Фокусирование <i class="focus-mode-indicator">· режим работы</i></small>
              <div class="focus-timer-row">
                <strong id="focus-time">25:00</strong>
                <button id="focus-timer-toggle">Старт</button>
              </div>
              <span>Pomodoro · 25 минут</span>
            </article>
            <article class="hero-info-card currency-card">
              <small>Курсы валют</small>
              <div class="currency-grid">
                <div class="currency-line"><b>USD / RUB</b><strong id="fx-usd">—</strong></div>
                <div class="currency-line"><b>EUR / RUB</b><strong id="fx-eur">—</strong></div>
              </div>
              <span id="fx-updated">Обновляется…</span>
            </article>
          </div>

          <div class="miroslav-stage" aria-hidden="true">
            <div class="miroslav-name">Мирослав</div>
            <div class="miroslav-pet">
              <div class="miroslav-arm arm-left"></div>
              <div class="miroslav-arm arm-right"></div>
              <div class="miroslav-body"></div>
              <div class="miroslav-leg leg-left"></div>
              <div class="miroslav-leg leg-right"></div>
              <div class="miroslav-head">
                <div class="miroslav-face">
                  <span class="miroslav-eye eye-left"></span>
                  <span class="miroslav-eye eye-right"></span>
                  <span class="miroslav-mouth"></span>
                </div>
                <span class="miroslav-highlight"></span>
              </div>
            </div>
          </div>
          <div class="miroslav-speech" id="miroslav-speech" role="status" aria-live="polite">
            <span id="miroslav-speech-text">Привет! Как дела?)</span>
          </div>
        </div>
      </div>

      <section class="shell mode-dashboard" id="mode-dashboard">
        <div class="mode-dashboard-grid" id="mode-dashboard-grid"></div>
      </section>

      <section class="shell frequent-block">
        <div class="frequent-shell glass">
          <div class="frequent-title"><strong>Часто открываешь</strong><span>Топ по кликам только в этом браузере</span></div>
          <div class="frequent-list" id="frequent-list"><span class="site-domain">Пока данных нет — открой несколько сайтов.</span></div>
        </div>
      </section>

      <section class="shell section-block" id="catalog-section">
        <div class="section-head">
          <div><p class="eyebrow">01 / НАПРАВЛЕНИЯ</p><h2>Открой что-то своё</h2></div>
          <button class="ghost-btn" id="reset-filters">Сбросить</button>
        </div>
        <div class="collections-wrap"><span class="collections-label">МОИ ПРОСТРАНСТВА</span><div class="collection-strip" id="collection-strip"></div><button class="add-collection-btn" id="add-collection-btn">＋ Коллекция</button></div>
        <div class="category-scroller" id="categories"></div>
        <div class="cards-grid" id="site-grid"></div>
        <div class="empty-state hidden" id="site-empty"><strong>Ничего не найдено</strong><span>Попробуй другое название или категорию.</span></div>
      </section>

      <section class="shell section-block play-preview glass">
        <div><p class="eyebrow">ORBIT PLAY / 32 ИГРЫ</p><h2>Немного перезагрузки</h2><p>Аркады, головоломки, антистресс-игры и большой Sandbox — всё запускается прямо внутри ORBIT.</p></div>
        <div class="preview-games" id="preview-games"></div>
        <button class="glass-btn" data-route="games">Перейти в игротеку →</button>
      </section>

      <section class="shell section-block work-preview">
        <article class="glass feature-card"><span class="feature-icon">▤</span><p class="eyebrow">ORBIT WORK</p><h3>Презентации без лишних вкладок</h3><p>Слайды, макеты, заметки, изображения, показ и экспорт PowerPoint.</p><button class="text-link" data-route="work">Открыть рабочее пространство →</button></article>
        <article class="glass feature-card"><span class="feature-icon">✦</span><p class="eyebrow">SPLASH AI</p><h3>Свой ИИ-клиент внутри ORBIT</h3><p>Локальный демо-ассистент: история, режимы и быстрые команды ORBIT — без платного API и без входа.</p><button class="text-link" id="splash-card-btn">Открыть Splash AI →</button></article>
      </section>
    </section>

    <section class="page" id="page-ai">
      <div class="shell subhero ai-subhero">
        <p class="eyebrow">SPLASH / ORBIT AI</p><h1>Твой ИИ внутри ORBIT<span class="accent-dot">.</span></h1>
        <p>Splash работает локально в браузере. Без аккаунта, без API-ключа, без платных запросов и без всплывающих окон.</p>
      </div>
      <div class="shell ai-workspace glass">
        <aside class="ai-sidebar">
          <div class="ai-brand-row"><span class="ai-orb-logo">S</span><div><strong>Splash</strong><small>ORBIT FREE LOCAL AI</small></div></div>
          <button class="ai-new-chat" id="ai-new-chat">＋ Новый чат</button>
          <div class="ai-side-label">ИСТОРИЯ</div>
          <div class="ai-chat-list" id="ai-chat-list"></div>
          <div class="ai-connection"><span class="ai-status-dot" id="ai-status-dot"></span><div><strong id="ai-status-title">Splash AI обновление</strong><small id="ai-status-copy">Работает сразу в браузере. Без аккаунта, API-ключа и установки.</small></div></div>
        </aside>
        <div class="ai-main">
          <header class="ai-topbar">
            <div class="ai-title-wrap"><span class="splash-dot"></span><div><strong id="ai-chat-title">Новый чат</strong><small id="ai-model-label">Splash Real AI · загрузка модели</small></div></div>
            <div class="ai-local-badge" title="Локальный режим"><i></i>LOCAL CORE · FREE</div>
            <div class="ai-mode-tabs" id="ai-mode-tabs">
              <button class="ai-mode-btn active" data-ai-mode="general">Обычный</button>
              <button class="ai-mode-btn" data-ai-mode="study">Учёба</button>
              <button class="ai-mode-btn" data-ai-mode="code">Код</button>
              <button class="ai-mode-btn" data-ai-mode="creative">Творчество</button>
            </div>
          </header>
          <div class="ai-messages" id="ai-messages"></div>
          <div class="ai-compose-wrap">
            <div class="ai-local-bar" id="ai-local-bar">
              <div class="ai-local-info"><strong id="ai-local-title">Splash проверяет модель</strong><span id="ai-local-copy">Проверяю локальный AI-движок и готовлю модель.</span><div class="ai-local-progress"><i id="ai-local-progress" style="width:100%"></i></div></div>
              <button class="ai-local-install secondary" type="button" id="ai-install" disabled>Работает локально</button>
            </div>
            <div class="ai-attachment-bar" id="ai-attachment-bar"></div>
            <form class="ai-composer" id="ai-form">
              <textarea id="ai-input" rows="2" placeholder="Напиши Splash…"></textarea>
              <div class="ai-compose-actions">
                <div class="ai-compose-left"><button class="ai-attach-btn" type="button" id="ai-attach">＋ Файл</button><button class="ai-mini-btn" type="button" id="ai-clear-chat">Очистить</button></div>
                <button class="ai-send-btn" id="ai-send" aria-label="Отправить">↑</button>
              </div>
            </form>
            <input class="hidden" id="ai-file-input" type="file" multiple accept=".txt,.md,.json,.csv,.js,.ts,.css,.html,.py,.java,.cpp,.c,.xml,.yaml,.yml" />
            <p class="ai-compose-hint">История хранится локально. Splash работает без аккаунта и платного API. Сложные общие вопросы пока ограничены локальным ядром.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="page" id="page-games">
      <div class="shell subhero">
        <p class="eyebrow">ORBIT PLAY</p><h1>Мини игры на ORBIT<span class="accent-dot">.</span></h1>
        <p>Аркады, логика, антистресс и песочница — всё запускается прямо внутри ORBIT.</p>
        <div class="orbit-game-overview">
          <div class="orbit-game-stat glass"><strong id="games-total-stat">42</strong><span>игры</span></div>
          <div class="orbit-game-stat glass"><strong id="games-arcade-stat">0</strong><span>аркады</span></div>
          <div class="orbit-game-stat glass"><strong id="games-logic-stat">0</strong><span>логика</span></div>
          <button class="orbit-random-game glass" id="random-game-btn" type="button"><span>✦</span><b>Случайная игра</b><small>Не знаешь, во что сыграть?</small></button>
        </div>
        <div class="games-special glass" id="sandbox-feature">
          <div class="games-special-icon">◫</div>
          <div class="games-special-copy">
            <p class="eyebrow">SPECIAL GAME</p>
            <h2>ORBIT Sandbox</h2>
            <p>Рисуй песок, воду, огонь, лаву, кислоту, растения и строй свои маленькие физические миры.</p>
          </div>
          <button class="glass-btn" id="open-sandbox-feature">Открыть Sandbox →</button>
        </div>
        <div class="game-browser-row">
          <div class="mini-search glass"><span>⌕</span><input id="game-search" placeholder="Найти игру…" /></div>
          <div class="game-filter-chips" id="game-filter-chips">
            <button type="button" class="chip active" data-game-filter="all">Все <small id="games-all-count">42</small></button>
            <button type="button" class="chip" data-game-filter="arcade">Аркады</button>
            <button type="button" class="chip" data-game-filter="logic">Логические</button>
            <button type="button" class="chip" data-game-filter="anti">Антистресс</button>
            <button type="button" class="chip" data-game-filter="sandbox">Песочница</button>
            <button type="button" class="chip" data-game-filter="special">Особые</button>
          </div>
        </div>
      </div>
      <div class="shell game-grid" id="game-grid"></div>
    </section>

    <section class="page" id="page-tasks">
      <div class="shell subhero">
        <p class="eyebrow">ORBIT TASKS</p><h1>Задачи<span class="accent-dot">.</span></h1>
        <p>Локальный список дел с категориями и подзадачами. Всё хранится только в твоём браузере.</p>
      </div>
      <div class="shell tasks-shell">
        <div class="tasks-overview">
          <div class="task-stat glass"><strong id="tasks-open-stat">0</strong><span>осталось</span></div>
          <div class="task-stat glass"><strong id="tasks-done-stat">0</strong><span>выполнено</span></div>
          <div class="task-stat glass"><strong id="tasks-progress-stat">0%</strong><span>общий прогресс</span></div>
        </div>
        <div class="tasks-layout">
          <aside class="task-sidebar glass" id="task-categories"></aside>
          <section class="task-main">
            <form class="task-create glass" id="task-create-form">
              <input name="title" maxlength="120" placeholder="Что нужно сделать?" required />
              <select name="category"><option>Учёба</option><option>Работа</option><option>Личное</option><option>Проект</option></select>
              <input name="date" type="date" title="Дата" />
              <button>＋ Добавить</button>
            </form>
            <div class="task-list" id="task-list"></div>
          </section>
        </div>
      </div>
    </section>

    <section class="page" id="page-work">
      <div class="work-shell">
        <aside class="work-sidebar glass">
          <div class="side-title"><span class="brand-mark sm">O</span><div><strong>ORBIT WORK</strong><small>Presentation Studio</small></div></div>
          <button class="side-action primary" id="new-deck-btn">＋ Новая презентация</button>
          <button class="side-action" id="save-deck-btn">Сохранить в браузере</button>
          <button class="side-action" id="download-deck-btn">Скачать проект</button>
          <button class="side-action" id="export-pptx-btn">Экспорт .pptx</button>
          <button class="side-action" id="present-btn">▶ Показ</button>
          <div class="side-divider"></div>
          <p class="side-label">Шаблоны</p>
          <button class="template-btn" data-template="study">Учёба</button>
          <button class="template-btn" data-template="project">Проект</button>
          <button class="template-btn" data-template="minimal">Минимализм</button>
          <div class="side-divider"></div>
          <p class="side-label">Макеты слайда</p>
          <div class="layout-grid">
            <button data-layout="title">Aa</button><button data-layout="titleBody">A≡</button><button data-layout="twoCol">▥</button><button data-layout="quote">“ ”</button>
          </div>
        </aside>

        <section class="editor-panel">
          <div class="editor-topbar glass">
            <input id="deck-title" value="Новая презентация" aria-label="Название презентации" />
            <div class="editor-actions"><button id="add-slide-btn">＋ Слайд</button><button id="duplicate-slide-btn">Дублировать</button><button id="delete-slide-btn">Удалить</button></div>
          </div>
          <div class="editor-content">
            <aside class="slides-rail glass" id="slides-rail"></aside>
            <div class="canvas-area">
              <div class="slide-canvas glass" id="slide-canvas"></div>
              <div class="canvas-tools glass">
                <label>Заголовок<input id="field-title" /></label>
                <label>Подзаголовок<input id="field-subtitle" /></label>
                <label>Основной текст<textarea id="field-body" rows="4"></textarea></label>
                <label>Изображение URL<input id="field-image" placeholder="https://…" /></label>
                <label>Заметки<textarea id="field-notes" rows="3"></textarea></label>
              </div>
            </div>
          </div>
        </section>
      </div>
    </section>

    
    
<section class="page" id="page-calendar">
  <div class="shell subhero">
    <p class="eyebrow">ORBIT PLANNER</p>
    <h1>Календарь ORBIT<span class="accent-dot">.</span></h1>
    <p>Планируй события, храни заметки и держи под рукой цели, записи и ближайшие дела — всё в одном аккуратном разделе.</p>
    <div class="calendar-hero-note"><i class="calendar-dot"></i><span>Все записи сохраняются локально в браузере и остаются после перезагрузки страницы.</span></div>

    <div class="calendar-overview">
      <div class="calendar-metric glass"><div class="metric-icon">📅</div><div><strong id="calendar-stat-events">0 событий</strong><span>Запланировано</span></div></div>
      <div class="calendar-metric glass"><div class="metric-icon">🎯</div><div><strong id="calendar-stat-goals">0 целей</strong><span>На контроле</span></div></div>
      <div class="calendar-metric glass"><div class="metric-icon">📝</div><div><strong id="calendar-stat-notes">0 символов</strong><span>В заметках</span></div></div>
    </div>

    <div class="calendar-layout">
      <div class="calendar-stack">
        <div class="calendar-card glass">
          <h2>📅 Добавить событие</h2>
          <p class="small">Выбери дату и быстро создай новое событие.</p>
          <div class="calendar-form-grid">
            <input id="calendar-date" class="calendar-input" type="date">
            <input id="calendar-event" class="calendar-input" placeholder="Например: Семейный ужин, контрольная, звонок...">
            <button class="calendar-btn" id="calendar-add-event">Добавить</button>
          </div>
          <div class="calendar-chip-row">
            <button class="calendar-chip-btn" data-quick-event="Учёба">Учёба</button>
            <button class="calendar-chip-btn" data-quick-event="Работа">Работа</button>
            <button class="calendar-chip-btn" data-quick-event="Встреча">Встреча</button>
            <button class="calendar-chip-btn" data-quick-event="Отдых">Отдых</button>
          </div>
          <div id="calendar-events" class="calendar-list"></div>
        </div>

        <div class="calendar-card glass">
          <h2>🎯 Цели и планы</h2>
          <p class="small">Добавляй цели на день, неделю или просто важные дела.</p>
          <div class="calendar-form-grid" style="grid-template-columns:1fr auto;">
            <input id="calendar-goal" class="calendar-input" placeholder="Например: закончить проект, повторить математику">
            <button class="calendar-btn" id="calendar-add-goal">Добавить цель</button>
          </div>
          <div id="calendar-goals" class="calendar-list"></div>
        </div>
      </div>

      <div class="calendar-stack">
        <div class="calendar-card glass">
          <h2>📝 Заметки дня</h2>
          <p class="small">Используй как личный блокнот: идеи, напоминания, планы и записи.</p>
          <textarea id="calendar-notes" class="calendar-textarea" placeholder="Запиши идеи, планы или важные мысли..."></textarea>
          <div class="calendar-chip-row">
            <button class="calendar-btn" id="calendar-save-notes">Сохранить заметки</button>
            <button class="calendar-chip-btn" id="calendar-clear-notes">Очистить</button>
          </div>
        </div>

        <div class="calendar-card glass">
          <h2>⏰ Ближайшее и напоминания</h2>
          <p class="small">Здесь ORBIT показывает краткую сводку по ближайшим событиям и активным целям.</p>
          <div id="calendar-reminders" class="calendar-agenda"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="page" id="page-books">
  <div class="shell books-hero">
    <div class="books-hero-row">
      <div>
        <p class="eyebrow">ORBIT LIBRARY</p>
        <h1>Книги<span class="accent-dot">.</span></h1>
        <p>Большая библиотека ORBIT: 225 произведений для 7–11 классов, теперь с нормальными развёрнутыми краткими содержаниями и удобными легальными источниками для чтения.</p>
      </div>
      <button class="books-add-btn" id="books-add-btn">＋ Добавить книгу</button>
    </div>

    <div class="books-stats">
      <div class="books-stat glass"><strong id="books-stat-all">0</strong><span>в библиотеке</span></div>
      <div class="books-stat glass"><strong id="books-stat-mine">0</strong><span>моих книг</span></div>
      <div class="books-stat glass"><strong id="books-stat-read">0</strong><span>прочитано</span></div>
      <div class="books-stat glass"><strong id="books-stat-fav">0</strong><span>избранное</span></div>
    </div>

    <div class="books-toolbar">
      <label class="books-search glass">
        <span>⌕</span>
        <input id="books-search" placeholder="Найти книгу, автора или произведение...">
      </label>
      <div class="books-filters" id="books-filters">
        <button class="books-filter active" data-book-filter="all">Все</button>
        <button class="books-filter" data-book-filter="school">7–11 классы</button>
        <button class="books-filter" data-book-filter="grade7">7 класс</button>
        <button class="books-filter" data-book-filter="grade8">8 класс</button>
        <button class="books-filter" data-book-filter="grade9">9 класс</button>
        <button class="books-filter" data-book-filter="grade10">10 класс</button>
        <button class="books-filter" data-book-filter="grade11">11 класс</button>
        <button class="books-filter" data-book-filter="extra">Доп. чтение</button>
        <button class="books-filter" data-book-filter="mine">Мои книги</button>
        <button class="books-filter" data-book-filter="favorite">Избранное</button>
      </div>
    </div>


    <div class="books-source-note glass">
      <strong>Школьная программа 7–11 классов</strong>
      <span>Встроено 225 произведений. Подборка опирается на федеральные рабочие программы по литературе; позиции «по выбору» вынесены в библиотеку вместе с основными произведениями. Краткие содержания написаны специально для ORBIT.</span>
    </div>

    
    <div class="books-reading-note glass">
      <strong>Нормальные источники чтения</strong>
      <span>Русскую классику ORBIT открывает через «Культура.РФ» — государственный просветительский портал с бесплатными электронными книгами. Для зарубежных и современных произведений используется ЛитРес: там можно найти легальное издание, фрагмент, подписку или покупку.</span>
    </div>

    <div class="books-grid" id="books-grid"></div>
  </div>
</section>

<div class="book-modal-backdrop hidden" id="book-modal-backdrop"></div>

<div class="book-modal glass hidden" id="book-add-modal">
  <div class="book-modal-head">
    <div><p class="eyebrow">МОЯ БИБЛИОТЕКА</p><h2>Добавить книгу</h2></div>
    <button type="button" data-close-book-add>✕</button>
  </div>
  <form class="book-form" id="book-add-form">
    <label>Название<input name="title" required placeholder="Например: Мой рассказ"></label>
    <label>Автор<input name="author" placeholder="Автор или псевдоним"></label>
    <label>Тип
      <select name="type">
        <option value="Моя книга">Моя книга</option>
        <option value="Рассказ">Рассказ</option>
        <option value="Роман">Роман</option>
        <option value="Стихотворение">Стихотворение</option>
        <option value="Статья">Статья</option>
        <option value="Другое">Другое</option>
      </select>
    </label>
    <label>Ссылка для чтения<input name="url" type="url" placeholder="https://..."></label>
    <label class="full">Краткое содержание<textarea name="summary" placeholder="Несколько предложений о произведении..."></textarea></label>
    <label class="full">Текст произведения<textarea class="book-content-field" name="content" id="book-content-input" placeholder="Можно вставить текст сюда или загрузить TXT/MD ниже."></textarea></label>
    <label class="full">Загрузить TXT / MD
      <div class="book-file-row">
        <input id="book-file-input" type="file" accept=".txt,.md,text/plain,text/markdown">
        <span class="book-file-status" id="book-file-status">не выбран</span>
      </div>
    </label>
    <div class="book-form-actions">
      <button type="button" data-close-book-add>Отмена</button>
      <button class="primary" type="submit">Сохранить в ORBIT</button>
    </div>
  </form>
</div>

<div class="book-reader glass hidden" id="book-reader">
  <div class="book-reader-head">
    <div class="book-reader-title">
      <strong id="book-reader-name">Книга</strong>
      <span id="book-reader-author"></span>
    </div>
    <div class="book-reader-toolbar">
      <button class="book-reader-tool" id="book-reader-back" type="button" title="Назад по главам" disabled>←</button>
      <button class="book-reader-tool" id="book-font-minus" type="button">A−</button>
      <button class="book-reader-tool" id="book-font-plus" type="button">A+</button>
      <button type="button" data-close-book-reader>✕</button>
    </div>
  </div>

  <div class="book-reader-tabs">
    <button class="book-reader-tab active" data-reader-tab="full">Полный текст</button>
    <button class="book-reader-tab" data-reader-tab="summary">Краткое содержание</button>
  </div>

  <div class="book-reader-body" id="book-reader-body"></div>

  <div class="book-reader-foot">
    <div>
      <div class="book-reader-source" id="book-reader-source"><i></i><span>Чтение внутри ORBIT</span></div>
      <span id="book-reader-status" style="display:block;margin-top:4px;font-size:9px;color:var(--muted)"></span>
    </div>
    <div style="display:flex;gap:7px;align-items:center">
      <button class="book-source-action" id="book-retry-full" type="button">↻ Загрузить текст</button>
      <button class="primary" id="book-mark-read">✓ Отметить прочитанной</button>
    </div>
  </div>
</div>

<section class="page" id="page-tools">
      <div class="shell subhero">
        <p class="eyebrow">ORBIT TOOLS</p><h1>Мини-приложения<span class="accent-dot">.</span></h1>
        <p>Полезные вещи прямо внутри ORBIT — без лишних вкладок.</p>
      </div>
      <div class="shell tools-shell">
        <div class="tools-browser glass">
          <div class="tools-browser-top">
            <div>
              <p class="eyebrow">TOOLBOX</p>
              <strong><span id="tools-visible-count">29</span> инструментов</strong>
            </div>
            <div class="tools-search"><span>⌕</span><input id="tools-search" placeholder="Найти инструмент…" autocomplete="off"></div>
          </div>
          <div class="tools-filter" id="tools-filter">
            <button class="tool-filter-chip active" data-tool-filter="all">Все</button>
            <button class="tool-filter-chip" data-tool-filter="math">Математика</button>
            <button class="tool-filter-chip" data-tool-filter="text">Текст</button>
            <button class="tool-filter-chip" data-tool-filter="projects">Проекты</button>
            <button class="tool-filter-chip" data-tool-filter="time">Время</button>
            <button class="tool-filter-chip" data-tool-filter="design">Дизайн</button>
            <button class="tool-filter-chip" data-tool-filter="files">Файлы</button>
            <button class="tool-filter-chip" data-tool-filter="dev">Dev</button>
          </div>
        </div>
        <div class="tools-grid" id="tools-grid">
          <article class="glass tool-card" data-tool-cat="text" data-tool-name="markdown заметки текст">
            <div class="tool-icon">✎</div>
            <p class="eyebrow">MARKDOWN NOTES</p><h3>Заметки</h3><p>Пиши слева — справа сразу появляется аккуратный предпросмотр. Сохраняется автоматически.</p>
            <div class="markdown-layout"><textarea id="markdown-input" rows="8" placeholder="# Идея
- пункт
- ещё пункт"></textarea><div class="markdown-preview" id="markdown-preview"></div></div>
          </article>
          <article class="glass tool-card" data-tool-cat="math" data-tool-name="калькулятор математика">
            <div class="tool-icon">⌗</div>
            <p class="eyebrow">CALCULATOR</p><h3>Калькулятор</h3><p>Нормальный кнопочный калькулятор — ничего вводить вручную не нужно.</p>
            <div class="calc-shell">
              <div class="calc-display"><div class="calc-expression" id="calc-expression">0</div><div class="calc-result" id="calc-result">0</div></div>
              <div class="calc-keys">
                <button class="calc-key soft" data-calc="clear">C</button><button class="calc-key soft" data-calc="sign">±</button><button class="calc-key soft" data-calc="percent">%</button><button class="calc-key op" data-calc="/">÷</button>
                <button class="calc-key" data-calc="7">7</button><button class="calc-key" data-calc="8">8</button><button class="calc-key" data-calc="9">9</button><button class="calc-key op" data-calc="*">×</button>
                <button class="calc-key" data-calc="4">4</button><button class="calc-key" data-calc="5">5</button><button class="calc-key" data-calc="6">6</button><button class="calc-key op" data-calc="-">−</button>
                <button class="calc-key" data-calc="1">1</button><button class="calc-key" data-calc="2">2</button><button class="calc-key" data-calc="3">3</button><button class="calc-key op" data-calc="+">+</button>
                <button class="calc-key soft" data-calc="back">⌫</button><button class="calc-key" data-calc="0">0</button><button class="calc-key" data-calc=".">,</button><button class="calc-key eq" data-calc="=">=</button>
              </div>
            </div>
          </article>
          <article class="glass tool-card" data-tool-cat="time projects" data-tool-name="таймер встречи секундомер время">
            <div class="tool-icon">◴</div>
            <p class="eyebrow">MEETING TIMER</p><h3>Таймер встречи</h3><p>Секундомер для созвона, занятия или работы.</p>
            <div class="meeting-display" id="meeting-display">00:00:00</div><div class="tool-row"><button id="meeting-toggle">Старт</button><button id="meeting-reset">Сбросить</button></div>
          </article>
          <article class="glass tool-card" data-tool-cat="math" data-tool-name="конвертер величин длина масса температура">
            <div class="tool-icon">↔</div>
            <p class="eyebrow">UNIT CONVERTER</p><h3>Конвертер величин</h3><p>Длина, масса и температура — без новых вкладок.</p>
            <select id="unit-kind"><option value="length">Длина</option><option value="mass">Масса</option><option value="temp">Температура</option></select>
            <div class="converter-grid">
              <div><input id="unit-input" type="number" step="any" value="1"><select id="unit-from"></select></div>
              <div><div class="tool-output"><span id="unit-output">1</span></div><select id="unit-to"></select></div>
            </div>
          </article>
          <article class="glass tool-card" data-tool-cat="text" data-tool-name="текст слова символы регистр">
            <div class="tool-icon">Aa</div>
            <p class="eyebrow">TEXT TOOLS</p><h3>Работа с текстом</h3><p>Счётчик слов, символов и быстрые преобразования.</p>
            <textarea id="text-tools-input" rows="7" placeholder="Вставь сюда текст…"></textarea>
            <div class="text-stats"><span class="text-stat" id="text-chars">0 символов</span><span class="text-stat" id="text-words">0 слов</span><span class="text-stat" id="text-lines">0 строк</span></div>
            <div class="tool-row"><button data-text-action="upper">АА</button><button data-text-action="lower">аа</button><button data-text-action="trim">Пробелы</button><button data-text-action="copy">Копировать</button></div>
          </article>
          <article class="glass tool-card" data-tool-cat="design" data-tool-name="цвет hex rgb дизайн">
            <div class="tool-icon">◐</div>
            <p class="eyebrow">COLOR LAB</p><h3>Цвет</h3><p>Выбери цвет и сразу получи HEX и RGB.</p>
            <div class="color-lab">
              <div class="color-swatch" id="color-swatch"></div>
              <div class="color-input-wrap">
                <input type="color" id="color-picker" value="#1d1d1d">
                <div class="tool-output" style="margin-top:8px"><span id="color-hex">#1D1D1D</span><button id="copy-color" style="flex:0">Копировать</button></div>
                <div class="site-domain" id="color-rgb" style="margin-top:7px">rgb(29, 29, 29)</div>
              </div>
            </div>
          </article>
          <article class="glass tool-card" data-tool-cat="projects math" data-tool-name="рандомайзер случайный выбор число">
            <div class="tool-icon">?</div>
            <p class="eyebrow">RANDOMIZER</p><h3>Рандомайзер</h3><p>Случайное число или случайный вариант из списка.</p>
            <div class="converter-grid"><input id="random-min" type="number" value="1" placeholder="От"><input id="random-max" type="number" value="100" placeholder="До"></div>
            <div class="random-result" id="random-result">—</div><button id="random-number-btn">Случайное число</button>
            <textarea id="random-list" rows="4" style="margin-top:10px" placeholder="Вариант 1
Вариант 2
Вариант 3"></textarea><button id="random-choice-btn" style="margin-top:8px">Выбрать вариант</button>
          </article>
          <article class="glass tool-card" data-tool-cat="files design" data-tool-name="изображение png jpeg webp конвертер файл">
            <div class="tool-icon">▧</div>
            <p class="eyebrow">IMAGE CONVERTER</p><h3>Конвертер изображений</h3><p>PNG, JPEG и WebP — обработка идёт локально в браузере.</p>
            <div class="converter-drop"><input type="file" id="converter-file" accept="image/*"><div class="converter-status" id="converter-status">Выбери изображение</div></div>
            <div class="tool-row"><select id="converter-format"><option value="image/png">PNG</option><option value="image/jpeg">JPEG</option><option value="image/webp">WebP</option></select><button id="converter-run">Конвертировать</button></div>
          </article>

          <article class="glass tool-card compact-tool" data-tool-cat="math" data-tool-name="проценты процент скидка наценка">
            <div class="tool-icon">%</div>
            <p class="eyebrow">PERCENTAGE</p><h3>Проценты</h3><p>Посчитай процент от числа и процентное изменение.</p>
            <div class="tool-row"><input id="percent-value" type="number" value="1000" placeholder="Число"><input id="percent-rate" type="number" value="15" placeholder="%"></div>
            <div class="tool-output big-output"><span id="percent-result">150</span></div>
            <div class="tool-row"><input id="percent-old" type="number" value="100" placeholder="Было"><input id="percent-new" type="number" value="125" placeholder="Стало"></div>
            <div class="site-domain" id="percent-change">Изменение: +25%</div>
          </article>

          <article class="glass tool-card compact-tool" data-tool-cat="math" data-tool-name="статистика среднее медиана сумма минимум максимум">
            <div class="tool-icon">Σ</div>
            <p class="eyebrow">STATISTICS</p><h3>Статистика</h3><p>Среднее, медиана, сумма, минимум и максимум для списка чисел.</p>
            <textarea id="stats-input" rows="5" placeholder="10, 12, 18, 20, 25">10, 12, 18, 20, 25</textarea>
            <div class="mini-metric-grid">
              <div><small>Среднее</small><strong id="stats-avg">17</strong></div><div><small>Медиана</small><strong id="stats-med">18</strong></div>
              <div><small>Сумма</small><strong id="stats-sum">85</strong></div><div><small>Диапазон</small><strong id="stats-range">10–25</strong></div>
            </div>
          </article>

          <article class="glass tool-card compact-tool" data-tool-cat="math" data-tool-name="квадратное уравнение дискриминант корни">
            <div class="tool-icon">x²</div>
            <p class="eyebrow">EQUATION SOLVER</p><h3>Квадратное уравнение</h3><p>Решает ax² + bx + c = 0.</p>
            <div class="tool-row"><input id="quad-a" type="number" value="1"><input id="quad-b" type="number" value="-3"><input id="quad-c" type="number" value="2"></div>
            <div class="random-result" id="quad-result">x₁ = 1 · x₂ = 2</div>
          </article>

          <article class="glass tool-card compact-tool" data-tool-cat="math" data-tool-name="пропорция отношение ratio">
            <div class="tool-icon">∶</div>
            <p class="eyebrow">PROPORTION</p><h3>Пропорция</h3><p>Решает A : B = C : X.</p>
            <div class="ratio-row"><input id="ratio-a" type="number" value="4"><span>:</span><input id="ratio-b" type="number" value="8"><span>=</span><input id="ratio-c" type="number" value="10"><span>:</span><strong id="ratio-x">20</strong></div>
          </article>

          <article class="glass tool-card" data-tool-cat="text dev" data-tool-name="json форматирование минификация валидатор">
            <div class="tool-icon">{ }</div>
            <p class="eyebrow">JSON LAB</p><h3>JSON Formatter</h3><p>Проверка, красивое форматирование и минификация JSON.</p>
            <textarea id="json-input" rows="7" placeholder='{"orbit":true,"tools":29}'></textarea>
            <div class="tool-row"><button id="json-format">Форматировать</button><button id="json-minify">Минифицировать</button><button id="json-copy">Копировать</button></div>
            <div class="converter-status" id="json-status">Готов к проверке</div>
          </article>

          <article class="glass tool-card" data-tool-cat="text dev" data-tool-name="regex регулярные выражения поиск">
            <div class="tool-icon">.*</div>
            <p class="eyebrow">REGEX TESTER</p><h3>Regex-тестер</h3><p>Проверь регулярное выражение прямо в браузере.</p>
            <div class="tool-row"><input id="regex-pattern" value="\\b\\w{5,}\\b" placeholder="Выражение"><input id="regex-flags" value="giu" placeholder="Флаги"></div>
            <textarea id="regex-text" rows="6">ORBIT собирает полезные инструменты внутри одного пространства.</textarea>
            <div class="converter-status" id="regex-result">Совпадения появятся здесь</div>
          </article>

          <article class="glass tool-card compact-tool" data-tool-cat="text dev" data-tool-name="base64 кодирование декодирование">
            <div class="tool-icon">64</div>
            <p class="eyebrow">BASE64</p><h3>Base64</h3><p>Кодируй и декодируй Unicode-текст.</p>
            <textarea id="base64-input" rows="5" placeholder="Текст или Base64"></textarea>
            <div class="tool-row"><button id="base64-encode">Кодировать</button><button id="base64-decode">Декодировать</button></div>
          </article>

          <article class="glass tool-card compact-tool" data-tool-cat="text dev" data-tool-name="url encode decode ссылка кодирование">
            <div class="tool-icon">%</div>
            <p class="eyebrow">URL CODEC</p><h3>URL Encoder</h3><p>Encode / decode текста для URL-параметров.</p>
            <textarea id="urlcodec-input" rows="5" placeholder="Пример: ORBIT tools & games"></textarea>
            <div class="tool-row"><button id="url-encode">Encode</button><button id="url-decode">Decode</button></div>
          </article>

          <article class="glass tool-card compact-tool" data-tool-cat="text projects dev" data-tool-name="slug генератор адрес название">
            <div class="tool-icon">/</div>
            <p class="eyebrow">SLUG MAKER</p><h3>Slug Generator</h3><p>Превращает название проекта в аккуратный URL-slug.</p>
            <input id="slug-input" value="Мой новый проект ORBIT" placeholder="Название">
            <div class="tool-output"><span id="slug-output">moi-novyi-proekt-orbit</span><button id="slug-copy">Копировать</button></div>
          </article>

          <article class="glass tool-card" data-tool-cat="projects" data-tool-name="проект brief бриф цель аудитория дедлайн">
            <div class="tool-icon">▤</div>
            <p class="eyebrow">PROJECT BRIEF</p><h3>Бриф проекта</h3><p>Собери короткий бриф, который можно сразу скопировать.</p>
            <input id="brief-name" placeholder="Название проекта">
            <textarea id="brief-goal" rows="3" placeholder="Главная цель"></textarea>
            <div class="tool-row"><input id="brief-audience" placeholder="Для кого"><input id="brief-deadline" type="date"></div>
            <div class="tool-row"><button id="brief-generate">Собрать бриф</button><button id="brief-copy">Копировать</button></div>
            <textarea id="brief-output" rows="6" readonly placeholder="Здесь появится готовый бриф"></textarea>
          </article>

          <article class="glass tool-card compact-tool" data-tool-cat="projects math" data-tool-name="оценка проекта время задачи команда effort">
            <div class="tool-icon">⌁</div>
            <p class="eyebrow">EFFORT ESTIMATOR</p><h3>Оценка проекта</h3><p>Черновая оценка времени по задачам и размеру команды.</p>
            <div class="tool-row"><input id="effort-tasks" type="number" value="12" min="1" placeholder="Задач"><input id="effort-minutes" type="number" value="45" min="1" placeholder="Мин/задачу"><input id="effort-people" type="number" value="2" min="1" placeholder="Людей"></div>
            <div class="random-result" id="effort-result">≈ 4 ч 30 мин на человека</div>
          </article>

          <article class="glass tool-card compact-tool" data-tool-cat="time math" data-tool-name="разница дат дни часы">
            <div class="tool-icon">↦</div>
            <p class="eyebrow">DATE DIFFERENCE</p><h3>Разница дат</h3><p>Сколько времени между двумя датами.</p>
            <div class="tool-row"><input id="date-a" type="date"><input id="date-b" type="date"></div>
            <div class="random-result" id="date-diff-result">—</div>
          </article>

          <article class="glass tool-card compact-tool" data-tool-cat="time projects" data-tool-name="обратный отсчет countdown дедлайн">
            <div class="tool-icon">⧖</div>
            <p class="eyebrow">COUNTDOWN</p><h3>До события</h3><p>Живой обратный отсчёт до дедлайна или события.</p>
            <input id="countdown-date" type="datetime-local">
            <div class="meeting-display mini-countdown" id="countdown-output">—</div>
          </article>

          <article class="glass tool-card compact-tool" data-tool-cat="time" data-tool-name="мировое время часовые пояса">
            <div class="tool-icon">◎</div>
            <p class="eyebrow">WORLD CLOCK</p><h3>Мировое время</h3><p>Быстро сравни несколько часовых поясов.</p>
            <select id="world-zone">
              <option value="Europe/Moscow">Москва</option>
              <option value="Europe/Amsterdam">Амстердам</option>
              <option value="Europe/London">Лондон</option>
              <option value="America/New_York">Нью-Йорк</option>
              <option value="Asia/Tokyo">Токио</option>
              <option value="Asia/Dubai">Дубай</option>
            </select>
            <div class="random-result" id="world-time">—</div>
          </article>

          <article class="glass tool-card compact-tool" data-tool-cat="design math" data-tool-name="соотношение сторон aspect ratio размер">
            <div class="tool-icon">▭</div>
            <p class="eyebrow">ASPECT RATIO</p><h3>Соотношение сторон</h3><p>Определи формат и пересчитай размер без искажений.</p>
            <div class="tool-row"><input id="aspect-w" type="number" value="1920"><input id="aspect-h" type="number" value="1080"></div>
            <div class="site-domain" id="aspect-ratio">16:9</div>
            <div class="tool-row"><input id="aspect-new-w" type="number" value="1280" placeholder="Новая ширина"><div class="tool-output"><span id="aspect-new-h">720 px</span></div></div>
          </article>

          <article class="glass tool-card compact-tool" data-tool-cat="design" data-tool-name="контраст цвета wcag readability">
            <div class="tool-icon">◑</div>
            <p class="eyebrow">CONTRAST CHECKER</p><h3>Контраст</h3><p>Проверь читаемость двух цветов по коэффициенту WCAG.</p>
            <div class="tool-row"><input id="contrast-a" type="color" value="#171717"><input id="contrast-b" type="color" value="#f5f4f0"></div>
            <div class="contrast-preview" id="contrast-preview">ORBIT Aa</div>
            <div class="site-domain" id="contrast-result">—</div>
          </article>

          <article class="glass tool-card compact-tool" data-tool-cat="files dev" data-tool-name="sha256 checksum хэш файл">
            <div class="tool-icon">#</div>
            <p class="eyebrow">SHA-256</p><h3>Хэш файла</h3><p>Посчитай SHA-256 локально — файл никуда не отправляется.</p>
            <input id="hash-file" type="file">
            <div class="hash-output" id="hash-output">Выбери файл</div>
            <button id="hash-copy">Копировать хэш</button>
          </article>

          <article class="glass tool-card" data-tool-cat="files text dev" data-tool-name="csv json конвертер таблица">
            <div class="tool-icon">⇄</div>
            <p class="eyebrow">CSV → JSON</p><h3>CSV в JSON</h3><p>Превращает небольшую таблицу CSV в JSON.</p>
            <textarea id="csv-input" rows="6" placeholder="name,score&#10;Orbit,10&#10;Splash,9"></textarea>
            <div class="tool-row"><button id="csv-convert">Конвертировать</button><button id="csv-copy">Копировать</button></div>
            <textarea id="csv-output" rows="6" readonly placeholder="JSON появится здесь"></textarea>
          </article>

          <article class="glass tool-card compact-tool" data-tool-cat="dev projects" data-tool-name="uuid id генератор идентификатор">
            <div class="tool-icon">ID</div>
            <p class="eyebrow">UUID</p><h3>UUID Generator</h3><p>Создаёт UUID v4 прямо в браузере.</p>
            <div class="hash-output" id="uuid-output">—</div>
            <div class="tool-row"><button id="uuid-generate">Новый UUID</button><button id="uuid-copy">Копировать</button></div>
          </article>

          <article class="glass tool-card compact-tool" data-tool-cat="dev projects" data-tool-name="пароль password генератор">
            <div class="tool-icon">••</div>
            <p class="eyebrow">PASSWORD</p><h3>Генератор паролей</h3><p>Локальный генератор случайных паролей.</p>
            <label class="mini-label">Длина <input id="password-length" type="range" min="8" max="40" value="18"><span id="password-length-value">18</span></label>
            <div class="hash-output password-output" id="password-output">—</div>
            <div class="tool-row"><button id="password-generate">Сгенерировать</button><button id="password-copy">Копировать</button></div>
          </article>

          <article class="glass tool-card compact-tool" data-tool-cat="time dev" data-tool-name="unix timestamp время дата">
            <div class="tool-icon">t</div>
            <p class="eyebrow">UNIX TIME</p><h3>Timestamp</h3><p>Unix timestamp ↔ обычная дата.</p>
            <input id="timestamp-input" type="number" placeholder="Unix timestamp">
            <div class="random-result" id="timestamp-output">—</div>
            <div class="tool-row"><button id="timestamp-now">Сейчас</button><button id="timestamp-convert">Преобразовать</button></div>
          </article>
        </div></div>
      </div>
    </section>
  

</main>

  <footer class="footer shell"><div><strong>ORBIT</strong><span>Маленькое пространство. Большой интернет.</span></div><small>Family Preview · гостевой просмотр · без аккаунта</small></footer>

  <div class="modal-backdrop hidden" id="modal-backdrop"></div>

  <section class="command glass hidden" id="command-palette" role="dialog" aria-modal="true" aria-label="Поиск">
    <div class="command-head"><span>⌕</span><input id="command-input" placeholder="Сайт, игра или раздел…" /><kbd>Esc</kbd></div>
    <div class="command-results" id="command-results"></div>
  </section>

  <section class="splash-panel glass hidden" id="splash-panel" aria-label="Splash">
    <div class="splash-head"><div><span class="splash-dot"></span><strong>Splash</strong><small>ORBIT assistant</small></div><button id="close-splash">×</button></div>
    <div class="splash-chat" id="splash-chat">
      <div class="bubble splash"><strong>Привет! Я Splash.</strong><span>Напиши «открой Яндекс Музыку», «покажи игры», «работа» или просто название сервиса.</span></div>
    </div>
    <form class="splash-form" id="splash-form"><input id="splash-input" placeholder="Что открыть или найти?" /><button>↑</button></form>
    <p class="splash-note">Быстрый Splash управляет ORBIT локально. Полный чат Splash Free работает через модель на устройстве.</p>
  </section>

  <section class="dialog glass hidden" id="add-site-dialog">
    <div class="dialog-head"><div><p class="eyebrow">НОВАЯ ССЫЛКА</p><h3>Добавить сайт</h3></div><button data-close-dialog>×</button></div>
    <form id="add-site-form">
      <label>Название<input name="name" required placeholder="Например, Мой сервис" /></label>
      <label>Адрес<input name="url" required placeholder="https://example.com" /></label>
      <label>Описание<input name="description" placeholder="Короткое описание" /></label>
      <label>Категория<select name="category"><option>Работа</option><option>Учёба</option><option>Игры</option><option>Видео и музыка</option><option>Общение</option><option>Дизайн</option><option>Разработка</option><option>Поиск и сервисы</option></select></label>
      <button class="glass-btn full" type="submit">Добавить</button>
    </form>
  </section>

  <section class="dialog glass compact hidden" id="collection-dialog">
    <div class="dialog-head"><div><p class="eyebrow">МОЁ ПРОСТРАНСТВО</p><h3>Новая коллекция</h3></div><button data-close-collection>×</button></div>
    <form id="collection-form"><label>Название<input name="name" required maxlength="28" placeholder="Например, Проект X" /></label><button class="glass-btn full" type="submit">Создать коллекцию</button></form>
  </section>

  <section class="dialog glass color-dialog hidden" id="color-dialog">
    <div class="dialog-head"><div><p class="eyebrow">ORBIT LOOK</p><h3>Кастомизация цветов</h3></div><button id="close-color-dialog">×</button></div>
    <div class="color-preview" id="color-preview"><span>ORBIT</span><small>Твой градиент</small></div>
    <div class="ready-theme-title">
      <span>Готовые кастомизации</span>
      <small>Три атмосферы без картинок — только градиенты и плавающие фигуры</small>
    </div>
    <div class="ready-themes" id="ready-themes">
      <button class="ready-theme-card" data-ready-theme="water">
        <i class="ready-theme-swatch theme-water-swatch"><b></b><b></b><b></b></i>
        <span><strong>Кристаллическая вода</strong><small>Чистые голубые и ледяные оттенки</small></span>
      </button>
      <button class="ready-theme-card" data-ready-theme="space">
        <i class="ready-theme-swatch theme-space-swatch"><b></b><b></b><b></b></i>
        <span><strong>Космос</strong><small>Более тёмный глубокий сине-фиолетовый</small></span>
      </button>
      <button class="ready-theme-card" data-ready-theme="aurora">
        <i class="ready-theme-swatch theme-aurora-swatch"><b></b><b></b><b></b></i>
        <span><strong>Полярное сияние</strong><small>Холодная мята, лёд и мягкий лиловый</small></span>
      </button>
    </div>

    <div class="custom-gradient-label"><span>Свой градиент</span><small>Можно донастроить любой готовый вариант</small></div>
    <div class="color-editor-grid">
      <label><span>Цвет 1</span><input id="gradient-c1" type="color" value="#f1f0ec"></label>
      <label><span>Цвет 2</span><input id="gradient-c2" type="color" value="#dedbd4"></label>
      <label><span>Цвет 3</span><input id="gradient-c3" type="color" value="#b8b4ab"></label>
      <label><span>Акцент</span><input id="custom-accent" type="color" value="#1d1d1b"></label>
    </div>
    <label class="gradient-angle-label"><span>Направление <b id="gradient-angle-value">145°</b></span><input id="gradient-angle" type="range" min="0" max="360" value="145"></label>
    <div class="gradient-css-row"><input id="gradient-css" readonly><button id="copy-gradient-btn" class="ghost-btn">Копировать</button></div>
    <div class="color-dialog-actions"><button class="ghost-btn" id="reset-colors-btn">Сбросить</button><button class="glass-btn" id="apply-colors-btn">Применить</button></div>
    <p class="notice">Выбери пресет или собери свой градиент. Настройка сохраняется в браузере.</p>
  </section>

  <section class="dialog glass compact hidden" id="sync-dialog">
    <div class="dialog-head"><div><p class="eyebrow">ORBIT SYNC / TEST</p><h3>Перенос пространства</h3></div><button data-close-sync>×</button></div>
    <div class="sync-status"><strong>Облако пока не подключено</strong><span>Настоящий аккаунт Google/email потребует backend. В тестовой ветке доступен безопасный экспорт и импорт профиля.</span></div>
    <div class="sync-grid"><button class="glass-btn" id="export-profile-btn">Экспорт профиля</button><button class="glass-btn" id="import-profile-btn">Импорт профиля</button></div>
    <input class="profile-file" id="profile-file" type="file" accept="application/json,.json" />
    <p class="notice">Профиль включает избранное, свои сайты, коллекции, режимы, задачи, статистику, заметки, игровые рекорды и рабочую презентацию.</p>
  </section>

  <section class="game-modal glass hidden" id="game-modal">
    <div class="game-modal-head"><div><p class="eyebrow" id="game-kicker">ORBIT PLAY</p><h3 id="game-modal-title">Игра</h3></div><div><span class="score-chip" id="game-score">0</span><button id="replay-game" title="Играть снова">↻</button><button id="close-game">×</button></div></div>
    <div id="game-stage"></div>
  </section>

  <section class="present-overlay hidden" id="present-overlay"><button id="close-present">×</button><div id="present-slide"></div><div class="present-controls"><button id="present-prev">←</button><span id="present-index"></span><button id="present-next">→</button></div></section>

  <div class="toast" id="toast" aria-live="polite"></div>
  <script>
const $ = (s, root=document) => root.querySelector(s);
const $$ = (s, root=document) => [...root.querySelectorAll(s)];
const LS = {
  theme:'orbit.theme', favs:'orbit.favs', custom:'orbit.customSites', scores:'orbit.gameScores', deck:'orbit.deck', collections:'orbit.collections', usage:'orbit.usage', focus:'orbit.focusMode', markdown:'orbit.markdown', quick:'orbit.quickState', mode:'orbit.desktopMode', tasks:'orbit.tasks', aiChats:'orbit.aiChats', aiActive:'orbit.aiActive', appearance:'orbit.appearance'
};
const escapeHtml = (s='') => String(s).replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
const safeUrl = (url='') => { try { const u = new URL(/^https?:\/\//i.test(url)?url:`https://${url}`); return ['http:','https:'].includes(u.protocol)?u.href:'#'; } catch { return '#'; } };
const toast = (msg) => { const el=$('#toast'); el.textContent=msg; el.classList.add('show'); clearTimeout(toast.t); toast.t=setTimeout(()=>el.classList.remove('show'),1800); };

const sites = [
  ['YouTube','Видео, каналы и трансляции','youtube.com','Видео и музыка'],
  ['ChatGPT','Идеи, тексты и повседневные задачи','chatgpt.com','ИИ-ассистенты'],
  ['Telegram','Сообщения, каналы и сообщества','web.telegram.org','Общение'],
  ['Steam','Игры и сообщество игроков','store.steampowered.com','Игры'],
  ['Spotify','Музыка и подкасты','open.spotify.com','Видео и музыка'],
  ['Twitch','Стримы и живые трансляции','twitch.tv','Видео и музыка'],
  ['Discord','Чаты, голос и игровые сообщества','discord.com','Общение'],
  ['ВКонтакте','Друзья, сообщества и общение','vk.com','Общение'],
  ['Epic Games','Магазин компьютерных игр','store.epicgames.com','Игры'],
  ['Wikipedia','Свободная энциклопедия','wikipedia.org','Учёба'],
  ['Google','Поиск по всему интернету','google.com','Поиск и сервисы'],
  ['Яндекс','Поиск и сервисы Яндекса','ya.ru','Поиск и сервисы'],
  ['Claude','Тексты, документы и код','claude.ai','ИИ-ассистенты'],
  ['Gemini','ИИ-ассистент Google','gemini.google.com','ИИ-ассистенты'],
  ['DeepSeek','Рассуждения, задачи и код','chat.deepseek.com','ИИ-ассистенты'],
  ['Perplexity','Ответы и поиск с источниками','perplexity.ai','ИИ-ассистенты'],
  ['Grok','Диалог, поиск и изображения','grok.com','ИИ-ассистенты'],
  ['Copilot','ИИ-помощник Microsoft','copilot.microsoft.com','ИИ-ассистенты'],
  ['Mistral AI','Ассистент от Mistral','chat.mistral.ai','ИИ-ассистенты'],
  ['Qwen','Чат с моделями Qwen','chat.qwen.ai','ИИ-ассистенты'],
  ['Kimi','Документы, исследования и код','kimi.com','ИИ-ассистенты'],
  ['Poe','Разные ИИ в одном месте','poe.com','ИИ-ассистенты'],
  ['NotebookLM','Работа с источниками и заметками','notebooklm.google.com','ИИ-ассистенты'],
  ['Google AI Studio','Эксперименты с ИИ Google','aistudio.google.com','ИИ-ассистенты'],
  ['Hugging Face','Модели, демо и сообщество','huggingface.co','ИИ-ассистенты'],
  ['GigaChat','Русскоязычный ИИ-ассистент','giga.chat','ИИ-ассистенты'],
  ['Алиса','ИИ-помощник от Яндекса','alice.yandex.ru','ИИ-ассистенты'],
  ['Midjourney','Генерация изображений','midjourney.com','ИИ для творчества'],
  ['Leonardo.Ai','Изображения и визуальные идеи','leonardo.ai','ИИ для творчества'],
  ['Ideogram','Изображения, надписи и дизайн','ideogram.ai','ИИ для творчества'],
  ['Recraft','Изображения и векторная графика','recraft.ai','ИИ для творчества'],
  ['Krea','Изображения, видео и улучшение','krea.ai','ИИ для творчества'],
  ['Adobe Firefly','Генеративные инструменты Adobe','firefly.adobe.com','ИИ для творчества'],
  ['Runway','Генерация и обработка видео','runwayml.com','ИИ для творчества'],
  ['Pika','Видео из твоих идей','pika.art','ИИ для творчества'],
  ['Kling AI','Создание видео с ИИ','klingai.com','ИИ для творчества'],
  ['Luma','Визуальные истории и видео','lumalabs.ai','ИИ для творчества'],
  ['Suno','Песни и музыка по описанию','suno.com','ИИ для творчества'],
  ['ElevenLabs','Голоса, озвучка и аудио','elevenlabs.io','ИИ для творчества'],
  ['SoundCloud','Музыка и независимые артисты','soundcloud.com','Видео и музыка'],
  ['Яндекс Музыка','Треки, подкасты и рекомендации','music.yandex.ru','Видео и музыка'],
  ['VK Видео','Видео, шоу и трансляции','vkvideo.ru','Видео и музыка'],
  ['RUTUBE','Каналы, ролики и эфиры','rutube.ru','Видео и музыка'],
  ['Кинопоиск','Фильмы, сериалы и оценки','kinopoisk.ru','Видео и музыка'],
  ['Reddit','Обсуждения и сообщества','reddit.com','Общение'],
  ['WhatsApp','Сообщения и связь','web.whatsapp.com','Общение'],
  ['Pinterest','Визуальные идеи и вдохновение','pinterest.com','Дизайн'],
  ['GOG','Игры и классика для ПК','gog.com','Игры'],
  ['itch.io','Независимые игры и проекты','itch.io','Игры'],
  ['Xbox','Игры и экосистема Xbox','xbox.com','Игры'],
  ['Chess.com','Шахматы и задачи','chess.com','Игры'],
  ['Lichess','Онлайн-шахматы','lichess.org','Игры'],
  ['Roblox','Игры и виртуальные миры','roblox.com','Игры'],
  ['Khan Academy','Уроки и практические задания','khanacademy.org','Учёба'],
  ['Coursera','Онлайн-курсы по разным темам','coursera.org','Учёба'],
  ['Stepik','Курсы и интерактивные задания','stepik.org','Учёба'],
  ['Duolingo','Изучение иностранных языков','duolingo.com','Учёба'],
  ['Quizlet','Учебные карточки и повторение','quizlet.com','Учёба'],
  ['WolframAlpha','Вычисления и ответы на задачи','wolframalpha.com','Учёба'],
  ['TED','Идеи, выступления и лекции','ted.com','Учёба'],
  ['Figma','Интерфейсы и совместный дизайн','figma.com','Дизайн'],
  ['Canva','Презентации и визуальные материалы','canva.com','Дизайн'],
  ['Behance','Портфолио и творческие проекты','behance.net','Дизайн'],
  ['Dribbble','Идеи для интерфейсов и графики','dribbble.com','Дизайн'],
  ['Unsplash','Фотографии для вдохновения','unsplash.com','Дизайн'],
  ['Pexels','Фотографии и видеоматериалы','pexels.com','Дизайн'],
  ['Photopea','Редактор изображений в браузере','photopea.com','Дизайн'],
  ['Google Fonts','Коллекция шрифтов','fonts.google.com','Дизайн'],
  ['GitHub','Код, проекты и совместная работа','github.com','Разработка'],
  ['Stack Overflow','Ответы на вопросы о коде','stackoverflow.com','Разработка'],
  ['MDN Web Docs','Документация по веб-разработке','developer.mozilla.org','Разработка'],
  ['CodePen','Эксперименты с HTML, CSS и JS','codepen.io','Разработка'],
  ['Replit','Создание приложений в браузере','replit.com','Разработка'],
  ['Cursor','Редактор кода с ИИ','cursor.com','Разработка'],
  ['v0','Создание интерфейсов с ИИ','v0.app','Разработка'],
  ['Bolt','Создание веб-приложений с ИИ','bolt.new','Разработка'],
  ['Vercel','Размещение веб-проектов','vercel.com','Разработка'],
  ['Notion','Заметки, документы и проекты','notion.so','Работа'],
  ['Trello','Доски и задачи','trello.com','Работа'],
  ['Todoist','Задачи и личные планы','todoist.com','Работа'],
  ['Google Drive','Файлы и совместный доступ','drive.google.com','Работа'],
  ['Google Docs','Документы и совместная работа','docs.google.com','Работа'],
  ['Google Sheets','Таблицы и расчёты','sheets.google.com','Работа'],
  ['Gmail','Почта от Google','mail.google.com','Работа'],
  ['Google Calendar','Планы, события и встречи','calendar.google.com','Работа'],
  ['Miro','Совместные доски и схемы','miro.com','Работа'],
  ['Zoom','Видеовстречи и общение','zoom.us','Работа'],
  ['Bing','Поиск Microsoft','bing.com','Поиск и сервисы'],
  ['DuckDuckGo','Поиск в интернете','duckduckgo.com','Поиск и сервисы'],
  ['DeepL','Перевод текстов и документов','deepl.com','Поиск и сервисы'],
  ['Google Translate','Перевод между языками','translate.google.com','Поиск и сервисы'],
  ['Google Maps','Места, карты и маршруты','maps.google.com','Поиск и сервисы'],
  ['Яндекс Карты','Карты, места и маршруты','yandex.ru/maps','Поиск и сервисы'],
  ['2ГИС','Справочник и городские карты','2gis.ru','Поиск и сервисы']
].map((s,i)=>({id:`site-${i}`,name:s[0],description:s[1],domain:s[2],category:s[3],url:`https://${s[2]}`}));

const categories = ['Все сайты','Избранное','ИИ-ассистенты','ИИ для творчества','Видео и музыка','Общение','Игры','Учёба','Дизайн','Разработка','Работа','Поиск и сервисы'];
const defaultFavs = new Set(['site-0','site-1','site-2','site-3']);
let favs = new Set(JSON.parse(localStorage.getItem(LS.favs)||'null') || [...defaultFavs]);
let customSites = JSON.parse(localStorage.getItem(LS.custom)||'[]');
let collections = JSON.parse(localStorage.getItem(LS.collections)||'[]');
let usage = JSON.parse(localStorage.getItem(LS.usage)||'{}');
let currentCategory = 'Все сайты';
let currentCollection = null;
let siteQuery = '';
let focusMode = localStorage.getItem(LS.focus)==='1';

function allSites(){ return [...sites,...customSites]; }
function initials(name){ return name.split(/\s+/).map(x=>x[0]).join('').slice(0,2).toUpperCase(); }
function collectionById(id){ return collections.find(c=>c.id===id); }
function previewUrl(s){ return `https://image.thum.io/get/width/640/crop/360/noanimate/${safeUrl(s.url)}`; }
function isEntertainment(s){ return ['Игры','Видео и музыка'].includes(s.category); }
function recordUsage(s){
  const rec=usage[s.id]||{count:0,last:0}; rec.count++; rec.last=Date.now(); usage[s.id]=rec;
  localStorage.setItem(LS.usage,JSON.stringify(usage)); renderFrequently();
}
function openSite(s){ if(!s)return; recordUsage(s); window.open(safeUrl(s.url),'_blank','noopener'); }
function renderFrequently(){
  const el=$('#frequent-list'); if(!el)return;
  const top=allSites().filter(s=>usage[s.id]?.count).sort((a,b)=>(usage[b.id].count-usage[a.id].count)||(usage[b.id].last-usage[a.id].last)).slice(0,5);
  el.innerHTML=top.length?top.map(s=>`<button class="frequent-chip" data-open-site="${s.id}"><b>${escapeHtml(s.name)}</b><small>${usage[s.id].count}×</small></button>`).join(''):'<span class="site-domain">Пока данных нет — открой несколько сайтов.</span>';
  $$('[data-open-site]',el).forEach(b=>b.onclick=()=>openSite(allSites().find(s=>s.id===b.dataset.openSite)));
}
function renderCollections(){
  const el=$('#collection-strip'); if(!el)return;
  if(!collections.length){el.innerHTML='<span class="site-domain">Создай «Учёба», «Проект X» или «Утро», затем перетащи сюда карточки.</span>';return;}
  el.innerHTML=collections.map(c=>`<button class="collection-pill ${currentCollection===c.id?'active':''}" data-collection="${c.id}">${escapeHtml(c.name)} <small>${c.sites.length}</small><span class="collection-delete" data-delete-collection="${c.id}" title="Удалить">×</span></button>`).join('');
  $$('.collection-pill',el).forEach(b=>{
    b.onclick=e=>{if(e.target.closest('[data-delete-collection]'))return;currentCollection=b.dataset.collection;currentCategory='Все сайты';renderCollections();renderCategories();renderSites();};
    b.ondragover=e=>{e.preventDefault();b.classList.add('dragover')}; b.ondragleave=()=>b.classList.remove('dragover');
    b.ondrop=e=>{e.preventDefault();b.classList.remove('dragover');const id=e.dataTransfer.getData('text/orbit-site');const c=collectionById(b.dataset.collection);if(c&&id&&!c.sites.includes(id)){c.sites.push(id);saveCollections();renderCollections();if(currentCollection===c.id)renderSites();toast(`Добавлено в «${c.name}»`);}};
  });
  $$('[data-delete-collection]',el).forEach(x=>x.onclick=e=>{e.stopPropagation();const id=x.dataset.deleteCollection,c=collectionById(id);if(!c)return;if(!confirm(`Удалить коллекцию «${c.name}»? Сами сайты останутся.`))return;collections=collections.filter(v=>v.id!==id);if(currentCollection===id)currentCollection=null;saveCollections();renderCollections();renderCategories();renderSites();});
}
function saveCollections(){localStorage.setItem(LS.collections,JSON.stringify(collections));}
function renderCategories(){
  const el=$('#categories');
  el.innerHTML=categories.map(cat=>{
    let n = cat==='Все сайты'?allSites().length:cat==='Избранное'?allSites().filter(s=>favs.has(s.id)).length:allSites().filter(s=>s.category===cat).length;
    return `<button class="category-btn ${!currentCollection&&cat===currentCategory?'active':''}" data-cat="${escapeHtml(cat)}">${escapeHtml(cat)} <small>${n}</small></button>`
  }).join('');
  $$('.category-btn',el).forEach(b=>b.onclick=()=>{ currentCollection=null;currentCategory=b.dataset.cat; renderCollections();renderCategories(); renderSites(); });
}
function ensurePreview(card,s){
  const p=$('.site-preview',card);if(!p||p.dataset.loaded)return;p.dataset.loaded='1';
  const img=new Image();img.loading='lazy';img.referrerPolicy='no-referrer';img.alt='';img.onload=()=>{p.prepend(img);p.classList.add('ready')};img.onerror=()=>{p.classList.add('ready');p.classList.add('fallback')};img.src=previewUrl(s);
}

function sitesForSection(cat){
  let arr=allSites();
  const modeCats=modeConfig?.[desktopMode]?.cats;
  if(modeCats && cat==='Все сайты' && !currentCollection) arr=arr.filter(s=>modeCats.includes(s.category));
  if(focusMode) arr=arr.filter(s=>!isEntertainment(s));
  if(currentCollection){
    const c=collectionById(currentCollection);
    arr=arr.filter(s=>c?.sites.includes(s.id));
  }else if(cat!=='Все сайты'){
    arr=arr.filter(s=>cat==='Избранное' ? favs.has(s.id) : s.category===cat);
  }
  return arr;
}

let expandedSection = null;



function workCleanText(t){
  return (t||'')
    .replace(/\s+/g,' ')
    .replace(/\s+([,.;:!?])/g,'$1')
    .replace(/\(\s+/g,'(')
    .replace(/\s+\)/g,')')
    .trim()
    .replace(/(^|[.!?]\s+)([a-zа-яё])/giu,(m,p1,p2)=>p1+p2.toUpperCase());
}
function workSentences(t){
  return workCleanText(t).split(/(?<=[.!?])\s+/).map(v=>v.trim()).filter(Boolean);
}
function workWords(t){
  return workCleanText(t).split(/\s+/).filter(Boolean);
}
function workSubject(t){
  const words=workWords(t).filter(w=>w.length>3);
  return words.slice(0,4).join(' ') || 'теме';
}
let orbitPresentation = window.orbitPresentation || {
  slides:[{title:'ORBIT — презентация', bullets:['Главная идея проекта','Почему это удобно','Какой следующий шаг']}],
  current:0
};
window.orbitPresentation = orbitPresentation;

function ensurePresentation(){
  if(!orbitPresentation.slides.length){
    orbitPresentation.slides=[{title:'Новый слайд', bullets:['Главная мысль']}];
    orbitPresentation.current=0;
  }
  if(orbitPresentation.current<0) orbitPresentation.current=0;
  if(orbitPresentation.current>=orbitPresentation.slides.length) orbitPresentation.current=orbitPresentation.slides.length-1;
}
function currentSlide(){
  ensurePresentation();
  return orbitPresentation.slides[orbitPresentation.current];
}
function parseBullets(txt){
  return (txt||'').split(/\n+/).map(v=>v.replace(/^[-•\d.)\s]+/,'').trim()).filter(Boolean);
}
function updatePresentationUI(){
  const titleEl = $('#pres-slide-title');
  const bulletsEl = $('#pres-slide-bullets');
  const titlePrev = $('#pres-preview-title');
  const listPrev = $('#pres-preview-list');
  const countEl = $('#pres-slide-counter');
  if(!titleEl || !bulletsEl || !titlePrev || !listPrev) return;
  const slide = currentSlide();
  titleEl.value = slide.title || '';
  bulletsEl.value = (slide.bullets||[]).join('\n');
  titlePrev.textContent = slide.title || 'Новый слайд';
  listPrev.innerHTML = (slide.bullets||[]).map(v=>`<li>${escapeHtml(v)}</li>`).join('') || '<li>Добавь пункты для слайда</li>';
  if(countEl) countEl.textContent = `Слайд ${orbitPresentation.current+1} / ${orbitPresentation.slides.length}`;
  $$('.slide-tab').forEach((tab,idx)=>tab.classList.toggle('active', idx===orbitPresentation.current));
}
function rebuildSlideTabs(){
  const wrap = $('#pres-slide-tabs');
  if(!wrap) return;
  ensurePresentation();
  wrap.innerHTML = orbitPresentation.slides.map((s,idx)=>`<button class="slide-tab ${idx===orbitPresentation.current?'active':''}" data-slide-idx="${idx}">${idx+1}. ${escapeHtml((s.title||'Слайд').slice(0,18))}</button>`).join('');
  $$('[data-slide-idx]',wrap).forEach(btn=>{
    btn.onclick=(e)=>{
      e.stopPropagation();
      orbitPresentation.current = +btn.dataset.slideIdx;
      updatePresentationUI();
      rebuildSlideTabs();
    };
  });
}
function saveCurrentSlideFromInputs(){
  const slide = currentSlide();
  const titleEl = $('#pres-slide-title');
  const bulletsEl = $('#pres-slide-bullets');
  if(!titleEl || !bulletsEl) return;
  slide.title = workCleanText(titleEl.value || '') || 'Новый слайд';
  slide.bullets = parseBullets(bulletsEl.value || '');
  updatePresentationUI();
  rebuildSlideTabs();
}
function presentationAddSlide(){
  saveCurrentSlideFromInputs();
  orbitPresentation.slides.push({title:'Новый слайд', bullets:['Главная мысль','Подробность','Вывод']});
  orbitPresentation.current = orbitPresentation.slides.length-1;
  rebuildSlideTabs();
  updatePresentationUI();
}
function presentationDeleteSlide(){
  if(orbitPresentation.slides.length<=1){ toast('Нужен хотя бы один слайд'); return; }
  orbitPresentation.slides.splice(orbitPresentation.current,1);
  if(orbitPresentation.current>=orbitPresentation.slides.length) orbitPresentation.current=orbitPresentation.slides.length-1;
  rebuildSlideTabs();
  updatePresentationUI();
}
function presentationDuplicateSlide(){
  const slide = currentSlide();
  orbitPresentation.slides.splice(orbitPresentation.current+1,0,{title:(slide.title||'Слайд')+' копия', bullets:[...(slide.bullets||[])]});
  orbitPresentation.current += 1;
  rebuildSlideTabs();
  updatePresentationUI();
}
function workApplyTool(kind){
  const input = $('#work-lab-input');
  const output = $('#work-lab-output');
  if(!input || !output) return;
  const raw = input.value || '';
  const text = workCleanText(raw);
  let result = '';
  if(!text && !['plan','cta'].includes(kind)){
    result = 'Сначала вставь текст для обработки, а потом выбери инструмент.';
    output.textContent = result;
    return;
  }
  const sentences = workSentences(text);

  switch(kind){
    case 'fix':
      result = text || 'Текст уже выглядит аккуратно.';
      break;
    case 'short':
      result = sentences.length ? sentences.slice(0,2).join(' ') : text.split(/\s+/).slice(0,18).join(' ');
      if(result && !/[.!?]$/.test(result)) result += '.';
      break;
    case 'bullets': {
      const parts = (sentences.length ? sentences : text.split(/[;,]/)).map(v=>v.trim()).filter(Boolean).slice(0,6);
      result = parts.map(v=>'• ' + v.replace(/[.!?]+$/,'')).join('\n');
      break;
    }
    case 'title': {
      const subject = workSubject(text).replace(/[.!?]/g,'');
      result = subject.split(/\s+/).slice(0,5).map((w,i)=>i===0?w.charAt(0).toUpperCase()+w.slice(1):w).join(' ') || 'Новый слайд';
      break;
    }
    case 'plan': {
      const subject = workSubject(text);
      result = [
        'Слайд 1 — Тема: ' + (subject || 'Введение'),
        'Слайд 2 — Главная проблема или задача',
        'Слайд 3 — Решение / основная идея',
        'Слайд 4 — Преимущества, факты или примеры',
        'Слайд 5 — Итог и следующий шаг'
      ].join('\n');
      break;
    }
    case 'key': {
      const parts = (sentences.length ? sentences : [text]).slice(0,4);
      result = parts.map((v,i)=>`${i+1}. ${v.replace(/[.!?]+$/,'')}`).join('\n');
      break;
    }
    case 'strong': {
      const base = sentences[0] || text;
      result = 'Ключевая мысль: ' + base.replace(/[.!?]+$/,'') + '.\n\nПочему это важно:\n• Экономит время\n• Делает подачу понятнее\n• Помогает быстрее донести идею';
      break;
    }
    case 'cta':
      result = 'Спасибо за внимание!\n\n• Готов ответить на вопросы\n• Следующий шаг: согласовать план / принять решение\n• Контакт / действие: написать, утвердить, запустить';
      break;
    case 'to-slide': {
      const slide = currentSlide();
      slide.title = workSubject(text).split(/\s+/).slice(0,5).map((w,i)=>i===0?w.charAt(0).toUpperCase()+w.slice(1):w).join(' ') || 'Новый слайд';
      slide.bullets = (sentences.length ? sentences : text.split(/[;,]/)).map(v=>v.trim()).filter(Boolean).slice(0,5).map(v=>v.replace(/[.!?]+$/,''));
      rebuildSlideTabs();
      updatePresentationUI();
      result = 'Текст перенесён в текущий слайд.';
      break;
    }
    default:
      result = text;
  }
  output.textContent = result;
}
function workUpdateStats(){
  const input = $('#work-lab-input');
  if(!input) return;
  const txt = input.value || '';
  const words = txt.trim() ? txt.trim().split(/\s+/).length : 0;
  const chars = txt.length;
  const lines = txt ? txt.split(/\n/).length : 0;
  const wordsEl = $('#work-stat-words');
  const charsEl = $('#work-stat-chars');
  const linesEl = $('#work-stat-lines');
  if(wordsEl) wordsEl.textContent = words + ' слов';
  if(charsEl) charsEl.textContent = chars + ' символов';
  if(linesEl) linesEl.textContent = lines + ' строк';
}
function simpleStudyTool(kind){
  const input=$('#study-input'), out=$('#study-output');
  if(!input||!out) return;
  const text=workCleanText(input.value||'');
  if(!text){ out.textContent='Вставь тему, параграф или вопрос для обработки.'; return; }
  const s=workSentences(text);
  let result='';
  if(kind==='easy'){
    result='Простыми словами:\n' + (s[0]||text) + (s[1]?'\n\nГлавная идея: '+s[1]:'');
  }else if(kind==='summary'){
    result=(s.slice(0,3).map((v,i)=>`${i+1}. ${v.replace(/[.!?]+$/,'')}`).join('\n')) || text;
  }else if(kind==='cards'){
    const parts=(s.length?s:text.split(/[;,]/)).map(v=>v.trim()).filter(Boolean).slice(0,4);
    result=parts.map((v,i)=>`Карточка ${i+1}:\nВопрос: Что значит "${v.slice(0,36)}..."?\nОтвет: ${v}`).join('\n\n');
  }else if(kind==='questions'){
    const subject=workSubject(text);
    result=['• Что такое ' + subject + '?','• Почему это важно?','• Какие есть примеры?','• Где это применяется?'].join('\n');
  }else if(kind==='repeat'){
    result=['Сегодня: прочитать и понять тему','Через 1 день: коротко пересказать','Через 3 дня: ответить на вопросы','Через 7 дней: повторить по карточкам'].join('\n');
  }else{
    result=text;
  }
  out.textContent=result;
}
function simpleDevTool(kind){
  const input=$('#dev-input'), out=$('#dev-output');
  if(!input||!out) return;
  const text=input.value||'';
  const clean=workCleanText(text);
  if(!clean){ out.textContent='Вставь код, ошибку или описание задачи.'; return; }
  let result='';
  if(kind==='explain'){
    result='Что делает код:\n' + clean.split(/(?<=[.;{}])\s+/).slice(0,5).map((v,i)=>`${i+1}. ${v}`).join('\n');
  }else if(kind==='debug'){
    result='Возможные причины ошибки:\n• Неверные переменные или данные\n• Пропущенная проверка на null/undefined\n• Ошибка в условиях или циклах\n• Неправильный порядок вызовов';
  }else if(kind==='steps'){
    result=['1. Определи входные данные','2. Разбей задачу на функции','3. Проверь крайние случаи','4. Протестируй результат'].join('\n');
  }else if(kind==='pseudo'){
    result='Псевдокод:\nНАЧАТЬ\n  получить данные\n  обработать данные\n  вернуть результат\nКОНЕЦ';
  }else if(kind==='comment'){
    result='Комментарий к коду:\n// Шаг 1: получить входные данные\n// Шаг 2: обработать и проверить\n// Шаг 3: вернуть результат';
  }else if(kind==='check'){
    result=['• Названия переменных понятные','• Есть обработка ошибок','• Код разбит на части','• Есть тестовый пример'].join('\n');
  }else{
    result=clean;
  }
  out.textContent=result;
}
async function copyFromSelector(sel, success='Скопировано'){
  const el=$(sel);
  const val=el?.textContent?.trim()||'';
  if(!val) return;
  try{ await navigator.clipboard.writeText(val); toast(success); }catch{ toast('Не удалось скопировать'); }
}

let orbitProjects = JSON.parse(localStorage.getItem('orbitProjects') || '[]');

function saveOrbitProject(){
  const name = $('#project-name')?.value.trim() || 'Новый проект';
  saveCurrentSlideFromInputs();
  const project = {
    id: Date.now(),
    name,
    date: new Date().toLocaleString(),
    presentation: JSON.parse(JSON.stringify(orbitPresentation))
  };
  orbitProjects.unshift(project);
  localStorage.setItem('orbitProjects', JSON.stringify(orbitProjects));
  renderProjects();
  toast('Проект сохранён');
}

function loadOrbitProject(id){
  const project = orbitProjects.find(p=>p.id===id);
  if(!project) return;
  orbitPresentation = JSON.parse(JSON.stringify(project.presentation));
  window.orbitPresentation = orbitPresentation;
  rebuildSlideTabs();
  updatePresentationUI();
  toast('Проект открыт');
}

function renderProjects(){
  const box = $('#project-list');
  if(!box) return;
  box.innerHTML = orbitProjects.length
    ? orbitProjects.map(p=>`
      <div class="project-item">
        <span><b>${escapeHtml(p.name)}</b><br><small>${escapeHtml(p.date)}</small></span>
        <button data-load-project="${p.id}">Открыть</button>
      </div>`).join('')
    : '<div class="section-hint">Сохранённых проектов пока нет</div>';

  $$('[data-load-project]',box).forEach(btn=>{
    btn.onclick=(e)=>{
      e.stopPropagation();
      loadOrbitProject(+btn.dataset.loadProject);
    };
  });
}

function renderSectionCards(){
  const grid=$('#site-grid');
  const sectionIcons={
    'Все сайты':'◎',
    'Избранное':'★',
    'ИИ-ассистенты':'ИИ',
    'ИИ для творчества':'✦',
    'Видео и музыка':'▶',
    'Общение':'✉',
    'Игры':'🎮',
    'Учёба':'📚',
    'Дизайн':'◈',
    'Разработка':'⌘',
    'Работа':'▣',
    'Поиск и сервисы':'⌕'
  };
  const sectionDescriptions={
    'Все сайты':'Все направления ORBIT в одном месте',
    'Избранное':'Твои самые важные и сохранённые сайты',
    'ИИ-ассистенты':'Чаты, модели и умные помощники',
    'ИИ для творчества':'Генерация изображений, видео и идей',
    'Видео и музыка':'Стриминг, ролики и любимые треки',
    'Общение':'Мессенджеры, сообщества и социальные сети',
    'Игры':'Игры, магазины и развлечения',
    'Учёба':'Знания, уроки, повторение и заметки',
    'Дизайн':'Редакторы, макеты и вдохновение',
    'Разработка':'Код, IDE, документация и проекты',
    'Работа':'Задачи, офис, презентации и команды',
    'Поиск и сервисы':'Поиск, карты, перевод и полезные сервисы'
  };
  const sections=categories.map(cat=>{
    const arr=sitesForSection(cat);
    const isOpen=expandedSection===cat;
    const shown=isOpen?arr.slice(0,8):arr.slice(0,4);
    const isWork = cat==='Работа' && isOpen;
    const isStudy = cat==='Учёба' && isOpen;
    const isDev = cat==='Разработка' && isOpen;
    return `<article class="section-card ${isOpen?'open':''}" data-section="${escapeHtml(cat)}">
      <div>
        <div class="section-card-top">
          <div class="section-icon">${escapeHtml(sectionIcons[cat]||cat.slice(0,1))}</div>
          <div class="section-count">${arr.length}</div>
        </div>
        <div>
          <h3>${escapeHtml(cat)}</h3>
          <p>${escapeHtml(sectionDescriptions[cat]||'Раздел ORBIT')}</p>
        </div>
      </div>
      <div class="section-meta">
        <div class="section-hint">${isOpen?'Нажми на сайт внутри карточки':'Нажми, чтобы раскрыть раздел'}</div>
        ${isOpen?`<button class="section-openall" data-openall="${escapeHtml(cat)}">Показать все</button>`:''}
      </div>

      ${isWork ? `
      <div class="work-lab">
        <div class="work-lab-grid">
          <div class="work-editor">
            <h4>Черновик для презентации</h4>
            <textarea id="work-lab-input" class="work-textarea" placeholder="Вставь сюда идею, черновик слайда или описание проекта..."></textarea>
            <div class="work-stats">
              <span class="work-stat" id="work-stat-words">0 слов</span>
              <span class="work-stat" id="work-stat-chars">0 символов</span>
              <span class="work-stat" id="work-stat-lines">0 строк</span>
            </div>
            <div class="work-hint">Сначала обрабатывай текст, а потом переноси его в слайд через кнопку «В текущий слайд».</div>
          </div>
          <div class="work-tools-panel">
            <h4>Инструменты текста</h4>
            <div class="work-tools-grid">
              <button class="work-tool-btn" data-work-tool="fix"><b>Корректировка текста</b><span>Чище и аккуратнее</span></button>
              <button class="work-tool-btn" data-work-tool="short"><b>Сделать короче</b><span>Короткая версия для слайда</span></button>
              <button class="work-tool-btn" data-work-tool="bullets"><b>Разбить на пункты</b><span>Буллеты для презентации</span></button>
              <button class="work-tool-btn" data-work-tool="title"><b>Придумать заголовок</b><span>Название слайда</span></button>
              <button class="work-tool-btn" data-work-tool="plan"><b>План из 5 слайдов</b><span>Быстрая структура</span></button>
              <button class="work-tool-btn" data-work-tool="key"><b>Выделить главное</b><span>Ключевые мысли</span></button>
              <button class="work-tool-btn" data-work-tool="strong"><b>Усилить подачу</b><span>Сделать убедительнее</span></button>
              <button class="work-tool-btn" data-work-tool="to-slide"><b>В текущий слайд</b><span>Перенести текст в редактор</span></button>
            </div>
          </div>
        </div>
        <div class="work-output">
          <div class="work-output-top">
            <h4>Результат обработки</h4>
            <button class="work-copy-btn" data-copy-work-output>Копировать</button>
          </div>
          <div id="work-lab-output" class="work-output-box">Выбери инструмент справа — результат появится здесь.</div>
        </div>

        <div class="presentation-editor">
          <div class="slide-toolbar">
            <div class="slide-toolbar-top">
              <h4>Мини-редактор презентации</h4>
              <div style="display:flex; gap:8px; flex-wrap:wrap">
                <button class="inline-btn" id="pres-add-slide">+ Слайд</button>
                <button class="inline-btn" id="pres-dup-slide">Дубль</button>
                <button class="inline-btn" id="pres-del-slide">Удалить</button>
              </div>
            </div>
            <div id="pres-slide-counter" class="section-hint">Слайд 1 / 1</div>
            <div id="pres-slide-tabs" class="slide-tabs"></div>
          </div>
          <div class="presentation-layout">
            <div class="slide-editor-box">
              <div class="slide-editor-grid">
                <input id="pres-slide-title" class="slide-input" placeholder="Заголовок слайда" />
                <textarea id="pres-slide-bullets" class="slide-textarea" placeholder="Каждый пункт с новой строки"></textarea>
                <div style="display:flex; gap:8px; flex-wrap:wrap">
                  <button class="inline-btn" id="pres-save-slide">Сохранить</button>
                  <button class="inline-btn" id="pres-fill-out">Из результата в слайд</button>
                  <button class="inline-btn" id="pres-correct-text">Откорректировать текст</button>

                  <button class="inline-btn" id="pres-final-slide">Финальный слайд</button>
                  <div class="project-controls">
                    <input id="project-name" class="project-name" placeholder="Название проекта">
                    <button class="inline-btn" id="save-project">Сохранить проект</button>
                  </div>
                  <div id="project-list" class="project-list"></div>

                </div>
              </div>
            </div>
            <div class="slide-preview-box">
              <div class="slide-preview-top">
                <h4>Превью</h4>
                <button class="inline-btn" id="pres-copy-slide">Копировать слайд</button>
              </div>
              <div class="slide-preview">
                <div class="slide-preview-label">ORBIT PRESENTATION</div>
                <div id="pres-preview-title" class="slide-preview-title">ORBIT — презентация</div>
                <ul id="pres-preview-list" class="slide-preview-list"></ul>
              </div>
            </div>
          </div>
        </div>
      </div>` : ''}

      ${isStudy ? `
      <div class="study-wrap lab-wrap">
        <div class="study-lab">
          <div class="lab-head"><h4>Учебные инструменты</h4><span class="section-hint">Для конспекта, повторения и объяснений</span></div>
          <textarea id="study-input" class="lab-textarea" placeholder="Вставь тему, вопрос, параграф или кусок текста..."></textarea>
          <div class="tool-grid-2" style="margin-top:10px">
            <button class="work-tool-btn" data-study-tool="easy"><b>Объяснить проще</b><span>Простыми словами</span></button>
            <button class="work-tool-btn" data-study-tool="summary"><b>Краткий конспект</b><span>Сжать до сути</span></button>
            <button class="work-tool-btn" data-study-tool="cards"><b>Карточки</b><span>Вопрос / ответ</span></button>
            <button class="work-tool-btn" data-study-tool="questions"><b>Вопросы к себе</b><span>Для самопроверки</span></button>
            <button class="work-tool-btn" data-study-tool="repeat"><b>План повторения</b><span>На несколько дней</span></button>
            <button class="work-copy-btn" data-copy-study-output><b>Копировать результат</b><span>Быстро перенести</span></button>
          </div>
          <div class="lab-output" style="margin-top:12px">
            <h4>Результат</h4>
            <div id="study-output" class="lab-output-box">Здесь появится обработанный учебный материал.</div>
          </div>
        </div>
      </div>` : ''}

      ${isDev ? `
      <div class="dev-wrap lab-wrap">
        <div class="dev-lab">
          <div class="lab-head"><h4>Инструменты для разработки</h4><span class="section-hint">Для кода, ошибок и структуры проекта</span></div>
          <textarea id="dev-input" class="lab-textarea" placeholder="Вставь код, описание бага или задачу по разработке..."></textarea>
          <div class="tool-grid-2" style="margin-top:10px">
            <button class="work-tool-btn" data-dev-tool="explain"><b>Объяснить код</b><span>Что здесь происходит</span></button>
            <button class="work-tool-btn" data-dev-tool="debug"><b>Найти проблему</b><span>Идеи для дебага</span></button>
            <button class="work-tool-btn" data-dev-tool="steps"><b>Разбить на шаги</b><span>План реализации</span></button>
            <button class="work-tool-btn" data-dev-tool="pseudo"><b>Псевдокод</b><span>Упростить логику</span></button>
            <button class="work-tool-btn" data-dev-tool="comment"><b>Комментарии</b><span>Подсказки к коду</span></button>
            <button class="work-tool-btn" data-dev-tool="check"><b>Checklist</b><span>Что проверить</span></button>
          </div>
          <div class="lab-output" style="margin-top:12px">
            <div class="work-output-top">
              <h4>Результат</h4>
              <button class="work-copy-btn" data-copy-dev-output>Копировать</button>
            </div>
            <div id="dev-output" class="lab-output-box">Здесь появится разбор кода или подсказки по задаче.</div>
          </div>
        </div>
      </div>` : ''}

      <div class="section-mini-grid">
        ${shown.length?shown.map(s=>`<button class="section-mini-site" data-open-site-inline="${s.id}">
          <span class="mini-icon">${escapeHtml(initials(s.name))}</span>
          <span><b>${escapeHtml(s.name)}</b><small>${escapeHtml(s.domain)}</small></span>
        </button>`).join(''):`<div class="site-domain">Здесь пока пусто</div>`}
      </div>
    </article>`;
  }).join('');
  grid.innerHTML=sections;

  $$('.section-card',grid).forEach(card=>{
    card.onclick=(e)=>{
      if(e.target.closest('[data-open-site-inline]') || e.target.closest('[data-openall]') || e.target.closest('[data-work-tool]') || e.target.closest('[data-copy-work-output]') || e.target.closest('[data-copy-study-output]') || e.target.closest('[data-copy-dev-output]') || e.target.closest('[data-study-tool]') || e.target.closest('[data-dev-tool]') || e.target.closest('#work-lab-input') || e.target.closest('#study-input') || e.target.closest('#dev-input') || e.target.closest('#pres-slide-title') || e.target.closest('#pres-slide-bullets') || e.target.closest('.inline-btn') ) return;
      const cat=card.dataset.section;
      expandedSection = expandedSection===cat ? null : cat;
      renderSectionCards();
    };
  });
  $$('[data-open-site-inline]',grid).forEach(btn=>{
    btn.onclick=(e)=>{
      e.stopPropagation();
      const s=allSites().find(x=>x.id===btn.dataset.openSiteInline);
      if(s) openSite(s);
    };
  });
  $$('[data-openall]',grid).forEach(btn=>{
    btn.onclick=(e)=>{
      e.stopPropagation();
      currentCategory=btn.dataset.openall;
      expandedSection=null;
      renderSites();
    };
  });

  const workInput = $('#work-lab-input');
  if(workInput){
    workInput.addEventListener('input', workUpdateStats);
    workUpdateStats();
  }
  $$('[data-work-tool]',grid).forEach(btn=>{
    btn.onclick=(e)=>{ e.stopPropagation(); workApplyTool(btn.dataset.workTool); };
  });
  $$('[data-study-tool]',grid).forEach(btn=>{
    btn.onclick=(e)=>{ e.stopPropagation(); simpleStudyTool(btn.dataset.studyTool); };
  });
  $$('[data-dev-tool]',grid).forEach(btn=>{
    btn.onclick=(e)=>{ e.stopPropagation(); simpleDevTool(btn.dataset.devTool); };
  });
  const copyBtn = $('[data-copy-work-output]',grid);
  if(copyBtn) copyBtn.onclick=(e)=>{ e.stopPropagation(); copyFromSelector('#work-lab-output','Результат скопирован'); };
  const copyStudy = $('[data-copy-study-output]',grid);
  if(copyStudy) copyStudy.onclick=(e)=>{ e.stopPropagation(); copyFromSelector('#study-output','Учебный результат скопирован'); };
  const copyDev = $('[data-copy-dev-output]',grid);
  if(copyDev) copyDev.onclick=(e)=>{ e.stopPropagation(); copyFromSelector('#dev-output','Результат по разработке скопирован'); };

  if($('#pres-slide-title')){
    ensurePresentation();
    rebuildSlideTabs();
    updatePresentationUI();
    $('#pres-slide-title').oninput = saveCurrentSlideFromInputs;
    $('#pres-slide-bullets').oninput = saveCurrentSlideFromInputs;
    $('#pres-add-slide').onclick=(e)=>{e.stopPropagation(); presentationAddSlide();};
    $('#pres-dup-slide').onclick=(e)=>{e.stopPropagation(); presentationDuplicateSlide();};
    $('#pres-del-slide').onclick=(e)=>{e.stopPropagation(); presentationDeleteSlide();};
    $('#pres-save-slide').onclick=(e)=>{e.stopPropagation(); saveCurrentSlideFromInputs(); toast('Слайд сохранён');};
    $('#pres-correct-text').onclick=(e)=>{
      e.stopPropagation();
      const slide=currentSlide();
      slide.title=workCleanText(slide.title||'');
      slide.bullets=(slide.bullets||[]).map(v=>workCleanText(v));
      rebuildSlideTabs();
      updatePresentationUI();
      toast('Текст откорректирован');
    };
    $('#save-project').onclick=(e)=>{
      e.stopPropagation();
      saveOrbitProject();
    };
    renderProjects();

    $('#pres-fill-out').onclick=(e)=>{
      e.stopPropagation();
      const out = $('#work-lab-output')?.textContent?.trim() || '';
      if(!out){ toast('Сначала получи результат обработки'); return; }
      const slide = currentSlide();
      if(!slide.title || slide.title==='Новый слайд') slide.title = 'Слайд ' + (orbitPresentation.current+1);
      slide.bullets = parseBullets(out);
      rebuildSlideTabs(); updatePresentationUI(); toast('Результат перенесён в слайд');
    };
    $('#pres-final-slide').onclick=(e)=>{
      e.stopPropagation();
      const slide = currentSlide();
      slide.title = 'Спасибо за внимание';
      slide.bullets = ['Готов ответить на вопросы','Следующий шаг согласован','Контакты и обратная связь'];
      rebuildSlideTabs(); updatePresentationUI();
    };
    $('#pres-copy-slide').onclick=(e)=>{
      e.stopPropagation();
      const slide=currentSlide();
      copyFromSelector('#pres-preview-list'); 
      navigator.clipboard.writeText((slide.title||'') + '\n' + (slide.bullets||[]).map(v=>'• '+v).join('\n')).then(()=>toast('Слайд скопирован')).catch(()=>toast('Не удалось скопировать'));
    };
  }

  $('#site-empty').classList.add('hidden');
}


function renderSites(){
  const q=siteQuery.trim().toLowerCase();

  // Main home state: show 12 section cards instead of raw sites.
  if(!currentCollection && currentCategory==='Все сайты' && !q){
    renderSectionCards();
    return;
  }

  let arr=allSites();
  const modeCats=modeConfig?.[desktopMode]?.cats;
  if(modeCats && currentCategory==='Все сайты' && !currentCollection) arr=arr.filter(s=>modeCats.includes(s.category));
  if(focusMode)arr=arr.filter(s=>!isEntertainment(s));
  if(currentCollection){
    const c=collectionById(currentCollection);
    arr=arr.filter(s=>c?.sites.includes(s.id));
  } else {
    arr=arr.filter(s=> currentCategory==='Все сайты' || (currentCategory==='Избранное'?favs.has(s.id):s.category===currentCategory));
  }
  if(q) arr=arr.filter(s=>`${s.name} ${s.description} ${s.domain} ${s.category}`.toLowerCase().includes(q));

  const grid=$('#site-grid');
  grid.innerHTML=(currentCategory!=='Все сайты' && !currentCollection && !q ? `<article class="site-card" id="back-to-sections-card" style="cursor:pointer">
    <div class="site-card-top"><div class="site-icon">←</div></div>
    <div><h3>Назад к разделам</h3><p>Вернуться к 12 карточкам разделов на главной</p><div class="site-domain">ORBIT HOME</div></div>
  </article>` : '') + arr.map(s=>`<article class="site-card" data-id="${s.id}" draggable="true">
    <div class="site-preview"><div class="preview-caption"><strong>${escapeHtml(s.name)}</strong><small>${escapeHtml(s.domain)}</small></div></div>
    <div class="site-card-top"><button class="site-icon" data-direct-open="${s.id}" aria-label="Открыть ${escapeHtml(s.name)}">${escapeHtml(initials(s.name))}</button><div class="site-card-actions">${currentCollection?'<button class="remove-collection-btn" title="Убрать из коллекции">−</button>':''}<button class="fav-btn ${favs.has(s.id)?'active':''}" aria-label="Избранное">★</button></div></div>
    <div><h3>${escapeHtml(s.name)}</h3><p>${escapeHtml(s.description)}</p><div class="site-domain">${escapeHtml(s.domain)}</div></div>
  </article>`).join('');

  const back=$('#back-to-sections-card');
  if(back){
    back.onclick=()=>{
      currentCategory='Все сайты';
      expandedSection=null;
      renderCategories();
      renderSites();
    };
  }

  $$('.site-card[data-id]',grid).forEach(card=>{
    const s=allSites().find(x=>x.id===card.dataset.id);
    $('.fav-btn',card).onclick=(e)=>{ e.stopPropagation(); favs.has(s.id)?favs.delete(s.id):favs.add(s.id); localStorage.setItem(LS.favs,JSON.stringify([...favs])); updateCounts(); renderCategories(); renderSites(); };
    $('[data-direct-open]',card).onclick=e=>{e.stopPropagation();openSite(s)};
    const remove=$('.remove-collection-btn',card);if(remove)remove.onclick=e=>{e.stopPropagation();const c=collectionById(currentCollection);if(c){c.sites=c.sites.filter(id=>id!==s.id);saveCollections();renderCollections();renderSites();}};
    card.onclick=(e)=>{ if(e.target.closest('button')) return; openSite(s); };
    card.onmouseenter=()=>ensurePreview(card,s);
    card.ondragstart=e=>{card.classList.add('dragging');e.dataTransfer.setData('text/orbit-site',s.id);e.dataTransfer.effectAllowed='copy'};card.ondragend=()=>card.classList.remove('dragging');
  });
  $('#site-empty').classList.toggle('hidden',arr.length>0 || currentCategory!=='Все сайты');
}

function updateCounts(){ $('#site-count').textContent=allSites().length; $('#fav-count').textContent=allSites().filter(s=>favs.has(s.id)).length; }


// Theme
const savedTheme=localStorage.getItem(LS.theme);
if(savedTheme) document.documentElement.dataset.theme=savedTheme;
else if(matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.dataset.theme='dark';
$('#theme-btn').onclick=()=>{ const t=document.documentElement.dataset.theme==='dark'?'light':'dark'; document.documentElement.dataset.theme=t; localStorage.setItem(LS.theme,t); };

// Clock + weather + currency + focus mode + Pomodoro
function updateClock(){const now=new Date();$('#clock-time').textContent=now.toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'});$('#clock-date').textContent=now.toLocaleDateString('ru-RU',{weekday:'short',day:'numeric',month:'short'}).replace('.','');}
function weatherLabel(code){const map={0:'Ясно',1:'Преимущественно ясно',2:'Переменная облачность',3:'Пасмурно',45:'Туман',48:'Иней',51:'Морось',53:'Морось',55:'Сильная морось',61:'Небольшой дождь',63:'Дождь',65:'Сильный дождь',66:'Ледяной дождь',67:'Ледяной дождь',71:'Небольшой снег',73:'Снег',75:'Сильный снег',77:'Снежные зёрна',80:'Ливень',81:'Ливень',82:'Сильный ливень',85:'Снегопад',86:'Сильный снегопад',95:'Гроза',96:'Гроза с градом',99:'Сильная гроза'};return map[code]||'Погода';}
async function fetchWeatherFor(lat,lon,cityHint=''){
  const weatherUrl=`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code&timezone=auto`;
  const reverseUrl=`https://geocoding-api.open-meteo.com/v1/reverse?latitude=${lat}&longitude=${lon}&language=ru&count=1`;
  const [wr,rr]=await Promise.all([fetch(weatherUrl).then(r=>r.json()),fetch(reverseUrl).then(r=>r.json()).catch(()=>null)]);
  const temp=wr?.current?.temperature_2m,code=wr?.current?.weather_code,city=rr?.results?.[0]?.name||cityHint||'Рядом';
  $('#weather-temp').textContent=Number.isFinite(temp)?`${Math.round(temp)}°`:'—';
  $('#weather-desc').textContent=weatherLabel(code);
  $('#weather-city').textContent=city;
}
async function updateWeather(){
  $('#weather-desc').textContent='Определяем погоду…';
  try{
    if(!navigator.geolocation || location.protocol==='file:') throw new Error('no-geo');
    await new Promise((resolve,reject)=>navigator.geolocation.getCurrentPosition(async pos=>{try{await fetchWeatherFor(pos.coords.latitude,pos.coords.longitude);resolve()}catch(err){reject(err)}},reject,{enableHighAccuracy:false,timeout:4500,maximumAge:600000}));
  }catch{
    try{await fetchWeatherFor(55.7558,37.6173,'Москва')}
    catch{$('#weather-temp').textContent='—';$('#weather-desc').textContent='Нет данных';$('#weather-city').textContent='Погода недоступна'}
  }
}
async function updateRates(){
  try{
    const [usd,eur]=await Promise.all([fetch('https://api.frankfurter.app/latest?from=USD&to=RUB').then(r=>r.json()),fetch('https://api.frankfurter.app/latest?from=EUR&to=RUB').then(r=>r.json())]);
    const usdRate=usd?.rates?.RUB,eurRate=eur?.rates?.RUB;
    $('#fx-usd').textContent=Number.isFinite(usdRate)?usdRate.toFixed(2):'—';
    $('#fx-eur').textContent=Number.isFinite(eurRate)?eurRate.toFixed(2):'—';
    $('#fx-updated').textContent='Обновлено · '+new Date().toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'});
  }catch{$('#fx-usd').textContent='—';$('#fx-eur').textContent='—';$('#fx-updated').textContent='Курсы недоступны'}
}
updateClock();setInterval(updateClock,1000);updateWeather();setInterval(updateWeather,30*60*1000);updateRates();setInterval(updateRates,60*60*1000);
function setFocusMode(on){focusMode=!!on;document.body.classList.toggle('focus-mode',focusMode);$('#focus-btn').classList.toggle('active',focusMode);localStorage.setItem(LS.focus,focusMode?'1':'0');if(focusMode&&currentCategory&&['Игры','Видео и музыка'].includes(currentCategory))currentCategory='Все сайты';renderCategories();renderSites();toast(focusMode?'Режим работы включён':'Режим работы выключен');}
$('#focus-btn').onclick=()=>setFocusMode(!focusMode);document.body.classList.toggle('focus-mode',focusMode);$('#focus-btn').classList.toggle('active',focusMode);
let focusLeft=25*60,focusRunning=false,focusTimer=null;function drawFocusTime(){const m=Math.floor(focusLeft/60),sec=focusLeft%60;$('#focus-time').textContent=`${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;}function toggleFocusTimer(){focusRunning=!focusRunning;$('#focus-timer-toggle').textContent=focusRunning?'Пауза':'Старт';clearInterval(focusTimer);if(focusRunning)focusTimer=setInterval(()=>{focusLeft=Math.max(0,focusLeft-1);drawFocusTime();if(focusLeft===0){clearInterval(focusTimer);focusRunning=false;$('#focus-timer-toggle').textContent='Снова';toast('Фокус-сессия завершена');focusLeft=25*60;}},1000)}$('#focus-timer-toggle').onclick=toggleFocusTimer;drawFocusTime();



// Miroslav speech
const MIROSLAV_IDLE_LINES=['Хочу пиццы)','Мне скучно','Я толстый','Займемся чем нибудь?','Я уже красный'];
let miroslavSpeechTimer=null;
let miroslavIdleTimer=null;
let miroslavIdleQueue=[];
let miroslavLastIdle='';

function shuffleMiroslav(arr){
  const copy=[...arr];
  for(let i=copy.length-1;i>0;i--){
    const j=Math.floor(Math.random()*(i+1));
    [copy[i],copy[j]]=[copy[j],copy[i]];
  }
  return copy;
}
function nextMiroslavIdleLine(){
  if(!miroslavIdleQueue.length){
    miroslavIdleQueue=shuffleMiroslav(MIROSLAV_IDLE_LINES);
    if(miroslavIdleQueue.length>1 && miroslavIdleQueue[0]===miroslavLastIdle){
      miroslavIdleQueue.push(miroslavIdleQueue.shift());
    }
  }
  const line=miroslavIdleQueue.shift();
  miroslavLastIdle=line;
  return line;
}
function scheduleMiroslavIdle(delay=60000){
  clearTimeout(miroslavIdleTimer);
  miroslavIdleTimer=setTimeout(()=>{
    showMiroslavSpeech(nextMiroslavIdleLine(),12000,{idle:true});
  },delay);
}
function showMiroslavSpeech(message,duration=15000,opts={}){
  const bubble=$('#miroslav-speech'),label=$('#miroslav-speech-text');
  if(!bubble||!label)return;
  clearTimeout(miroslavSpeechTimer);
  clearTimeout(miroslavIdleTimer);
  label.textContent=message;
  bubble.classList.remove('show');
  requestAnimationFrame(()=>requestAnimationFrame(()=>bubble.classList.add('show')));
  miroslavSpeechTimer=setTimeout(()=>{
    bubble.classList.remove('show');
    scheduleMiroslavIdle(60000);
  },duration);
}
function miroslavModeSpeech(mode){
  if(mode==='study'||mode==='work') return 'Пора поработать ;)';
  if(mode==='rest') return 'Как насчёт поиграть?)';
  if(mode==='stream') return 'Стримить значит)';
  return '';
}
setTimeout(()=>showMiroslavSpeech('Привет! Как дела?)',15000),700);

// Desktop modes
let desktopMode=localStorage.getItem(LS.mode)||'default';
const modeConfig={
  default:{label:'Обычный',icon:'◌',summary:'ORBIT ничего не скрывает — каталог, игры, задачи и рабочие инструменты доступны одновременно.',changes:['Все категории','Игры видны','Работа видна'],cats:null,cards:[['ТВОЁ ПРОСТРАНСТВО','Всё под рукой','Каталог, избранное, коллекции, игры и рабочие инструменты — без фильтра по сценарию.','catalog'],['БЫСТРЫЙ СТАРТ','Продолжить работу','Открой задачи или презентацию одним нажатием.','tasks'],['ФОКУС','25 минут','Pomodoro уже встроен в верхний виджет.','focus']]},
  study:{label:'Учёба',icon:'◇',summary:'На первый план выходят учебные сайты, поиск, заметки и фокус. Развлекательные блоки уходят из главного сценария.',changes:['Учёба и поиск','Фокус 25 мин','Заметки рядом'],cats:['Учёба','ИИ-ассистенты','Работа','Поиск и сервисы'],cards:[['УЧЁБА','Сначала главное','Учебные сервисы и ИИ-помощники выходят на первый план.','catalog'],['POMODORO','25 минут фокуса','Запусти таймер и закрой одну учебную задачу.','focus'],['ЗАМЕТКИ','Зафиксировать мысль','Markdown-заметки и задачи остаются внутри ORBIT.','notes']]},
  work:{label:'Работа',icon:'▤',summary:'ORBIT превращается в рабочий стол: каталог показывает работу, код, дизайн и ИИ, игры убираются с главной, а задачи и презентации становятся быстрыми действиями.',changes:['Игры скрыты с главной','Работа · Код · Дизайн','Задачи + ORBIT Work'],cats:['Работа','Разработка','Дизайн','ИИ-ассистенты','Поиск и сервисы'],cards:[['РАБОЧИЙ СТОЛ','Только нужное','ORBIT убирает развлекательный шум и оставляет работу, разработку, дизайн, ИИ и поиск.','catalog'],['ПЛАН НА СЕГОДНЯ','Задачи рядом','Открой список задач, отметь приоритеты и не теряй контекст.','tasks'],['ORBIT WORK','Презентации и проекты','Редактор слайдов открывается внутри ORBIT — без новой вкладки.','work']]},
  rest:{label:'Отдых',icon:'◈',summary:'Рабочий шум отходит на второй план. На главной остаются игры, музыка, видео и общение.',changes:['Мини игры на ORBIT','Антистресс-зона','Музыка и видео'],cats:['Игры','Видео и музыка','Общение'],cards:[['ОТДЫХ','Переключиться','Игры, музыка, видео и общение — всё в одном сценарии.','catalog'],['ORBIT PLAY','32 мини-игры','Игротека, антистресс-зона и большой Sandbox с локальными рекордами.','games'],['ЧАСТО ОТКРЫВАЕШЬ','Твои привычки','ORBIT поднимает наверх то, чем ты реально пользуешься.','frequent']]},
  stream:{label:'Стрим',icon:'◉',summary:'Быстрый сценарий для эфира: видео, чат, дизайн и таймеры собираются ближе друг к другу.',changes:['Twitch / YouTube','Discord / Telegram','Таймер и дизайн'],cats:['Видео и музыка','Общение','Дизайн'],cards:[['СТРИМ','Эфирный набор','Twitch, YouTube, Discord и визуальные инструменты ближе всего.','catalog'],['БЫСТРАЯ СВЯЗЬ','Чат рядом','Открой Discord, Telegram или WhatsApp из каталога.','catalog'],['ИНСТРУМЕНТЫ','Время под контролем','Таймер встречи и другие мини-инструменты находятся в ORBIT Tools.','tools']]}
};
function renderModeDashboard(){
  const cfg=modeConfig[desktopMode]||modeConfig.default;
  document.body.dataset.mode=desktopMode;
  $$('.mode-pill').forEach(b=>b.classList.toggle('active',b.dataset.mode===desktopMode));
  const help=$('#mode-inline-help');
  if(help) help.innerHTML=`<div class="mode-inline-icon">${cfg.icon}</div><div class="mode-inline-copy"><strong>Режим «${cfg.label}»</strong><span>${cfg.summary}</span><div class="mode-change-list">${cfg.changes.map(x=>`<span class="mode-change-chip">${x}</span>`).join('')}</div></div><div class="mode-inline-state">АКТИВЕН</div>`;
  const actions={catalog:()=>document.querySelector('#catalog-section')?.scrollIntoView({behavior:'smooth'}),tasks:()=>route('tasks'),focus:()=>{if(!focusRunning)toggleFocusTimer();toast('Фокус-таймер запущен')},notes:()=>route('tools'),work:()=>route('work'),games:()=>route('games'),frequent:()=>document.querySelector('.frequent-block')?.scrollIntoView({behavior:'smooth'}),tools:()=>route('tools')};
  $('#mode-dashboard-grid').innerHTML=cfg.cards.map((c,i)=>`<article class="mode-card glass"><p class="eyebrow">${c[0]}</p><h3>${c[1]}</h3><p>${c[2]}</p><button data-mode-action="${c[3]}">${i===0?'Открыть':'Перейти'} →</button>${i===0?'<div class="mode-live"><i></i><span>Активен режим '+cfg.label+'</span></div>':''}</article>`).join('');
  $$('[data-mode-action]').forEach(b=>b.onclick=()=>actions[b.dataset.modeAction]?.());
}
function setDesktopMode(mode){
  desktopMode=modeConfig[mode]?mode:'default';
  localStorage.setItem(LS.mode,desktopMode);
  currentCategory='Все сайты';currentCollection=null;
  renderModeDashboard();renderCategories();renderSites();
  toast(`Режим: ${modeConfig[desktopMode].label}`);
  const phrase=miroslavModeSpeech(desktopMode);
  if(phrase)showMiroslavSpeech(phrase,15000);
}
$$('.mode-pill').forEach(b=>b.onclick=()=>setDesktopMode(b.dataset.mode));renderModeDashboard();

// ORBIT Tasks
let tasks=(()=>{try{return JSON.parse(localStorage.getItem(LS.tasks)||'[]')}catch{return[]}})();
let taskFilter='Все';
const taskCats=['Все','Сегодня','Учёба','Работа','Личное','Проект'];
function saveTasks(){localStorage.setItem(LS.tasks,JSON.stringify(tasks));renderTasks();}
function taskCounts(){const done=tasks.filter(t=>t.done).length,open=tasks.length-done,pct=tasks.length?Math.round(done/tasks.length*100):0;$('#tasks-count-pill').textContent=open;$('#tasks-open-stat').textContent=open;$('#tasks-done-stat').textContent=done;$('#tasks-progress-stat').textContent=pct+'%';}
function filteredTasks(){const today=new Date().toISOString().slice(0,10);return tasks.filter(t=>taskFilter==='Все'||(taskFilter==='Сегодня'?t.date===today:t.category===taskFilter));}
function renderTaskCats(){const today=new Date().toISOString().slice(0,10);$('#task-categories').innerHTML=taskCats.map(c=>{const n=c==='Все'?tasks.length:c==='Сегодня'?tasks.filter(t=>t.date===today).length:tasks.filter(t=>t.category===c).length;return `<button class="task-cat ${taskFilter===c?'active':''}" data-task-cat="${c}"><span>${c}</span><small>${n}</small></button>`}).join('');$$('[data-task-cat]').forEach(b=>b.onclick=()=>{taskFilter=b.dataset.taskCat;renderTasks()})}
function renderTasks(){taskCounts();renderTaskCats();const arr=filteredTasks();$('#task-list').innerHTML=arr.length?arr.map(t=>`<article class="task-item ${t.done?'done':''}" data-task="${t.id}"><div class="task-row"><input class="task-check" type="checkbox" ${t.done?'checked':''} data-task-toggle="${t.id}"><div><div class="task-title">${escapeHtml(t.title)}</div><div class="task-meta"><span class="task-tag">${escapeHtml(t.category)}</span>${t.date?`<span class="task-tag">${escapeHtml(t.date)}</span>`:''}<span class="task-tag">${(t.subtasks||[]).filter(s=>s.done).length}/${(t.subtasks||[]).length} подзадач</span></div></div><div class="task-actions"><button data-sub-add="${t.id}">＋ подзадача</button><button data-task-del="${t.id}">×</button></div></div>${(t.subtasks||[]).length?`<div class="subtasks">${t.subtasks.map(s=>`<label class="subtask ${s.done?'done':''}"><input type="checkbox" ${s.done?'checked':''} data-sub-toggle="${t.id}|${s.id}"><span>${escapeHtml(s.title)}</span></label>`).join('')}</div>`:''}</article>`).join(''):'<div class="task-empty"><strong>Здесь пока пусто</strong><div>Добавь задачу сверху или выбери другую категорию.</div></div>';
$$('[data-task-toggle]').forEach(x=>x.onchange=()=>{const t=tasks.find(v=>v.id===x.dataset.taskToggle);if(t){t.done=x.checked;(t.subtasks||[]).forEach(s=>s.done=x.checked);saveTasks()}});$$('[data-task-del]').forEach(b=>b.onclick=()=>{tasks=tasks.filter(t=>t.id!==b.dataset.taskDel);saveTasks();toast('Задача удалена')});$$('[data-sub-add]').forEach(b=>b.onclick=()=>{const title=prompt('Название подзадачи');if(!title?.trim())return;const t=tasks.find(v=>v.id===b.dataset.subAdd);if(t){t.subtasks=t.subtasks||[];t.subtasks.push({id:`sub-${Date.now()}`,title:title.trim(),done:false});saveTasks()}});$$('[data-sub-toggle]').forEach(x=>x.onchange=()=>{const [tid,sid]=x.dataset.subToggle.split('|');const t=tasks.find(v=>v.id===tid),s=t?.subtasks?.find(v=>v.id===sid);if(s){s.done=x.checked;if(t.subtasks.length&&t.subtasks.every(v=>v.done))t.done=true;else if(!x.checked)t.done=false;saveTasks()}});}
$('#task-create-form').onsubmit=e=>{e.preventDefault();const fd=new FormData(e.currentTarget),title=String(fd.get('title')||'').trim();if(!title)return;tasks.unshift({id:`task-${Date.now()}`,title,category:fd.get('category'),date:fd.get('date')||'',done:false,subtasks:[]});e.currentTarget.reset();saveTasks();toast('Задача добавлена')};renderTasks();

// Collections dialog
const collectionDialog=$('#collection-dialog');function openCollectionDialog(){backdrop.classList.remove('hidden');collectionDialog.classList.remove('hidden');setTimeout(()=>$('#collection-form input').focus(),0)}function closeCollectionDialog(){collectionDialog.classList.add('hidden');if(command.classList.contains('hidden')&&dialog.classList.contains('hidden')&&$('#sync-dialog').classList.contains('hidden')&&$('#game-modal').classList.contains('hidden'))backdrop.classList.add('hidden')}$('#add-collection-btn').onclick=openCollectionDialog;$$('[data-close-collection]').forEach(b=>b.onclick=closeCollectionDialog);$('#collection-form').onsubmit=e=>{e.preventDefault();const name=new FormData(e.currentTarget).get('name').trim();if(!name)return;collections.push({id:`col-${Date.now()}`,name,sites:[]});saveCollections();e.currentTarget.reset();renderCollections();closeCollectionDialog();toast(`Коллекция «${name}» создана`)};


// Routing
function route(name){
  if(name==='games'&&focusMode){toast('В режиме работы игротека скрыта');return;}
  $$('.page').forEach(p=>p.classList.remove('active')); $(`#page-${name}`).classList.add('active');
  $$('.nav-btn').forEach(b=>b.classList.toggle('active',b.dataset.route===name));
  window.scrollTo({top:0,behavior:'smooth'});
  if(name==='games') renderGames(); if(name==='tasks') renderTasks(); if(name==='work') renderDeck(); if(name==='tools') renderMarkdown(); if(name==='books'&&window.renderOrbitBooks) window.renderOrbitBooks(); if(name==='ai') renderAI();
  if(name==='home')setTimeout(()=>showMiroslavSpeech('Привет! Как дела?)',15000),350);
}
$$('[data-route]').forEach(b=>b.addEventListener('click',()=>route(b.dataset.route)));

// Search / command palette
const backdrop=$('#modal-backdrop'), command=$('#command-palette'), cmdInput=$('#command-input');
function commandItems(q=''){
  q=q.trim().toLowerCase();
  const siteItems=allSites().filter(s=>!q||`${s.name} ${s.domain} ${s.category}`.toLowerCase().includes(q)).slice(0,8).map(s=>({label:s.name,sub:s.description,type:'Сайт',action:()=>openSite(s)}));
  const gameItems=games.filter(g=>!q||`${g.name} ${g.desc}`.toLowerCase().includes(q)).slice(0,5).map(g=>({label:g.name,sub:g.desc,type:'Игра',action:()=>{closeCommand();route('games');openGame(g.id);}}));
  const routes=[{label:'Пространство',sub:'Главная ORBIT',type:'Раздел',action:()=>route('home')},{label:'Игротека',sub:'Мини игры на ORBIT',type:'Раздел',action:()=>route('games')},{label:'Задачи',sub:'Локальные списки и подзадачи',type:'Раздел',action:()=>route('tasks')},{label:'Работа',sub:'Редактор презентаций',type:'Раздел',action:()=>route('work')},{label:'Инструменты',sub:'29 инструментов: математика, текст, проекты, время, дизайн, файлы и Dev',type:'Раздел',action:()=>route('tools')},{label:'Книги',sub:'Онлайн-книги, краткие содержания и личная библиотека',type:'Раздел',action:()=>route('books')},{label:'Splash AI',sub:'Встроенный ИИ-клиент ORBIT',type:'Раздел',action:()=>route('ai')}].filter(x=>!q||`${x.label} ${x.sub}`.toLowerCase().includes(q));
  return [...routes,...siteItems,...gameItems].slice(0,14);
}
function renderCommand(){ const items=commandItems(cmdInput.value); $('#command-results').innerHTML=items.map((x,i)=>`<button class="command-item ${i===0?'active':''}" data-i="${i}"><div><strong>${escapeHtml(x.label)}</strong><span>${escapeHtml(x.sub)}</span></div><small>${x.type}</small></button>`).join('')||'<div class="empty-state"><span>Ничего не найдено</span></div>'; $$('.command-item').forEach(b=>b.onclick=()=>{items[+b.dataset.i].action();closeCommand();}); command._items=items; }
function openCommand(seed=''){ backdrop.classList.remove('hidden');command.classList.remove('hidden');cmdInput.value=seed;renderCommand();setTimeout(()=>cmdInput.focus(),0); }
function closeCommand(){ command.classList.add('hidden'); backdrop.classList.add('hidden'); }
$('#global-search-btn').onclick=()=>openCommand(); $('#hero-search').onfocus=()=>{ const v=$('#hero-search').value; $('#hero-search').blur(); openCommand(v); }; cmdInput.oninput=renderCommand;
document.addEventListener('keydown',e=>{ if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();openCommand();} if(e.key==='Escape'){closeCommand();closeDialog();closeCollectionDialog();closeSync();closeGame();} if(e.key==='Enter'&&!command.classList.contains('hidden')&&command._items?.[0]){command._items[0].action();closeCommand();} });
backdrop.onclick=()=>{ closeCommand();closeDialog();closeCollectionDialog();closeSync();closeColorDialog();closeGame(); };

// Add site
const dialog=$('#add-site-dialog');
function openDialog(){ backdrop.classList.remove('hidden');dialog.classList.remove('hidden'); }
function closeDialog(){ dialog.classList.add('hidden'); if(command.classList.contains('hidden') && $('#game-modal').classList.contains('hidden') && collectionDialog.classList.contains('hidden') && $('#sync-dialog').classList.contains('hidden')) backdrop.classList.add('hidden'); }
$('#add-site-btn').onclick=openDialog; $$('[data-close-dialog]').forEach(b=>b.onclick=closeDialog);
$('#add-site-form').onsubmit=e=>{ e.preventDefault(); const fd=new FormData(e.currentTarget), name=fd.get('name').trim(), url=safeUrl(fd.get('url').trim()); if(url==='#') return toast('Проверь адрес сайта'); const u=new URL(url); customSites.push({id:`custom-${Date.now()}`,name,description:fd.get('description').trim()||'Пользовательская ссылка',domain:u.hostname,category:fd.get('category'),url}); localStorage.setItem(LS.custom,JSON.stringify(customSites)); e.currentTarget.reset(); updateCounts();renderCategories();renderSites();closeDialog();toast('Сайт добавлен'); };
$('#reset-filters').onclick=()=>{currentCategory='Все сайты';siteQuery='';renderCategories();renderSites();};

// Sync / profile transfer (cloud backend intentionally not faked in this test branch)
const syncDialog=$('#sync-dialog');function openSync(){backdrop.classList.remove('hidden');syncDialog.classList.remove('hidden')}function closeSync(){syncDialog.classList.add('hidden');if(command.classList.contains('hidden')&&dialog.classList.contains('hidden')&&collectionDialog.classList.contains('hidden')&&$('#game-modal').classList.contains('hidden'))backdrop.classList.add('hidden')}$('#sync-btn').onclick=openSync;$$('[data-close-sync]').forEach(b=>b.onclick=closeSync);
const profileKeys=Object.values(LS);$('#export-profile-btn').onclick=()=>{const data={version:1,exportedAt:new Date().toISOString(),items:{}};profileKeys.forEach(k=>{const v=localStorage.getItem(k);if(v!==null)data.items[k]=v});const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='orbit-profile.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1200);toast('Профиль экспортирован')};$('#import-profile-btn').onclick=()=>$('#profile-file').click();$('#profile-file').onchange=async e=>{const f=e.target.files?.[0];if(!f)return;try{const data=JSON.parse(await f.text());if(!data?.items||typeof data.items!=='object')throw new Error();Object.entries(data.items).forEach(([k,v])=>{if(profileKeys.includes(k)&&typeof v==='string')localStorage.setItem(k,v)});toast('Профиль импортирован — обновляю ORBIT');setTimeout(()=>location.reload(),450)}catch{toast('Не удалось прочитать профиль')}};

// Games
let scoreStore=JSON.parse(localStorage.getItem(LS.scores)||'{}');

function runTargetRush(stage,setScore){
  let score=0,time=20,timer=null;
  stage.innerHTML='<div class="game-controls"><span class="score-chip">Время: <b id="tr-time">20</b></span><span class="score-chip">Очки: <b id="tr-score">0</b></span></div><div id="tr-field" style="position:relative;height:330px;border:1px solid var(--line);border-radius:18px;background:var(--surface-strong);overflow:hidden;margin-top:12px"></div>';
  const field=stage.querySelector('#tr-field'),scoreEl=stage.querySelector('#tr-score'),timeEl=stage.querySelector('#tr-time');
  const spawn=()=>{ if(time<=0)return; field.innerHTML=''; const b=document.createElement('button'); b.type='button'; b.textContent='●'; b.style.cssText=`position:absolute;width:58px;height:58px;border-radius:50%;border:0;background:var(--text);color:var(--bg);font-size:24px;left:${Math.random()*82}%;top:${Math.random()*76}%;`; b.onclick=()=>{score++;scoreEl.textContent=score;setScore(score);spawn()}; field.append(b); };
  spawn(); timer=setInterval(()=>{time--;timeEl.textContent=time;if(time<=0){clearInterval(timer);field.innerHTML='<div style="display:grid;place-items:center;height:100%;font-weight:800">Готово · '+score+' очков</div>';setGameScore('targetrush',score)}},1000);
  return()=>clearInterval(timer);
}
function runSequenceTap(stage,setScore){
  let next=1,start=Date.now(); const nums=Array.from({length:16},(_,i)=>i+1).sort(()=>Math.random()-.5);
  stage.innerHTML='<div class="game-controls"><span class="score-chip">Нажимай 1 → 16 по порядку</span><span class="score-chip">Следующее: <b id="seq-next">1</b></span></div><div id="seq-grid" style="display:grid;grid-template-columns:repeat(4,74px);gap:8px;justify-content:center;margin-top:18px"></div>';
  const grid=stage.querySelector('#seq-grid'),nextEl=stage.querySelector('#seq-next');
  nums.forEach(n=>{const b=document.createElement('button');b.type='button';b.textContent=n;b.style.cssText='height:64px;border:1px solid var(--line);border-radius:14px;background:var(--surface-strong);color:var(--text);font-weight:800;font-size:18px';b.onclick=()=>{if(n!==next){b.animate([{transform:'translateX(-4px)'},{transform:'translateX(4px)'},{transform:'none'}],{duration:160});return}b.disabled=true;b.style.opacity=.25;next++;nextEl.textContent=Math.min(next,16);if(next===17){const sec=((Date.now()-start)/1000).toFixed(2);grid.innerHTML='<div style="grid-column:1/-1;text-align:center;font-size:28px;font-weight:800">'+sec+' сек</div>';const score=Math.max(1,Math.round(1000/Number(sec)));setScore(score);setGameScore('sequencetap',score)}};grid.append(b)});
  return()=>{};
}
function runMathSprint(stage,setScore){
  let score=0,left=10,a=0,b=0,op='+';
  stage.innerHTML='<div class="game-controls"><span class="score-chip">Примеров осталось: <b id="math-left">10</b></span><span class="score-chip">Очки: <b id="math-score">0</b></span></div><div style="text-align:center;margin:24px"><div id="math-q" style="font-size:42px;font-weight:850"></div><input id="math-a" type="number" style="margin-top:16px;width:180px;padding:12px;border-radius:13px;border:1px solid var(--line);background:var(--surface-strong);color:var(--text);text-align:center;font-size:20px" placeholder="Ответ"></div>';
  const q=stage.querySelector('#math-q'),input=stage.querySelector('#math-a'),leftEl=stage.querySelector('#math-left'),scoreEl=stage.querySelector('#math-score');
  function next(){a=2+Math.floor(Math.random()*18);b=2+Math.floor(Math.random()*18);op=Math.random()<.55?'+':'−';q.textContent=`${a} ${op} ${b} = ?`;input.value='';input.focus()}
  input.onkeydown=e=>{if(e.key!=='Enter')return;const ans=op==='+'?a+b:a-b;if(Number(input.value)===ans){score++;scoreEl.textContent=score}left--;leftEl.textContent=left;setScore(score);if(left<=0){q.textContent=`Результат: ${score}/10`;input.disabled=true;setGameScore('mathsprint',score)}else next()};next();return()=>{};
}
function runWordScramble(stage,setScore){
  const words=['орбита','космос','планета','ракета','комета','спутник','галактика','звезда'];let score=0,index=0,current='';
  stage.innerHTML='<div class="game-controls"><span class="score-chip">Очки: <b id="ws-score">0</b></span></div><div style="text-align:center;margin:28px"><div id="ws-word" style="font-size:38px;font-weight:850;letter-spacing:.12em"></div><input id="ws-input" style="margin-top:18px;width:min(320px,90%);padding:12px;border:1px solid var(--line);border-radius:13px;background:var(--surface-strong);color:var(--text);text-align:center" placeholder="Какое это слово?"><div id="ws-hint" class="site-domain" style="margin-top:10px">Enter — проверить</div></div>';
  const w=stage.querySelector('#ws-word'),inp=stage.querySelector('#ws-input'),scoreEl=stage.querySelector('#ws-score'),hint=stage.querySelector('#ws-hint');
  const shuffle=s=>{let a=[...s];do{a.sort(()=>Math.random()-.5)}while(a.join('')===s);return a.join('')};
  function next(){current=words[index%words.length];w.textContent=shuffle(current).toUpperCase();inp.value='';inp.focus();hint.textContent='Enter — проверить'}
  inp.onkeydown=e=>{if(e.key!=='Enter')return;if(inp.value.trim().toLowerCase()===current){score++;scoreEl.textContent=score;hint.textContent='Верно!';index++;setScore(score);setGameScore('wordscramble',score);setTimeout(next,350)}else{hint.textContent='Попробуй ещё'}};next();return()=>{};
}
function runPrecisionTimer(stage,setScore){
  let start=0,running=false,raf=0;
  stage.innerHTML='<div style="text-align:center;padding:24px"><p>Останови таймер как можно ближе к <b>5.00 сек</b></p><div id="pt-time" style="font-size:64px;font-weight:850;letter-spacing:-.06em">0.00</div><button id="pt-btn" class="glass-btn" type="button" style="margin-top:16px">Старт</button><div id="pt-result" class="site-domain" style="margin-top:12px"></div></div>';
  const time=stage.querySelector('#pt-time'),btn=stage.querySelector('#pt-btn'),res=stage.querySelector('#pt-result');
  function loop(){if(!running)return;time.textContent=((performance.now()-start)/1000).toFixed(2);raf=requestAnimationFrame(loop)}
  btn.onclick=()=>{if(!running){running=true;start=performance.now();btn.textContent='Стоп';res.textContent='';loop()}else{running=false;cancelAnimationFrame(raf);const v=(performance.now()-start)/1000;time.textContent=v.toFixed(2);const diff=Math.abs(5-v);const score=Math.max(0,Math.round(1000-diff*400));res.textContent=`Отклонение: ${diff.toFixed(2)} сек · ${score} очков`;setScore(score);setGameScore('precisiontimer',score);btn.textContent='Ещё раз'}};return()=>cancelAnimationFrame(raf);
}
function runColorMatch(stage,setScore){
  const colors=[['КРАСНЫЙ','#ef4444'],['СИНИЙ','#3b82f6'],['ЗЕЛЁНЫЙ','#22c55e'],['ЖЁЛТЫЙ','#eab308']];let score=0,left=12,correct=0;
  stage.innerHTML='<div class="game-controls"><span class="score-chip">Раундов: <b id="cm-left">12</b></span><span class="score-chip">Очки: <b id="cm-score">0</b></span></div><div style="text-align:center;margin:28px"><div id="cm-word" style="font-size:40px;font-weight:900"></div><p>Выбери цвет текста, а не значение слова</p><div id="cm-buttons" style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap"></div></div>';
  const word=stage.querySelector('#cm-word'),buttons=stage.querySelector('#cm-buttons'),leftEl=stage.querySelector('#cm-left'),scoreEl=stage.querySelector('#cm-score');
  colors.forEach((c,i)=>{const b=document.createElement('button');b.type='button';b.textContent=c[0];b.className='glass-btn';b.onclick=()=>answer(i);buttons.append(b)});
  function next(){const textI=Math.floor(Math.random()*4);correct=Math.floor(Math.random()*4);word.textContent=colors[textI][0];word.style.color=colors[correct][1]}
  function answer(i){if(left<=0)return;if(i===correct)score++;left--;leftEl.textContent=left;scoreEl.textContent=score;setScore(score);if(left===0){word.textContent=`${score}/12`;buttons.style.display='none';setGameScore('colormatch',score)}else next()}next();return()=>{};
}
function runPatternFlash(stage,setScore){
  let level=3,score=0,busy=false,pattern=[];
  stage.innerHTML='<div class="game-controls"><span class="score-chip">Уровень: <b id="pf-level">3</b></span><span class="score-chip">Очки: <b id="pf-score">0</b></span><button id="pf-start" class="game-action">Показать</button></div><div id="pf-grid" style="display:grid;grid-template-columns:repeat(4,70px);gap:8px;justify-content:center;margin-top:18px"></div>';
  const grid=stage.querySelector('#pf-grid'),levelEl=stage.querySelector('#pf-level'),scoreEl=stage.querySelector('#pf-score'),startBtn=stage.querySelector('#pf-start');
  const cells=[];for(let i=0;i<16;i++){const b=document.createElement('button');b.type='button';b.style.cssText='width:70px;height:70px;border-radius:15px;border:1px solid var(--line);background:var(--surface-strong)';b.onclick=()=>pick(i);grid.append(b);cells.push(b)}
  let picked=[];
  function show(){if(busy)return;busy=true;picked=[];pattern=[...Array(16).keys()].sort(()=>Math.random()-.5).slice(0,level);pattern.forEach(i=>cells[i].style.background='var(--text)');setTimeout(()=>{cells.forEach(c=>c.style.background='var(--surface-strong)');busy=false},1100)}
  function pick(i){if(busy||!pattern.length)return;if(pattern.includes(i)&&!picked.includes(i)){picked.push(i);cells[i].style.opacity=.45;if(picked.length===pattern.length){score+=level;setScore(score);setGameScore('patternflash',score);level=Math.min(8,level+1);levelEl.textContent=level;scoreEl.textContent=score;cells.forEach(c=>c.style.opacity=1);pattern=[];setTimeout(show,500)}}else{cells[i].animate([{transform:'scale(.9)'},{transform:'scale(1)'}],{duration:180});score=Math.max(0,score-1);scoreEl.textContent=score}}
  startBtn.onclick=show;return()=>{};
}
function runDodgeBlocks(stage,setScore){
  const c=document.createElement('canvas');c.width=520;c.height=330;c.className='canvas-game';stage.append(c);const x=c.getContext('2d');let player=240,keys={},obs=[],score=0,alive=true,last=0,raf=0;
  const kd=e=>keys[e.key]=1,ku=e=>keys[e.key]=0;document.addEventListener('keydown',kd);document.addEventListener('keyup',ku);
  function frame(t){if(!alive)return;const dt=Math.min(.035,(t-last||16)/1000);last=t;if(keys.ArrowLeft||keys.a)player-=260*dt;if(keys.ArrowRight||keys.d)player+=260*dt;player=Math.max(0,Math.min(480,player));if(Math.random()<dt*2.5)obs.push({x:Math.random()*485,y:-30,w:25+Math.random()*30,s:130+Math.random()*120});obs.forEach(o=>o.y+=o.s*dt);obs=obs.filter(o=>o.y<360);for(const o of obs){if(o.x<player+40&&o.x+o.w>player&&o.y<310&&o.y+30>285){alive=false;setGameScore('dodgeblocks',score);break}}score=Math.floor(t/100);setScore(score);x.clearRect(0,0,520,330);x.fillStyle='#111';x.fillRect(0,0,520,330);x.fillStyle='#fff';x.fillRect(player,285,40,24);x.fillStyle='#777';obs.forEach(o=>x.fillRect(o.x,o.y,o.w,30));if(!alive){x.fillStyle='#fff';x.font='700 26px sans-serif';x.fillText('Игра окончена · '+score,120,165);return}raf=requestAnimationFrame(frame)}raf=requestAnimationFrame(frame);return()=>{alive=false;cancelAnimationFrame(raf);document.removeEventListener('keydown',kd);document.removeEventListener('keyup',ku)};
}
function runStarCatcher(stage,setScore){
  const c=document.createElement('canvas');c.width=520;c.height=330;c.className='canvas-game';stage.append(c);const x=c.getContext('2d');let player=220,keys={},stars=[],score=0,miss=0,alive=true,last=0,raf=0;
  const kd=e=>keys[e.key]=1,ku=e=>keys[e.key]=0;document.addEventListener('keydown',kd);document.addEventListener('keyup',ku);
  function frame(t){if(!alive)return;const dt=Math.min(.035,(t-last||16)/1000);last=t;if(keys.ArrowLeft||keys.a)player-=300*dt;if(keys.ArrowRight||keys.d)player+=300*dt;player=Math.max(0,Math.min(450,player));if(Math.random()<dt*2)stars.push({x:15+Math.random()*490,y:-10,s:110+Math.random()*80});stars.forEach(s=>s.y+=s.s*dt);stars=stars.filter(s=>{if(s.y>285&&s.y<320&&s.x>player&&s.x<player+70){score++;setScore(score);return false}if(s.y>340){miss++;return false}return true});if(miss>=5){alive=false;setGameScore('starcatcher',score)}x.clearRect(0,0,520,330);x.fillStyle='#101018';x.fillRect(0,0,520,330);x.fillStyle='#fff';stars.forEach(s=>{x.beginPath();x.arc(s.x,s.y,6,0,Math.PI*2);x.fill()});x.fillRect(player,300,70,10);x.font='16px sans-serif';x.fillText(`★ ${score}   промахи ${miss}/5`,16,24);if(!alive){x.font='700 28px sans-serif';x.fillText('Готово · '+score+' звёзд',130,165);return}raf=requestAnimationFrame(frame)}raf=requestAnimationFrame(frame);return()=>{alive=false;cancelAnimationFrame(raf);document.removeEventListener('keydown',kd);document.removeEventListener('keyup',ku)};
}
function runHigherLower(stage,setScore){
  let current=1+Math.floor(Math.random()*13),score=0;
  stage.innerHTML='<div style="text-align:center;padding:24px"><p>Следующая карта будет выше или ниже?</p><div id="hl-card" style="font-size:72px;font-weight:900">'+current+'</div><div class="game-controls"><button id="hl-low">Ниже</button><button id="hl-high">Выше</button></div><div id="hl-result" class="site-domain"></div></div>';
  const card=stage.querySelector('#hl-card'),res=stage.querySelector('#hl-result');
  function go(high){const next=1+Math.floor(Math.random()*13);const ok=high?next>=current:next<=current;if(ok){score++;res.textContent='Верно · серия '+score;setScore(score);setGameScore('higherlower',score)}else{score=0;res.textContent='Не угадал — серия сброшена'}current=next;card.textContent=current}
  stage.querySelector('#hl-low').onclick=()=>go(false);stage.querySelector('#hl-high').onclick=()=>go(true);return()=>{};
}

const games=[
  {id:'block',name:'Block Blast',icon:'▦',genre:'Головоломка',difficulty:'Средняя',controls:'Перетаскивание / касание',goal:'Размещай три фигуры на поле 8×8 и очищай заполненные строки и столбцы.',tip:'Следи сразу за тремя фигурами и оставляй место под крупные блоки.',desc:'Полноценная block-puzzle механика: три фигуры, комбо и очистка линий.',run:runBlock},
  {id:'2048',name:'2048',icon:'2048',genre:'Логика',difficulty:'Средняя',controls:'Стрелки / кнопки',goal:'Объединяй равные плитки и доберись до 2048.',tip:'Старайся держать самую большую плитку в одном углу.',desc:'Классическая числовая головоломка.',run:run2048},
  {id:'snake',name:'Змейка',icon:'〰',genre:'Аркада',difficulty:'Лёгкая',controls:'Стрелки',goal:'Собирай еду, расти и не сталкивайся со стенами или собой.',tip:'Не делай резких разворотов у края.',desc:'Быстрая классика с нарастающим напряжением.',run:runSnake},
  {id:'tetris',name:'Тетрис',icon:'▥',genre:'Аркада',difficulty:'Средняя',controls:'← → ↓ · ↑ поворот',goal:'Собирай полные горизонтальные линии падающими фигурами.',tip:'Не оставляй глубоких одиночных дыр.',desc:'Линии, фигуры и ритм без лишнего интерфейса.',run:runTetris},
  {id:'dino',name:'Динозаврик',icon:'⌁',genre:'Раннер',difficulty:'Лёгкая',controls:'Пробел / клик',goal:'Перепрыгивай препятствия и продержись как можно дольше.',tip:'Прыгай чуть раньше, чем кажется нужным.',desc:'Мини-раннер на реакцию.',run:runDino},
  {id:'mines',name:'Сапёр',icon:'✹',genre:'Логика',difficulty:'Средняя',controls:'Мышь / касание',goal:'Открой все безопасные клетки и не попади на мину.',tip:'Число показывает количество мин вокруг клетки.',desc:'Компактное поле 8×8 с десятью минами.',run:runMines},
  {id:'sudoku',name:'Судоку',icon:'#',genre:'Логика',difficulty:'Лёгкая',controls:'Клик по клетке',goal:'Заполни классическое поле 9×9 без повторов в строках, столбцах и блоках 3×3.',tip:'Используй подсветку связанных клеток, заметки и проверку ошибок.',desc:'Полноценное компактное Sudoku 9×9 с заметками, подсветкой и подсказками.',run:runSudoku},
  {id:'breakout',name:'Арканоид',icon:'▰',genre:'Аркада',difficulty:'Средняя',controls:'Двигай мышь',goal:'Отбивай шар платформой и разбей все блоки.',tip:'Меняй угол отбивания движением платформы.',desc:'Классический breakout с плавной анимацией.',run:runBreakout},
