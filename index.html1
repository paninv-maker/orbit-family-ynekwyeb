  {id:'maze',name:'Лабиринт',icon:'⌘',genre:'Логика',difficulty:'Средняя',controls:'Стрелки / WASD',goal:'Найди выход из случайно сгенерированного лабиринта.',tip:'Если потерялся — держись одной стены.',desc:'Каждый раунд создаёт новый лабиринт с таймером и следом пути.',run:runMaze},
  {id:'whack',name:'Whack-a-Mole',icon:'✦',genre:'Реакция',difficulty:'Быстрая',controls:'Клик / касание',goal:'Набери максимум попаданий за 30 секунд.',tip:'Не кликай по пустым лункам — серия сбросится.',desc:'Быстрая игра на реакцию с комбо и ускорением.',run:runWhack},

  {id:'targetrush',name:'Target Rush',icon:'◎',genre:'Реакция',difficulty:'Средняя',controls:'Клик / касание',goal:'Лови появляющуюся цель и набери максимум за 20 секунд.',tip:'Не води курсором слишком далеко от центра.',desc:'Динамичная игра на реакцию и точность.',run:runTargetRush},
  {id:'sequencetap',name:'Sequence Tap',icon:'123',genre:'Логика',difficulty:'Средняя',controls:'Клик по числам',goal:'Нажми числа от 1 до 16 в правильном порядке как можно быстрее.',tip:'Сначала найди глазами ближайшие 3–4 числа.',desc:'Скоростная головоломка на внимание.',run:runSequenceTap},
  {id:'mathsprint',name:'Math Sprint',icon:'±',genre:'Логика',difficulty:'Средняя',controls:'Клавиатура · Enter',goal:'Реши 10 коротких примеров без ошибок.',tip:'Не торопись настолько, чтобы терять точность.',desc:'Быстрый математический спринт.',run:runMathSprint},
  {id:'wordscramble',name:'Собери слово',icon:'АЯ',genre:'Логика',difficulty:'Средняя',controls:'Клавиатура · Enter',goal:'Разгадывай перемешанные слова на космическую тему.',tip:'Сначала ищи необычные буквы и окончания.',desc:'Небольшая словесная головоломка.',run:runWordScramble},
  {id:'precisiontimer',name:'Точный таймер',icon:'5.00',genre:'Навык',difficulty:'Средняя',controls:'Один клик',goal:'Останови секундомер максимально близко к 5.00 секундам.',tip:'Считай ритм про себя.',desc:'Простая механика, в которую легко залипнуть ради идеального результата.',run:runPrecisionTimer},
